-// The render size the game draws now (its DLSS subrect), set by the evaluate that re-creates SGSR 3 for it and taken
-// by that SGSR 3's Init: OptiScaler re-creates a feature from its creation parameters, which keep the old size.
+// The render size the game draws now (its DLSS subrect), set by the evaluate that re-creates SGSR 2 / SGSR 3 (a live
+// model change or a subrect that held 30 frames) and taken by that feature's Init: OptiScaler re-creates a feature from
+// its creation parameters, which keep the old size.
 inline unsigned int SubW = 0, SubH = 0;
 
+// Init of a fixed-size backend: the render size becomes the subrect the evaluate saw (once; cleared here). Smaller or
+// larger than the creation size, up to the display size (the game draws it into its own textures).
+inline void TakeSubrect(const char* who, unsigned int& renderW, unsigned int& renderH, unsigned int displayW,
+                        unsigned int displayH)
+{
+    const unsigned int sw = SubW, sh = SubH;
+    SubW = SubH = 0;
+    if (sw > 0 && sh > 0 && sw <= displayW && sh <= displayH && (sw != renderW || sh != renderH))
+    {
+        LOG_INFO("{0}: render size {1}x{2} from the subrect (feature made for {3}x{4})", who, sw, sh, renderW, renderH);
+        renderW = sw;
+        renderH = sh;
+    }
+}
+
 // While the FFX backend makes its context with FSR 4 INT8 forced on a GPU that is not AMD, the DXGI adapter reads as an
 // RDNA3 card (Dxgi_Spoofing.cpp): the FSR 4.1 SDK upscaler gives its INT8 model to AMD only and falls back to FSR 3.1
 inline bool AmdForFfx = false;
