diff --git a/OptiScaler/misc/IdentifyGpu.cpp b/OptiScaler/misc/IdentifyGpu.cpp
index 33de3b4..c29ab80 100644
--- a/OptiScaler/misc/IdentifyGpu.cpp
+++ b/OptiScaler/misc/IdentifyGpu.cpp
@@ -355,19 +355,43 @@ std::vector<GpuInformation> IdentifyGpu::getAllGpus()
     if (is_fetching)
         return {};
 
-    std::scoped_lock lock(mutex);
-
-    if (!cache.empty() && cache.front().deviceId != VendorId::Invalid)
     {
-        return cache;
+        std::unique_lock lock(mutex);
+
+        if (!cache.empty() && cache.front().vendorId != VendorId::Invalid)
+            return cache;
+
+        // checkGpuInfo calls into dxgi / vulkan, which can wait on locks held by the game's own device creation.
+        // Running it under our lock would make every other caller wait on that, so wait for it with a limit instead.
+        if (fetching)
+        {
+            if (!fetchDone.wait_for(lock, std::chrono::milliseconds(2000), [] { return !fetching; }))
+            {
+                LOG_WARN("GPU identification is still running, continuing without GPU info");
+                return {};
+            }
+
+            if (!cache.empty() && cache.front().vendorId != VendorId::Invalid)
+                return cache;
+        }
+
+        fetching = true;
     }
 
     is_fetching = true;
-    cache = checkGpuInfo();
+    auto gpus = checkGpuInfo();
     is_fetching = false;
 
+    {
+        std::scoped_lock lock(mutex);
+        cache = gpus;
+        fetching = false;
+    }
+
+    fetchDone.notify_all();
+
     // TODO: try to reactivate DxgiSpoofing if was auto on Nvidia cards without DLSS
-    return cache;
+    return gpus;
 }
 
