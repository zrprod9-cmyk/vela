+GpuInformation IdentifyGpu::tryGetPrimaryGpu()
+{
+    std::unique_lock lock(mutex, std::try_to_lock);
+
+    if (!lock.owns_lock() || cache.empty())
+        return GpuInformation {};
+
+    return cache.front();
+}
