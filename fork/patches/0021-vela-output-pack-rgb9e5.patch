+// Packs the upscaler's float16 output into DXGI_FORMAT_R9G9B9E5_SHAREDEXP bits.
+// The result is written to an R32_UINT texture and then copied into the game's output,
+// because R9G9B9E5_SHAREDEXP cannot be bound as a UAV.
+// Encoding follows EXT_texture_shared_exponent (N = 9, B = 15, Emax = 31), which D3D and Vulkan share:
+// NaN and negative values become 0, values above 65408 are clamped, mantissas round to nearest.
+
+Texture2D<float4>   SourceTexture      : register(t0);
+RWTexture2D<uint>   DestinationTexture : register(u0);
+
+// floor(x + 0.5) without the rounding error of the float add
+uint RoundHalfUp(float x)
+{
+    float f = floor(x);
+    return (uint) f + ((x - f) >= 0.5f ? 1u : 0u);
+}
+
+uint PackRGB9E5(float3 rgb)
+{
+    const float sharedExpMax = 65408.0f; // (2^9 - 1) / 2^9 * 2^(31 - 15)
+
+    uint3 bits = asuint(rgb);
+    bool3 isNan = (bits & 0x7FFFFFFFu) > 0x7F800000u;
+    float3 c = min(max(rgb, 0.0f), sharedExpMax);
+    c = isNan ? 0.0f : c;
+
+    float maxC = max(c.r, max(c.g, c.b));
+
+    // floor(log2(maxC)) taken from the exponent bits; zero and denormals fall below the -B - 1 limit
+    int floorLog2 = (int) ((asuint(maxC) >> 23) & 0xFFu) - 127;
+    int expShared = max(-16, floorLog2) + 1 + 15;
+
+    float scale = asfloat((uint) (127 + 24 - expShared) << 23); // 2^-(expShared - B - N)
+    if (RoundHalfUp(maxC * scale) == 512u)
+    {
+        expShared += 1;
+        scale *= 0.5f;
+    }
+
+    uint r = RoundHalfUp(c.r * scale);
+    uint g = RoundHalfUp(c.g * scale);
+    uint b = RoundHalfUp(c.b * scale);
+
+    return r | (g << 9) | (b << 18) | ((uint) expShared << 27);
+}
+
+[numthreads(16, 16, 1)]
+void CSMain(uint3 dispatchThreadID : SV_DispatchThreadID)
+{
+    uint width, height;
+    DestinationTexture.GetDimensions(width, height);
+
+    if (dispatchThreadID.x >= width || dispatchThreadID.y >= height)
+        return;
+
+    float3 c = SourceTexture.Load(int3(dispatchThreadID.xy, 0)).rgb;
+    DestinationTexture[dispatchThreadID.xy] = PackRGB9E5(c);
+}
