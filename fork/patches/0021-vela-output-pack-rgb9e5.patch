diff --git a/OptiScaler/shaders/output_pack/OP_Common.h b/OptiScaler/shaders/output_pack/OP_Common.h
new file mode 100644
index 0000000..8806e89
--- /dev/null
+++ b/OptiScaler/shaders/output_pack/OP_Common.h
@@ -0,0 +1,63 @@
+#pragma once
+
+#include "SysUtils.h"
+
+inline static std::string OP_ShaderCode = R"(
+// Packs the upscaler's float16 output into DXGI_FORMAT_R9G9B9E5_SHAREDEXP bits.
+// The result is written to an R32_UINT texture and then copied into the game's output,
+// because R9G9B9E5_SHAREDEXP cannot be bound as a UAV.
+// Encoding follows EXT_texture_shared_exponent (N = 9, B = 15, Emax = 31), which D3D and Vulkan share:
+// NaN and negative values become 0, values above 65408 are clamped, mantissas round to nearest.
+
+Texture2D<float4>   SourceTexture      : register(t0);
+RWTexture2D<uint>   DestinationTexture : register(u0);
+
+// floor(x + 0.5) without the rounding error of the float add
+uint RoundHalfUp(float x)
+{
+    float f = floor(x);
+    return (uint) f + ((x - f) >= 0.5f ? 1u : 0u);
+}
+
+uint PackRGB9E5(float3 rgb)
+{
+    const float sharedExpMax = 65408.0f; // (2^9 - 1) / 2^9 * 2^(31 - 15)
+
+    uint3 bits = asuint(rgb);
+    bool3 isNan = (bits & 0x7FFFFFFFu) > 0x7F800000u;
+    float3 c = min(max(rgb, 0.0f), sharedExpMax);
+    c = isNan ? 0.0f : c;
+
+    float maxC = max(c.r, max(c.g, c.b));
+
+    // floor(log2(maxC)) taken from the exponent bits; zero and denormals fall below the -B - 1 limit
+    int floorLog2 = (int) ((asuint(maxC) >> 23) & 0xFFu) - 127;
+    int expShared = max(-16, floorLog2) + 1 + 15;
+
+    float scale = asfloat((uint) (127 + 24 - expShared) << 23); // 2^-(expShared - B - N)
+    if (RoundHalfUp(maxC * scale) == 512u)
+    {
+        expShared += 1;
+        scale *= 0.5f;
+    }
+
+    uint r = RoundHalfUp(c.r * scale);
+    uint g = RoundHalfUp(c.g * scale);
+    uint b = RoundHalfUp(c.b * scale);
+
+    return r | (g << 9) | (b << 18) | ((uint) expShared << 27);
+}
+
+[numthreads(16, 16, 1)]
+void CSMain(uint3 dispatchThreadID : SV_DispatchThreadID)
+{
+    uint width, height;
+    DestinationTexture.GetDimensions(width, height);
+
+    if (dispatchThreadID.x >= width || dispatchThreadID.y >= height)
+        return;
+
+    float3 c = SourceTexture.Load(int3(dispatchThreadID.xy, 0)).rgb;
+    DestinationTexture[dispatchThreadID.xy] = PackRGB9E5(c);
+}
+)";
diff --git a/OptiScaler/shaders/output_pack/OP_Dx12.cpp b/OptiScaler/shaders/output_pack/OP_Dx12.cpp
new file mode 100644
index 0000000..fc28bc5
--- /dev/null
+++ b/OptiScaler/shaders/output_pack/OP_Dx12.cpp
@@ -0,0 +1,218 @@
+#include "pch.h"
+#include "OP_Dx12.h"
+#include "OP_Common.h"
+
+#include "precompile/OP_Shader.h"
+
+#include <Config.h>
+
+#include <magic_enum.hpp>
+
+// Formats this pass can produce, with the integer format the shader writes.
+// D3D12 copies between R9G9B9E5_SHAREDEXP and R32_UINT/R32_SINT ("Format Conversion using Direct3D 10.1").
+static DXGI_FORMAT PackedFormat(DXGI_FORMAT fmt)
+{
+    switch (fmt)
+    {
+    case DXGI_FORMAT_R9G9B9E5_SHAREDEXP:
+        return DXGI_FORMAT_R32_UINT;
+
+    default:
+        return DXGI_FORMAT_UNKNOWN;
+    }
+}
+
+bool OP_Dx12::NeedsConversion(DXGI_FORMAT InFormat)
+{
+    // D3D12 gives R9G9B9E5_SHAREDEXP no typed UAV and the FSR 4 provider accepts only float16 or R11G11B10
+    // outputs, so it is packed even when a driver exposes storage writes for it.
+    return PackedFormat(InFormat) != DXGI_FORMAT_UNKNOWN;
+}
+
+bool OP_Dx12::CreateBufferResource(ID3D12Device* InDevice, ID3D12Resource* InOutput)
+{
+    if (InDevice == nullptr || InOutput == nullptr)
+        return false;
+
+    auto outDesc = InOutput->GetDesc();
+    auto packedFormat = PackedFormat(outDesc.Format);
+
+    if (packedFormat == DXGI_FORMAT_UNKNOWN)
+        return false;
+
+    if (_buffer != nullptr && _packed != nullptr)
+    {
+        auto bufDesc = _buffer->GetDesc();
+        auto packedDesc = _packed->GetDesc();
+
+        if (bufDesc.Width == outDesc.Width && bufDesc.Height == outDesc.Height && packedDesc.Format == packedFormat)
+            return true;
+
+        LOG_DEBUG("[{0}] Output changed, recreating buffers", _name);
+        SAFE_RELEASE(_buffer);
+        SAFE_RELEASE(_packed);
+    }
+
+    LOG_INFO("[{0}] Output format {1} is not UAV writable, upscaling to R16G16B16A16_FLOAT and packing to {2}", _name,
+             magic_enum::enum_name(outDesc.Format), magic_enum::enum_name(packedFormat));
+
+    D3D12_HEAP_PROPERTIES heapProperties = CD3DX12_HEAP_PROPERTIES(D3D12_HEAP_TYPE_DEFAULT);
+
+    D3D12_RESOURCE_DESC texDesc = {};
+    texDesc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    texDesc.Width = outDesc.Width;
+    texDesc.Height = outDesc.Height;
+    texDesc.DepthOrArraySize = 1;
+    texDesc.MipLevels = 1;
+    texDesc.SampleDesc.Count = 1;
+    texDesc.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+
+    texDesc.Format = DXGI_FORMAT_R16G16B16A16_FLOAT;
+    texDesc.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET | D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+
+    auto hr = InDevice->CreateCommittedResource(&heapProperties, D3D12_HEAP_FLAG_NONE, &texDesc,
+                                                D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nullptr, IID_PPV_ARGS(&_buffer));
+
+    if (FAILED(hr))
+    {
+        LOG_ERROR("[{0}] CreateCommittedResource (buffer) error {1:x}", _name, (unsigned int) hr);
+        return false;
+    }
+
+    texDesc.Format = packedFormat;
+    texDesc.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+
+    hr = InDevice->CreateCommittedResource(&heapProperties, D3D12_HEAP_FLAG_NONE, &texDesc,
+                                           D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nullptr, IID_PPV_ARGS(&_packed));
+
+    if (FAILED(hr))
+    {
+        LOG_ERROR("[{0}] CreateCommittedResource (packed) error {1:x}", _name, (unsigned int) hr);
+        SAFE_RELEASE(_buffer);
+        return false;
+    }
+
+    _buffer->SetName(L"OP_Buffer");
+    _packed->SetName(L"OP_Packed");
+    _bufferState = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+    _packedState = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+
+    return true;
+}
+
+void OP_Dx12::SetBufferState(ID3D12GraphicsCommandList* InCommandList, D3D12_RESOURCE_STATES InState)
+{
+    return Shader_Dx12::SetBufferState(InCommandList, InState, _buffer, &_bufferState);
+}
+
+bool OP_Dx12::Dispatch(ID3D12GraphicsCommandList* InCmdList, ID3D12Resource* OutResource,
+                       D3D12_RESOURCE_STATES InOutState, uint32_t InWidth, uint32_t InHeight)
+{
+    if (!CanRender() || _device == nullptr || InCmdList == nullptr || OutResource == nullptr)
+        return false;
+
+    LOG_DEBUG("[{0}] Start!", _name);
+
+    auto outDesc = OutResource->GetDesc();
+    uint32_t width = (std::min)((uint32_t) outDesc.Width, InWidth);
+    uint32_t height = (std::min)(outDesc.Height, InHeight);
+
+    if (width == 0 || height == 0)
+        return false;
+
+    {
+        ScopedGpuTime_Dx12 scopedGpuTime(GpuTime.get(), InCmdList);
+
+        Shader_Dx12::SetBufferState(InCmdList, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, _buffer, &_bufferState);
+        Shader_Dx12::SetBufferState(InCmdList, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, _packed, &_packedState);
+
+        _counter++;
+        _counter = _counter % OP_NUM_OF_HEAPS;
+        FrameDescriptorHeap& currentHeap = _frameHeaps[_counter];
+
+        CreateShaderResourceView(_device, _buffer, currentHeap.GetSrvCPU(0));
+        CreateUnorderedAccessView(_device, _packed, currentHeap.GetUavCPU(0), 0);
+
+        ID3D12DescriptorHeap* heaps[] = { currentHeap.GetHeapCSU() };
+        InCmdList->SetDescriptorHeaps(_countof(heaps), heaps);
+
+        InCmdList->SetComputeRootSignature(_rootSignature);
+        InCmdList->SetPipelineState(_pipelineState);
+
+        InCmdList->SetComputeRootDescriptorTable(0, currentHeap.GetTableGPUStart());
+
+        InCmdList->Dispatch((width + InNumThreadsX - 1) / InNumThreadsX, (height + InNumThreadsY - 1) / InNumThreadsY,
+                            1);
+    }
+
+    // Same-size copy of the packed bits into the game's output
+    Shader_Dx12::SetBufferState(InCmdList, D3D12_RESOURCE_STATE_COPY_SOURCE, _packed, &_packedState);
+
+    if (InOutState != D3D12_RESOURCE_STATE_COPY_DEST)
+    {
+        auto barrier = CD3DX12_RESOURCE_BARRIER::Transition(OutResource, InOutState, D3D12_RESOURCE_STATE_COPY_DEST);
+        InCmdList->ResourceBarrier(1, &barrier);
+    }
+
+    D3D12_TEXTURE_COPY_LOCATION dst = {};
+    dst.pResource = OutResource;
+    dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    dst.SubresourceIndex = 0;
+
+    D3D12_TEXTURE_COPY_LOCATION src = {};
+    src.pResource = _packed;
+    src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    src.SubresourceIndex = 0;
+
+    D3D12_BOX box = { 0, 0, 0, width, height, 1 };
+    InCmdList->CopyTextureRegion(&dst, 0, 0, 0, &src, &box);
+
+    if (InOutState != D3D12_RESOURCE_STATE_COPY_DEST)
+    {
+        auto barrier = CD3DX12_RESOURCE_BARRIER::Transition(OutResource, D3D12_RESOURCE_STATE_COPY_DEST, InOutState);
+        InCmdList->ResourceBarrier(1, &barrier);
+    }
+
+    Shader_Dx12::SetBufferState(InCmdList, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, _packed, &_packedState);
+
+    return true;
+}
+
+OP_Dx12::OP_Dx12(std::string InName, ID3D12Device* InDevice) : Shader_Dx12(InName, InDevice)
+{
+    if (InDevice == nullptr)
+    {
+        LOG_ERROR("InDevice is nullptr!");
+        return;
+    }
+
+    LOG_DEBUG("{0} start!", _name);
+
+    if (!SetupRootSignature(InDevice, 1, 1, 0))
+    {
+        LOG_ERROR("Failed to setup root signature");
+        return;
+    }
+
+    if (!CreateComputePipeline(InDevice, &_pipelineState, OP_cso, sizeof(OP_cso), OP_ShaderCode.c_str()))
+    {
+        LOG_ERROR("[{0}] Failed to create compute pipeline", _name);
+        return;
+    }
+
+    _init = InitHeaps(InDevice, _frameHeaps, OP_NUM_OF_HEAPS);
+}
+
+OP_Dx12::~OP_Dx12()
+{
+    if (!_init || State::Instance().isShuttingDown)
+        return;
+
+    for (int i = 0; i < OP_NUM_OF_HEAPS; i++)
+    {
+        _frameHeaps[i].ReleaseHeaps();
+    }
+
+    SAFE_RELEASE(_buffer);
+    SAFE_RELEASE(_packed);
+}
diff --git a/OptiScaler/shaders/output_pack/OP_Dx12.h b/OptiScaler/shaders/output_pack/OP_Dx12.h
new file mode 100644
index 0000000..8ce309c
--- /dev/null
+++ b/OptiScaler/shaders/output_pack/OP_Dx12.h
@@ -0,0 +1,45 @@
+#pragma once
+
+#include "SysUtils.h"
+
+#include <d3d12.h>
+#include <d3dx/d3dx12.h>
+#include <shaders/Shader_Dx12Utils.h>
+#include <shaders/Shader_Dx12.h>
+
+#define OP_NUM_OF_HEAPS 2
+
+// Output Pack: lets upscalers serve games whose output format cannot be written by a compute shader.
+// The upscaler writes Buffer() (R16G16B16A16_FLOAT), Dispatch() encodes it into a 32-bit integer texture
+// and copies that into the game's output, which D3D12 allows between size-compatible formats.
+class OP_Dx12 : public Shader_Dx12
+{
+  private:
+    FrameDescriptorHeap _frameHeaps[OP_NUM_OF_HEAPS];
+
+    ID3D12Resource* _buffer = nullptr;
+    ID3D12Resource* _packed = nullptr;
+    D3D12_RESOURCE_STATES _bufferState = D3D12_RESOURCE_STATE_COMMON;
+    D3D12_RESOURCE_STATES _packedState = D3D12_RESOURCE_STATE_COMMON;
+
+    uint32_t InNumThreadsX = 16;
+    uint32_t InNumThreadsY = 16;
+
+  public:
+    // True when upscalers cannot write InFormat directly and this pass can convert to it
+    static bool NeedsConversion(DXGI_FORMAT InFormat);
+
+    bool CreateBufferResource(ID3D12Device* InDevice, ID3D12Resource* InOutput);
+    void SetBufferState(ID3D12GraphicsCommandList* InCommandList, D3D12_RESOURCE_STATES InState);
+
+    // Converts Buffer() into OutResource. OutResource is in InOutState before and after the call.
+    bool Dispatch(ID3D12GraphicsCommandList* InCmdList, ID3D12Resource* OutResource, D3D12_RESOURCE_STATES InOutState,
+                  uint32_t InWidth, uint32_t InHeight);
+
+    ID3D12Resource* Buffer() { return _buffer; }
+    bool CanRender() const { return _init && _buffer != nullptr && _packed != nullptr; }
+
+    OP_Dx12(std::string InName, ID3D12Device* InDevice);
+
+    ~OP_Dx12();
+};
