diff --git a/OptiScaler/upscalers/IFeature_Dx12.cpp b/OptiScaler/upscalers/IFeature_Dx12.cpp
index 8097d80..19d5954 100644
--- a/OptiScaler/upscalers/IFeature_Dx12.cpp
+++ b/OptiScaler/upscalers/IFeature_Dx12.cpp
@@ -97,6 +97,35 @@ bool IFeature_Dx12::Evaluate(ID3D12GraphicsCommandList* InCommandList, NVSDK_NGX
     InParameters->Get(NVSDK_NGX_Parameter_MotionVectors, &paramMotion);
     InParameters->Get(NVSDK_NGX_Parameter_Depth, &paramDepth);
 
+    // Some games pass an output that upscalers cannot write (e.g. R9G9B9E5_SHAREDEXP).
+    // Then the upscaler and the passes below write a float16 buffer, which is packed into the game's output at the end.
+    ID3D12Resource* gameOutput = paramOutput;
+    auto gameOutputState = (D3D12_RESOURCE_STATES) Config::Instance()->OutputResourceBarrier.value_or(
+        D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    bool packOutput = false;
+
+    if (paramOutput != nullptr && OP_Dx12::NeedsConversion(paramOutput->GetDesc().Format))
+    {
+        if (OutputPacker == nullptr)
+            OutputPacker = std::make_unique<OP_Dx12>("Output Pack", Device);
+
+        if (OutputPacker->IsInit() && OutputPacker->CreateBufferResource(Device, paramOutput))
+        {
+            // Upscalers expect their output in the configured output state
+            OutputPacker->SetBufferState(InCommandList, gameOutputState);
+            paramOutput = OutputPacker->Buffer();
+            packOutput = true;
+        }
+    }
+
+    auto finishOutput = [&](bool pack)
+    {
+        if (packOutput && pack)
+            OutputPacker->Dispatch(InCommandList, gameOutput, gameOutputState, DisplayWidth(), DisplayHeight());
+
+        InParameters->Set(NVSDK_NGX_Parameter_Output, gameOutput);
+    };
+
     // Order is important as that's the order of shader dispatch
     std::vector<ShaderPass> pipeline;
 
@@ -248,7 +277,12 @@ bool IFeature_Dx12::Evaluate(ID3D12GraphicsCommandList* InCommandList, NVSDK_NGX
     UpscalerTime->End(InCommandList);
 
     if (!evalResult)
+    {
+        if (packOutput)
+            finishOutput(false);
+
         return false;
+    }
 
     // Iterate FORWARDS to execute the shaders in the defined order
     for (auto& pass : pipeline)
@@ -257,6 +291,9 @@ bool IFeature_Dx12::Evaluate(ID3D12GraphicsCommandList* InCommandList, NVSDK_NGX
         {
             if (!pass.Dispatch(pass.inputBuffer, pass.outputBuffer))
             {
+                if (packOutput)
+                    finishOutput(true);
+
                 return true;
             }
         }
@@ -281,7 +318,7 @@ bool IFeature_Dx12::Evaluate(ID3D12GraphicsCommandList* InCommandList, NVSDK_NGX
         }
     }
 
-    InParameters->Set(NVSDK_NGX_Parameter_Output, paramOutput);
+    finishOutput(true);
 
     return evalResult;
 }
