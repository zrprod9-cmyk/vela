+using StRecipe = SGSR3StudentVk::Recipe;
+template <class D> static auto PassPpx(const D& d, int) -> decltype((int) d.ppx) { return d.ppx; }
+template <class D> static int PassPpx(const D&, long) { return 1; }
+template <class D> static auto PassPpy(const D& d, int) -> decltype((int) d.ppy) { return d.ppy; }
+template <class D> static int PassPpy(const D&, long) { return 1; }
+template <class D> static auto PassFragment(const D& d, int) -> decltype((bool) d.fragment) { return d.fragment; }
+template <class D> static bool PassFragment(const D&, long) { return false; }
+template <class D> static SGSR3StudentVk::RecPass ConvertPass(const D& d)
+{
+    SGSR3StudentVk::RecPass r;
+    r.file = d.file;
+    r.outLevel = d.outLevel;
+    r.inLevel = d.inLevel;
+    for (int i = 0; i < d.nIn; i++)
+        r.in.push_back({ d.in[i].name, d.in[i].linear });
+    for (int i = 0; i < d.nOut; i++)
+        r.out.push_back(d.out[i]);
+    r.spv = d.spv;
+    r.spvBytes = d.spvBytes;
+    r.wgx = d.wgx > 0 ? d.wgx : 8;
+    r.wgy = d.wgy > 0 ? d.wgy : 8;
+    r.ppx = std::max(1, (int) PassPpx(d, 0));
+    r.ppy = std::max(1, (int) PassPpy(d, 0));
+    r.fragment = PassFragment(d, 0);
+    return r;
+}
