+const SGSR3StudentVk::Img& SGSR3StudentVk::TensorImg(const std::string& n, int parity) const
+{
+    // NAME.prev: the image of this frame's parity (written last frame); NAME.next: the other one
+    auto ends = [&](const char* sfx)
+    {
+        const size_t l = strlen(sfx);
+        return n.size() > l && n.compare(n.size() - l, l, sfx) == 0;
+    };
+    if (ends(".prev"))
+        return _pp[parity].at(n.substr(0, n.size() - 5));
+    if (ends(".next"))
+        return _pp[1 - parity].at(n.substr(0, n.size() - 5));
+    return _tensors.at(n);
