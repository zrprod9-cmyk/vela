+void SGSR3StudentVk::ReleaseRecipe()
+{
+    if (_vk != VK_NULL_HANDLE)
+    {
+        auto pass = [&](Pass& p)
+        {
+            if (p.pipe)
+                vkDestroyPipeline(_vk, p.pipe, nullptr);
+            if (p.pl)
+                vkDestroyPipelineLayout(_vk, p.pl, nullptr);
+            if (p.dsl)
+                vkDestroyDescriptorSetLayout(_vk, p.dsl, nullptr);
+            p = Pass {};
+        };
+        for (auto& p : _passes)
+            pass(p);
+        _passes.clear();
+        pass(_resolve);
+        auto img = [&](Img& i)
+        {
+            if (i.view)
+                vkDestroyImageView(_vk, i.view, nullptr);
+            if (i.image)
+                vkDestroyImage(_vk, i.image, nullptr);
+            if (i.mem)
+                vkFreeMemory(_vk, i.mem, nullptr);
+            i = Img {};
+        };
+        for (auto& t : _tensorImgs)
+            img(t);
+        for (int k = 0; k < 2; k++)
+        {
+            img(_hRgb[k]);
+            img(_hState[k]);
+        }
+        img(_out);
+        if (_pool)
+            vkResetDescriptorPool(_vk, _pool, 0);
+    }
