+void SGSR2Dumper::Push(std::string path, std::vector<uint8_t> data)
+{
+    std::unique_lock<std::mutex> lk(_mutex);
+    // the game waits here only when the disk falls far behind
+    _cv.wait(lk, [&] { return _queued < QueueLimit || _stop; });
+    _queued += data.size();
+    _jobs.push_back({ std::move(path), std::move(data) });
+    _cv.notify_all();
+}
+
+void SGSR2Dumper::WriterLoop()
+{
+    for (;;)
+    {
+        Job job;
+        {
+            std::unique_lock<std::mutex> lk(_mutex);
+            _cv.wait(lk, [&] { return !_jobs.empty() || _stop; });
+            if (_jobs.empty())
+                return;  // stopped and drained
+            job = std::move(_jobs.front());
+            _jobs.pop_front();
+        }
+        if (FILE* f = fopen(job.path.c_str(), "wb"))
+        {
+            if (!job.data.empty())
+                fwrite(job.data.data(), 1, job.data.size(), f);
+            fclose(f);
+        }
+        else
+            LOG_WARN("SGSR3 dump: cannot write {0}", job.path);
+        {
+            std::lock_guard<std::mutex> lk(_mutex);
+            _queued -= job.data.size();
+        }
+        _cv.notify_all();
+    }
+}
+
+void SGSR2Dumper::StopWriter()
+{
+    if (!_writer.joinable())
+        return;
+    {
+        std::lock_guard<std::mutex> lk(_mutex);
+        _stop = true;
+    }
+    _cv.notify_all();
+    _writer.join();
+}
