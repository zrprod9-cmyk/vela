new file mode 100644
index 00000000..7a1557d2
--- /dev/null
+++ b/OptiScaler/upscalers/sgsr2/SGSR2Dumper.cpp
@@ -0,0 +1,243 @@
+#include "pch.h"
+#include "SGSR2Dumper.h"
+
+#include <algorithm>
+#include <cstdio>
+
+static const char* TriggerPath = "Z:\\tmp\\sgsr3_dump";
+static const char* DumpRoot = "Z:\\tmp\\sgsr3dump";
+
+void SGSR2Dumper::BeginFrame(ID3D12Device* device, long frame)
+{
+    _device = device;
+    _frame = frame;
+    FlushReady(false);
+
+    if (_remaining > 0 || ++_sinceCheck < 30)
+        return;
+    _sinceCheck = 0;
+
+    if (GetFileAttributesA(TriggerPath) == INVALID_FILE_ATTRIBUTES)
+        return;
+
+    int count = 32;
+    if (FILE* f = fopen(TriggerPath, "r"))
+    {
+        int n = 0;
+        if (fscanf(f, "%d", &n) == 1 && n > 0)
+            count = std::min(n, 64);
+        fclose(f);
+    }
+    DeleteFileA(TriggerPath);
+
+    CreateDirectoryA(DumpRoot, nullptr);
+    char dir[256];
+    snprintf(dir, sizeof(dir), "%s\\%llu", DumpRoot, (unsigned long long) GetTickCount64());
+    CreateDirectoryA(dir, nullptr);
+    _dir = dir;
+    _remaining = count;
+    LOG_INFO("SGSR3 dump: {0} frames from frame {1} into {2}", count, frame, _dir);
+}
+
+void SGSR2Dumper::Capture(ID3D12GraphicsCommandList* cmd, const char* name, ID3D12Resource* res,
+                          D3D12_RESOURCE_STATES state, uint32_t cropW, uint32_t cropH)
+{
+    if (!Active() || res == nullptr || _device == nullptr)
+        return;
+
+    Slot& s = _slots[_slot];
+    if (s.pending)
+        Flush(s); // only reachable if frames were skipped; the GPU has had Slots frames to finish
+
+    auto desc = res->GetDesc();
+    Item* item = nullptr;
+    for (auto& it : s.items)
+        if (it.name == name)
+            item = &it;
+    if (item == nullptr)
+    {
+        s.items.push_back({});
+        item = &s.items.back();
+        item->name = name;
+    }
+
+    UINT64 bytes = 0, rowSize = 0;
+    UINT rows = 0;
+    _device->GetCopyableFootprints(&desc, 0, 1, 0, &item->footprint, &rows, &rowSize, &bytes);
+
+    if (item->buffer == nullptr || item->capacity < bytes)
+    {
+        if (item->buffer != nullptr)
+            item->buffer->Release();
+        item->buffer = nullptr;
+
+        D3D12_HEAP_PROPERTIES hp {};
+        hp.Type = D3D12_HEAP_TYPE_READBACK;
+        D3D12_RESOURCE_DESC rb {};
+        rb.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+        rb.Width = bytes;
+        rb.Height = 1;
+        rb.DepthOrArraySize = 1;
+        rb.MipLevels = 1;
+        rb.SampleDesc.Count = 1;
+        rb.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+        if (FAILED(_device->CreateCommittedResource(&hp, D3D12_HEAP_FLAG_NONE, &rb, D3D12_RESOURCE_STATE_COPY_DEST,
+                                                    nullptr, IID_PPV_ARGS(&item->buffer))))
+        {
+            LOG_WARN("SGSR3 dump: readback allocation of {0} bytes for {1} failed", bytes, name);
+            item->capacity = 0;
+            return;
+        }
+        item->capacity = bytes;
+    }
+
+    item->resourceFormat = desc.Format;
+    item->cropW = std::min<uint32_t>(cropW, item->footprint.Footprint.Width);
+    item->cropH = std::min<uint32_t>(cropH, item->footprint.Footprint.Height);
+    item->used = true;
+
+    D3D12_RESOURCE_BARRIER b {};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = res;
+    b.Transition.StateBefore = state;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    cmd->ResourceBarrier(1, &b);
+
+    D3D12_TEXTURE_COPY_LOCATION src {};
+    src.pResource = res;
+    src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    src.SubresourceIndex = 0; // depth plane for depth-stencil formats
+    D3D12_TEXTURE_COPY_LOCATION dst {};
+    dst.pResource = item->buffer;
+    dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    dst.PlacedFootprint = item->footprint;
+    cmd->CopyTextureRegion(&dst, 0, 0, 0, &src, nullptr);
+
+    std::swap(b.Transition.StateBefore, b.Transition.StateAfter);
+    cmd->ResourceBarrier(1, &b);
+}
+
+void SGSR2Dumper::EndFrame(const Meta& meta)
+{
+    if (!Active())
+        return;
+
+    Slot& s = _slots[_slot];
+    s.meta = meta;
+    s.pending = true;
+    _slot = (_slot + 1) % Slots;
+
+    if (--_remaining == 0)
+        LOG_INFO("SGSR3 dump: last frame {0} recorded", meta.frame);
+}
+
+void SGSR2Dumper::FlushReady(bool all)
+{
+    for (auto& s : _slots)
+        if (s.pending && (all || _frame >= s.meta.frame + (long) FlushDelay))
+            Flush(s);
+}
+
+void SGSR2Dumper::Flush(Slot& s)
+{
+    s.pending = false;
+    char path[512];
+    const Meta& m = s.meta;
+
+    snprintf(path, sizeof(path), "%s\\f%06ld.json", _dir.c_str(), m.frame);
+    FILE* js = fopen(path, "w");
+    if (js != nullptr)
+    {
+        fprintf(js,
+                "{\n  \"frame\": %ld,\n  \"render\": [%u, %u],\n  \"display\": [%u, %u],\n"
+                "  \"jitter\": [%.9g, %.9g],\n  \"mv_scale\": [%.9g, %.9g],\n  \"sgsr2_motion_scale\": [%.9g, %.9g],\n"
+                "  \"pre_exposure\": %.9g,\n  \"depth_inverted\": %d,\n  \"jittered_mv\": %d,\n  \"low_res_mv\": %d,\n"
+                "  \"auto_exposure\": %d,\n  \"hdr\": %d,\n  \"reset\": %d,\n  \"has_depth\": %d,\n"
+                "  \"mv_base\": [%u, %u],\n  \"color_base\": [%u, %u],\n  \"images\": {",
+                m.frame, m.renderW, m.renderH, m.displayW, m.displayH, m.jitterX, m.jitterY, m.mvScaleX, m.mvScaleY,
+                m.motionVectorScale[0], m.motionVectorScale[1], m.preExposure, m.depthInverted, m.jitteredMV,
+                m.lowResMV, m.autoExposure, m.hdr, m.reset, m.hasDepth, m.mvBaseX, m.mvBaseY, m.colorBaseX,
+                m.colorBaseY);
+    }
+
+    bool first = true;
+    for (auto& it : s.items)
+    {
+        if (!it.used || it.buffer == nullptr)
+            continue;
+        it.used = false;
+
+        const auto& fp = it.footprint;
+
+        void* mapped = nullptr;
+        if (FAILED(it.buffer->Map(0, nullptr, &mapped)) || mapped == nullptr)
+            continue;
+
+        // Texel size of the copied plane (R32_TYPELESS for D32S8's depth plane); RowPitch is padded, so it
+        // cannot be derived from the footprint.
+        uint32_t texel = 4;
+        switch (fp.Footprint.Format)
+        {
+        case DXGI_FORMAT_R16G16B16A16_FLOAT:
+        case DXGI_FORMAT_R16G16B16A16_TYPELESS:
+        case DXGI_FORMAT_R32G32_FLOAT:
+        case DXGI_FORMAT_R32G32_TYPELESS:
+        case DXGI_FORMAT_R32G8X24_TYPELESS:
+            texel = 8;
+            break;
+        case DXGI_FORMAT_R32G32B32A32_FLOAT:
+        case DXGI_FORMAT_R32G32B32A32_TYPELESS:
+            texel = 16;
+            break;
+        case DXGI_FORMAT_R16_FLOAT:
+        case DXGI_FORMAT_R16_TYPELESS:
+        case DXGI_FORMAT_R16_UNORM:
+            texel = 2;
+            break;
+        case DXGI_FORMAT_R8_UNORM:
+        case DXGI_FORMAT_R8_TYPELESS:
+            texel = 1;
+            break;
+        default:
+            texel = 4;
+            break;
+        }
+
+        snprintf(path, sizeof(path), "%s\\f%06ld_%s.bin", _dir.c_str(), m.frame, it.name.c_str());
+        if (FILE* f = fopen(path, "wb"))
+        {
+            const uint8_t* base = (const uint8_t*) mapped + fp.Offset;
+            for (uint32_t y = 0; y < it.cropH; y++)
+                fwrite(base + (uint64_t) y * fp.Footprint.RowPitch, 1, (size_t) it.cropW * texel, f);
+            fclose(f);
+        }
+
+        D3D12_RANGE noWrite { 0, 0 };
+        it.buffer->Unmap(0, &noWrite);
+
+        if (js != nullptr)
+            fprintf(js, "%s\n    \"%s\": {\"size\": [%u, %u], \"dxgi\": %d, \"plane_dxgi\": %d, \"texel_bytes\": %u}",
+                    first ? "" : ",", it.name.c_str(), it.cropW, it.cropH, (int) it.resourceFormat,
+                    (int) fp.Footprint.Format, texel);
+        first = false;
+    }
+
+    if (js != nullptr)
+    {
+        fprintf(js, "\n  }\n}\n");
+        fclose(js);
+    }
+}
+
+void SGSR2Dumper::Release()
+{
+    FlushReady(true);
+    for (auto& s : _slots)
+        for (auto& it : s.items)
+            if (it.buffer != nullptr)
+            {
+                it.buffer->Release();
+                it.buffer = nullptr;
+            }
+}
diff --git a/OptiScaler/upscalers/sgsr2/SGSR2Dumper.h b/OptiScaler/upscalers/sgsr2/SGSR2Dumper.h
new file mode 100644
index 00000000..9cb32149
--- /dev/null
+++ b/OptiScaler/upscalers/sgsr2/SGSR2Dumper.h
@@ -0,0 +1,83 @@
+#pragma once
+
+#include <d3d12.h>
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+//============================================================================================================
+// Input dumper for the SGSR 3 test bench.
+//
+// `echo N > /tmp/sgsr3_dump` (N <= 64, default 32) dumps the next N consecutive frames: the game's colour,
+// depth and motion vectors exactly as handed to the upscaler, SGSR2's history output, and the per-frame
+// constants. The files land in /tmp/sgsr3dump/<tick>/ (Wine sees it as Z:\tmp\...):
+//
+//   fNNNNNN_<name>.bin   tightly packed rows of the cropped region, little-endian, raw DXGI texels
+//   fNNNNNN.json         sizes, DXGI formats, jitter, MV scale, flags, preExposure, reset
+//
+// Copies go into readback buffers on the game's command list; a buffer is read on the CPU only once its
+// frame is FlushDelay frames old, so nothing waits on the GPU. Writing does stall the game thread for the
+// duration of the dump, which is fine for a debug capture.
+//============================================================================================================
+
+class SGSR2Dumper
+{
+  public:
+    struct Meta
+    {
+        long frame = 0;
+        uint32_t renderW = 0, renderH = 0, displayW = 0, displayH = 0;
+        float jitterX = 0, jitterY = 0;
+        float mvScaleX = 1, mvScaleY = 1;           // NGX MV_Scale as given by the game
+        float motionVectorScale[2] = { 0, 0 };      // what SGSR2 was fed
+        float preExposure = 1;
+        bool depthInverted = false, jitteredMV = false, lowResMV = false, autoExposure = false, hdr = false;
+        bool reset = false, hasDepth = false;
+        unsigned int mvBaseX = 0, mvBaseY = 0, colorBaseX = 0, colorBaseY = 0;
+    };
+
+    // Polls the trigger file; call once per evaluated frame before Capture.
+    void BeginFrame(ID3D12Device* device, long frame);
+    bool Active() const { return _remaining > 0; }
+
+    // Records a copy of `res` (currently in `state`) into this frame's slot, cropped to cropW x cropH.
+    void Capture(ID3D12GraphicsCommandList* cmd, const char* name, ID3D12Resource* res, D3D12_RESOURCE_STATES state,
+                 uint32_t cropW, uint32_t cropH);
+
+    void EndFrame(const Meta& meta);
+    void Release();
+
+  private:
+    static constexpr uint32_t Slots = 8;
+    static constexpr uint32_t FlushDelay = 6; // > IFeature ring depth (4) + 2, as the velocity readback assumes
+
+    struct Item
+    {
+        std::string name;
+        ID3D12Resource* buffer = nullptr;
+        uint64_t capacity = 0;
+        D3D12_PLACED_SUBRESOURCE_FOOTPRINT footprint {};
+        DXGI_FORMAT resourceFormat = DXGI_FORMAT_UNKNOWN;
+        uint32_t cropW = 0, cropH = 0;
+        bool used = false;
+    };
+
+    struct Slot
+    {
+        std::vector<Item> items;
+        Meta meta;
+        bool pending = false;
+    };
+
+    ID3D12Device* _device = nullptr;
+    Slot _slots[Slots];
+    uint32_t _slot = 0;
+    long _frame = 0;
+    int _remaining = 0;
+    int _sinceCheck = 0;
+    std::string _dir;
+
+    void Flush(Slot& s);
+    void FlushReady(bool all);
+};
