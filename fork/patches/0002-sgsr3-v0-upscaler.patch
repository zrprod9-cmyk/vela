+    else if (debugMode == 3u) scene = ((float) alpha).xxx;
+    else if (debugMode == 4u) scene = float3((float) reactive, 0.0, 0.0);
+    else if (debugMode == 5u) scene = float3(0.0, (float) tc, 0.0);
+    SceneOut[tid.xy] = float4(scene, 1.0);
+}
