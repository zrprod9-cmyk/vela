+MF FastLanczos(MF base)
+{
+    MF y = base - (MF) 1.0;
+    MF y2 = y * y;
+    MF y_temp = (MF) 0.75 * y + y2;
+    return y_temp * y2;
+}
+
+MF max3(MF3 c) { return max(c.x, max(c.y, c.z)); }
+
+MF3 toWork(MF3 rgb)
+{
+    rgb = (MF3) (max((float3) rgb, 0.0) * (exposure / preExposure));
+    rgb = rgb / ((MF) 1.0 + max3(rgb));
+    MF Y = (MF) 0.25 * rgb.r + (MF) 0.5 * rgb.g + (MF) 0.25 * rgb.b;
+    MF Co = (MF) 0.5 * rgb.r - (MF) 0.5 * rgb.b;
+    MF Cg = (MF) -0.25 * rgb.r + (MF) 0.5 * rgb.g - (MF) 0.25 * rgb.b;
+    return MF3(Y, Co + (MF) 0.5, Cg + (MF) 0.5);
+}
+
+float3 fromWork(MF3 w)
+{
