diff --git a/OptiScaler/upscalers/sgsr3/SGSR3Feature.cpp b/OptiScaler/upscalers/sgsr3/SGSR3Feature.cpp
new file mode 100644
index 00000000..8c4dbac0
--- /dev/null
+++ b/OptiScaler/upscalers/sgsr3/SGSR3Feature.cpp
@@ -0,0 +1,100 @@
+#include "pch.h"
+#include "SGSR3Feature.h"
+
+#include <Config.h>
+#include <Util.h>
+#include <MathUtils.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <cstring>
+
+// Same conventions as the offline replay (sgsr_replay --only sgsr3), so a
+// capture of this feature's inputs replays to the same image there.
+bool SGSR3Feature::UpdateSharedConstants(NVSDK_NGX_Parameter* InParameters)
+{
+    const float rw = (float) RenderWidth();
+    const float rh = (float) RenderHeight();
+    const float dw = (float) TargetWidth();
+    const float dh = (float) TargetHeight();
+
+    _constants.renderSize[0] = rw;
+    _constants.renderSize[1] = rh;
+    _constants.displaySize[0] = dw;
+    _constants.displaySize[1] = dh;
+    _constants.renderSizeRcp[0] = 1.0f / rw;
+    _constants.renderSizeRcp[1] = 1.0f / rh;
+    _constants.displaySizeRcp[0] = 1.0f / dw;
+    _constants.displaySizeRcp[1] = 1.0f / dh;
+    _constants.renderSizeU[0] = RenderWidth();
+    _constants.renderSizeU[1] = RenderHeight();
+
+    // NGX / FFX convention, render pixels, "pixel p shows the scene at p - jitter": what SGSR expects as is.
+    float jitterX = 0.0f, jitterY = 0.0f;
+    InParameters->Get(NVSDK_NGX_Parameter_Jitter_Offset_X, &jitterX);
+    InParameters->Get(NVSDK_NGX_Parameter_Jitter_Offset_Y, &jitterY);
+    _constants.jitter[0] = jitterX;
+    _constants.jitter[1] = jitterY;
+
+    // prev UV = UV + mv * mvToUv. Measured on Bright Memory: Infinite (sign_autotest, three DLSS and one FSR 2
+    // recording): prev = cur + mv * MV_Scale, in render pixels for low-res vectors and in display pixels for
+    // full-resolution ones. FSR 2 hands UV-space vectors with MV_Scale = render size, which this also covers.
+    float mvScaleX = 1.0f, mvScaleY = 1.0f;
+    if (InParameters->Get(NVSDK_NGX_Parameter_MV_Scale_X, &mvScaleX) != NVSDK_NGX_Result_Success ||
+        InParameters->Get(NVSDK_NGX_Parameter_MV_Scale_Y, &mvScaleY) != NVSDK_NGX_Result_Success)
+    {
+        mvScaleX = 1.0f;
+        mvScaleY = 1.0f;
+    }
+    const float mvw = LowResMV() ? rw : (float) DisplayWidth();
+    const float mvh = LowResMV() ? rh : (float) DisplayHeight();
+    _constants.mvToUv[0] = mvScaleX / mvw;
+    _constants.mvToUv[1] = mvScaleY / mvh;
+    if (const char* e = std::getenv("OPTI_SGSR3_MVTOUV"))
+        sscanf(e, "%f,%f", &_constants.mvToUv[0], &_constants.mvToUv[1]);
+
+    const float sx = dw / rw, sy = dh / rh;
+    _constants.scaleRatio[0] = std::min(sx, 1.99f);
+    _constants.scaleRatio[1] = std::min(20.0f, std::pow(sx * sy, 3.0f));
+
+    float preExposure = 1.0f;
+    if (InParameters->Get(NVSDK_NGX_Parameter_DLSS_Pre_Exposure, &preExposure) != NVSDK_NGX_Result_Success ||
+        preExposure == 0.0f)
+        preExposure = 1.0f;
+    _constants.preExposure = preExposure;
+    // The exposure texture is not read: the history is in "colour / preExposure" units, the same as the replay
+    // of the bench (dumps carry no exposure). Tone mapping x / (1 + x) does not need the absolute level.
+    _constants.exposure = 1.0f;
+
+    float verticalFov = 0.0f;
+    if (InParameters->Get(OptiKeys::FSR_CameraFovVertical, &verticalFov) != NVSDK_NGX_Result_Success ||
+        verticalFov <= 0.0f)
+        verticalFov = OptiMath::GetRadiansFromDeg(Config::Instance()->FsrVerticalFov.value_or_default());
+    _constants.cameraFovAngleHor = tanf(verticalFov / 2.0f) * rw / rh;
+    _constants.minLerpContribution = 0.3f;
+
+    _constants.reactiveScale = 1.0f;
+    _constants.tcScale = 1.0f;
+
+    // Catmull-Rom history and depth-dilated motion are always on; OPTI_SGSR3_OFF=cr,dilate,masks,depth switches
+    // parts off for A/B, like sgsr_replay --s3-off.
+    _constants.flags = SGSR3Flags::CatmullRom | SGSR3Flags::DilateMv;
+    if (DepthInverted())
+        _constants.flags |= SGSR3Flags::DepthInverted;
+
+    const char* dbg = std::getenv("OPTI_SGSR3_DEBUG");
+    _constants.debugMode = dbg != nullptr ? (uint32_t) atoi(dbg) : 0u;
+
+    int reset = 0;
+    InParameters->Get(NVSDK_NGX_Parameter_Reset, &reset);
+    _constants.reset = (reset != 0 || !_historyValid) ? 1.0f : 0.0f;
+
+    if (_frameCount == 0)
+        LOG_INFO("SGSR3 constants: MV_Scale=({0}, {1}) lowResMV={2} -> mvToUv=({3}, {4}); depthInverted={5} "
+                 "preExposure={6} fovHor={7}",
+                 mvScaleX, mvScaleY, LowResMV(), _constants.mvToUv[0], _constants.mvToUv[1], DepthInverted(),
+                 preExposure, _constants.cameraFovAngleHor);
+
+    return true;
+}
diff --git a/OptiScaler/upscalers/sgsr3/SGSR3Feature.h b/OptiScaler/upscalers/sgsr3/SGSR3Feature.h
new file mode 100644
index 00000000..03837cd5
--- /dev/null
+++ b/OptiScaler/upscalers/sgsr3/SGSR3Feature.h
@@ -0,0 +1,77 @@
+#pragma once
+
+#include <upscalers/IFeature.h>
+
+//============================================================================================================
+// SGSR 3 v0 -- shared, API-independent bits.
+//
+// A temporal upscaler built on Qualcomm SGSR 2 (BSD-3-Clause) with the phase-1 items of the Vela SGSR 3
+// plan: one input contract for DLSS / FSR / XeSS, depth in either direction, exposure taken out of the history,
+// full-resolution motion vectors, the game's reactive and T&C masks, Catmull-Rom history. Shader source:
+// SGSR3_Shaders.hlsl, precompiled with fxc into SGSR3_Shaders_dxbc.h. The reference implementation and the
+// offline replay it is checked against live in (shaders/sgsr3, sgsr_replay).
+//============================================================================================================
+
+// Mirrors cbuffer SGSR3Params in SGSR3_Shaders.hlsl (HLSL packing: no field straddles a 16-byte register).
+struct alignas(16) SGSR3Constants
+{
+    float renderSize[2];
+    float displaySize[2];
+    float renderSizeRcp[2];
+    float displaySizeRcp[2];
+    float jitter[2];
+    float mvTexSize[2];
+    float mvToUv[2];
+    float scaleRatio[2];
+    float preExposure;
+    float exposure;
+    float cameraFovAngleHor;
+    float minLerpContribution;
+    float reset;
+    float reactiveScale;
+    float tcScale;
+    uint32_t flags;
+    uint32_t debugMode;
+    uint32_t pad0;
+    float depthSizeRcp[2];
+    float tcUvScale[2];
+    uint32_t renderSizeU[2];
+    uint32_t mvTexSizeU[2];
+    uint32_t pad1[2];
+};
+
+static_assert(sizeof(SGSR3Constants) == 144, "SGSR3Constants must match the HLSL cbuffer layout");
+
+namespace SGSR3Flags
+{
+constexpr uint32_t HasDepth = 1u;
+constexpr uint32_t DepthInverted = 2u;
+constexpr uint32_t HasReactive = 4u;
+constexpr uint32_t HasTc = 8u;
+constexpr uint32_t CatmullRom = 16u;
+constexpr uint32_t DilateMv = 32u;
+} // namespace SGSR3Flags
+
+class SGSR3Feature : public virtual IFeature
+{
+  protected:
+    SGSR3Constants _constants {};
+    bool _historyValid = false;
+
+    // Fills everything that does not depend on the bound resources. The backend adds the texture sizes and the
+    // mask / depth flags, which it knows only once it has the resources.
+    bool UpdateSharedConstants(NVSDK_NGX_Parameter* InParameters);
+
+  public:
+    feature_version Version() override { return feature_version { 3, 0, 0, 0 }; }
+    Upscaler GetUpscalerType() const override { return Upscaler::SGSR3; }
+
+    // Shader-only like SGSR2: nothing to load (see SGSR2Feature::ModuleLoaded).
+    bool ModuleLoaded() override { return true; }
+
+    SGSR3Feature(unsigned int InHandleId, NVSDK_NGX_Parameter* InParameters) : IFeature(InHandleId, InParameters)
+    {
+        _initParameters = SetInitParameters(InParameters);
+        _moduleLoaded = true;
+    }
+};
diff --git a/OptiScaler/upscalers/sgsr3/SGSR3Feature_Dx12.cpp b/OptiScaler/upscalers/sgsr3/SGSR3Feature_Dx12.cpp
new file mode 100644
index 00000000..860ca2b9
--- /dev/null
+++ b/OptiScaler/upscalers/sgsr3/SGSR3Feature_Dx12.cpp
@@ -0,0 +1,779 @@
+#include "pch.h"
+#include "SGSR3Feature_Dx12.h"
+#include "SGSR3_Shaders_dxbc.h"
+
+#include <Config.h>
+#include <Util.h>
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+
+static constexpr uint32_t kTileSize = 8;
+static inline uint32_t DivRoundUp(uint32_t a, uint32_t b) { return (a + b - 1) / b; }
+
+// Typed SRV / UAV formats for whatever the game handed over (same table as SGSR2).
+static DXGI_FORMAT ResolveFormat(DXGI_FORMAT format)
+{
+    switch (format)
+    {
+    case DXGI_FORMAT_R8G8B8A8_TYPELESS:
+    case DXGI_FORMAT_R8G8B8A8_UNORM_SRGB:
+        return DXGI_FORMAT_R8G8B8A8_UNORM;
+    case DXGI_FORMAT_B8G8R8A8_TYPELESS:
+    case DXGI_FORMAT_B8G8R8A8_UNORM_SRGB:
+        return DXGI_FORMAT_B8G8R8A8_UNORM;
+    case DXGI_FORMAT_R16G16B16A16_TYPELESS:
+        return DXGI_FORMAT_R16G16B16A16_FLOAT;
+    case DXGI_FORMAT_R32G32B32A32_TYPELESS:
+        return DXGI_FORMAT_R32G32B32A32_FLOAT;
+    case DXGI_FORMAT_R10G10B10A2_TYPELESS:
+        return DXGI_FORMAT_R10G10B10A2_UNORM;
+    case DXGI_FORMAT_R16G16_TYPELESS:
+        return DXGI_FORMAT_R16G16_FLOAT;
+    case DXGI_FORMAT_R32G32_TYPELESS:
+        return DXGI_FORMAT_R32G32_FLOAT;
+    case DXGI_FORMAT_R8_TYPELESS:
+        return DXGI_FORMAT_R8_UNORM;
+    case DXGI_FORMAT_R32_TYPELESS:
+    case DXGI_FORMAT_D32_FLOAT:
+        return DXGI_FORMAT_R32_FLOAT;
+    case DXGI_FORMAT_R24G8_TYPELESS:
+    case DXGI_FORMAT_D24_UNORM_S8_UINT:
+        return DXGI_FORMAT_R24_UNORM_X8_TYPELESS;
+    case DXGI_FORMAT_R16_TYPELESS:
+    case DXGI_FORMAT_D16_UNORM:
+        return DXGI_FORMAT_R16_UNORM;
+    case DXGI_FORMAT_R32G8X24_TYPELESS:
+    case DXGI_FORMAT_D32_FLOAT_S8X24_UINT:
+        return DXGI_FORMAT_R32_FLOAT_X8X24_TYPELESS;
+    default:
+        return format;
+    }
+}
+
+static ID3D12Resource* CreateTexture(ID3D12Device* device, uint32_t width, uint32_t height, DXGI_FORMAT format,
+                                     const wchar_t* name)
+{
+    D3D12_HEAP_PROPERTIES heap {};
+    heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+
+    D3D12_RESOURCE_DESC desc {};
+    desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    desc.Width = width;
+    desc.Height = height;
+    desc.DepthOrArraySize = 1;
+    desc.MipLevels = 1;
+    desc.Format = format;
+    desc.SampleDesc.Count = 1;
+    desc.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+
+    ID3D12Resource* resource = nullptr;
+    auto hr = device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &desc, D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+                                              nullptr, IID_PPV_ARGS(&resource));
+    if (FAILED(hr))
+    {
+        LOG_ERROR("CreateCommittedResource failed for {0}: {1:X}", wstring_to_string(name), (UINT) hr);
+        return nullptr;
+    }
+
+    resource->SetName(name);
+    return resource;
+}
+
+static D3D12_RESOURCE_BARRIER Transition(ID3D12Resource* res, D3D12_RESOURCE_STATES before,
+                                         D3D12_RESOURCE_STATES after)
+{
+    D3D12_RESOURCE_BARRIER b {};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = res;
+    b.Transition.StateBefore = before;
+    b.Transition.StateAfter = after;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    return b;
+}
+
+bool SGSR3FeatureDx12::CreatePipelines(ID3D12Device* device)
+{
+    D3D12_DESCRIPTOR_RANGE ranges[2] {};
+    ranges[0].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+    ranges[0].NumDescriptors = SRV_Count;
+    ranges[0].BaseShaderRegister = 0;
+    ranges[0].OffsetInDescriptorsFromTableStart = D3D12_DESCRIPTOR_RANGE_OFFSET_APPEND;
+    ranges[1].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_UAV;
+    ranges[1].NumDescriptors = UAV_Count;
+    ranges[1].BaseShaderRegister = 0;
+    ranges[1].OffsetInDescriptorsFromTableStart = D3D12_DESCRIPTOR_RANGE_OFFSET_APPEND;
+
+    D3D12_ROOT_PARAMETER params[3] {};
+    params[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_CBV;
+    params[0].Descriptor.ShaderRegister = 0;
+    params[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+    params[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    params[1].DescriptorTable.NumDescriptorRanges = 1;
+    params[1].DescriptorTable.pDescriptorRanges = &ranges[0];
+    params[1].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+    params[2].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    params[2].DescriptorTable.NumDescriptorRanges = 1;
+    params[2].DescriptorTable.pDescriptorRanges = &ranges[1];
+    params[2].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+
+    D3D12_STATIC_SAMPLER_DESC samplers[2] {};
+    for (int i = 0; i < 2; i++)
+    {
+        samplers[i].AddressU = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+        samplers[i].AddressV = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+        samplers[i].AddressW = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+        samplers[i].MaxLOD = D3D12_FLOAT32_MAX;
+        samplers[i].ShaderRegister = i;
+        samplers[i].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+    }
+    samplers[0].Filter = D3D12_FILTER_MIN_MAG_MIP_POINT;
+    samplers[1].Filter = D3D12_FILTER_MIN_MAG_MIP_LINEAR;
+
+    D3D12_ROOT_SIGNATURE_DESC rsDesc {};
+    rsDesc.NumParameters = _countof(params);
+    rsDesc.pParameters = params;
+    rsDesc.NumStaticSamplers = _countof(samplers);
+    rsDesc.pStaticSamplers = samplers;
+
+    ID3DBlob* serialized = nullptr;
+    ID3DBlob* errors = nullptr;
+    auto hr = D3D12SerializeRootSignature(&rsDesc, D3D_ROOT_SIGNATURE_VERSION_1, &serialized, &errors);
+    if (FAILED(hr))
+    {
+        LOG_ERROR("SGSR3: D3D12SerializeRootSignature failed: {0:X} {1}", (UINT) hr,
+                  errors ? (const char*) errors->GetBufferPointer() : "");
+        if (errors)
+            errors->Release();
+        return false;
+    }
+    hr = device->CreateRootSignature(0, serialized->GetBufferPointer(), serialized->GetBufferSize(),
+                                     IID_PPV_ARGS(&_rootSignature));
+    serialized->Release();
+    if (errors)
+        errors->Release();
+    if (FAILED(hr))
+    {
+        LOG_ERROR("SGSR3: CreateRootSignature failed: {0:X}", (UINT) hr);
+        return false;
+    }
+    _rootSignature->SetName(L"SGSR3_RootSignature");
+
+    struct
+    {
+        const unsigned char* code;
+        size_t size;
+        const char* name;
+        ID3D12PipelineState** target;
+    } passes[] = {
+        { sgsr3_convert_depth_dxbc, sizeof(sgsr3_convert_depth_dxbc), "SGSR3_Convert (depth)", &_convertPipeline },
+        { sgsr3_convert_nodepth_dxbc, sizeof(sgsr3_convert_nodepth_dxbc), "SGSR3_Convert (no depth)",
+          &_convertPipelineNoDepth },
+        { sgsr3_upscale_dxbc, sizeof(sgsr3_upscale_dxbc), "SGSR3_Upscale", &_upscalePipeline },
+    };
+
+    for (auto& pass : passes)
+    {
+        D3D12_COMPUTE_PIPELINE_STATE_DESC psoDesc {};
+        psoDesc.pRootSignature = _rootSignature;
+        psoDesc.CS.pShaderBytecode = pass.code;
+        psoDesc.CS.BytecodeLength = pass.size;
+        hr = device->CreateComputePipelineState(&psoDesc, IID_PPV_ARGS(pass.target));
+        if (FAILED(hr))
+        {
+            LOG_ERROR("SGSR3: CreateComputePipelineState failed for {0}: {1:X}", pass.name, (UINT) hr);
+            return false;
+        }
+    }
+
+    // DXIL upscale (min16float where the GLSL reference is mediump; it runs as fp32 on vkd3d-proton + Turnip, see
+    // SGSR3_Shaders.hlsl) is used when the device takes it: it measured ~0.1-0.2 ms faster than the DXBC pass.
+    // OPTI_SGSR3_FP32=1 or a file /tmp/sgsr3_fp32 forces the DXBC pass.
+    const char* fp32Env = std::getenv("OPTI_SGSR3_FP32");
+    const bool forceFp32 = (fp32Env != nullptr && fp32Env[0] == '1') ||
+                           GetFileAttributesA("Z:\\tmp\\sgsr3_fp32") != INVALID_FILE_ATTRIBUTES;
+    if (!forceFp32)
+    {
+        D3D12_COMPUTE_PIPELINE_STATE_DESC psoDesc {};
+        psoDesc.pRootSignature = _rootSignature;
+        psoDesc.CS.pShaderBytecode = sgsr3_upscale_fp16_dxil;
+        psoDesc.CS.BytecodeLength = sizeof(sgsr3_upscale_fp16_dxil);
+        hr = device->CreateComputePipelineState(&psoDesc, IID_PPV_ARGS(&_upscalePipelineFp16));
+        if (FAILED(hr))
+        {
+            LOG_WARN("SGSR3: DXIL upscale rejected: {0:X}; using the DXBC pass", (UINT) hr);
+            _upscalePipelineFp16 = nullptr;
+        }
+    }
+    LOG_INFO("SGSR3: upscale pass {0}", _upscalePipelineFp16 != nullptr ? "DXIL SM 6.2, min16float" : "DXBC, fp32");
+
+    return true;
+}
+
+bool SGSR3FeatureDx12::CreateResources(ID3D12Device* device)
+{
+    const uint32_t rw = RenderWidth(), rh = RenderHeight(), dw = TargetWidth(), dh = TargetHeight();
+
+    _mdr = CreateTexture(device, rw, rh, DXGI_FORMAT_R16G16B16A16_FLOAT, L"SGSR3_MotionDepthClipReactive");
+    _history[0] = CreateTexture(device, dw, dh, DXGI_FORMAT_R16G16B16A16_FLOAT, L"SGSR3_History0");
+    _history[1] = CreateTexture(device, dw, dh, DXGI_FORMAT_R16G16B16A16_FLOAT, L"SGSR3_History1");
+    _outputBuffer = CreateTexture(device, dw, dh, DXGI_FORMAT_R16G16B16A16_FLOAT, L"SGSR3_Output");
+    if (_mdr == nullptr || _history[0] == nullptr || _history[1] == nullptr || _outputBuffer == nullptr)
+        return false;
+
+    D3D12_DESCRIPTOR_HEAP_DESC heapDesc {};
+    heapDesc.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+    heapDesc.NumDescriptors = DescriptorsPerFrame * FrameRingDepth;
+    heapDesc.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+    if (FAILED(device->CreateDescriptorHeap(&heapDesc, IID_PPV_ARGS(&_descriptorHeap))))
+    {
+        LOG_ERROR("SGSR3: CreateDescriptorHeap failed");
+        return false;
+    }
+    _descriptorHeap->SetName(L"SGSR3_DescriptorHeap");
+    _descriptorSize = device->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+
+    const uint32_t cbStride = (sizeof(SGSR3Constants) + 255) & ~255u;
+    D3D12_HEAP_PROPERTIES cbHeap {};
+    cbHeap.Type = D3D12_HEAP_TYPE_UPLOAD;
+    D3D12_RESOURCE_DESC cbDesc {};
+    cbDesc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    cbDesc.Width = (UINT64) cbStride * FrameRingDepth;
+    cbDesc.Height = 1;
+    cbDesc.DepthOrArraySize = 1;
+    cbDesc.MipLevels = 1;
+    cbDesc.SampleDesc.Count = 1;
+    cbDesc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    if (FAILED(device->CreateCommittedResource(&cbHeap, D3D12_HEAP_FLAG_NONE, &cbDesc, D3D12_RESOURCE_STATE_GENERIC_READ,
+                                               nullptr, IID_PPV_ARGS(&_constantBuffer))))
+    {
+        LOG_ERROR("SGSR3: constant buffer creation failed");
+        return false;
+    }
+    _constantBuffer->SetName(L"SGSR3_Constants");
+    D3D12_RANGE noRead { 0, 0 };
+    if (FAILED(_constantBuffer->Map(0, &noRead, (void**) &_constantBufferMapped)))
+    {
+        LOG_ERROR("SGSR3: constant buffer map failed");
+        return false;
+    }
+
+    const char* timingEnv = std::getenv("OPTI_SGSR3_TIMING");
+    _timingEnabled = (timingEnv != nullptr && timingEnv[0] == '1') ||
+                     GetFileAttributesA("Z:\\tmp\\sgsr_timing") != INVALID_FILE_ATTRIBUTES;
+    if (_timingEnabled)
+    {
+        auto* queue = State::Instance().currentCommandQueue;
+        if (queue == nullptr || FAILED(queue->GetTimestampFrequency(&_timerFrequency)) || _timerFrequency == 0)
+        {
+            LOG_WARN("SGSR3: timing requested but no queue timestamp frequency; timing disabled");
+            _timingEnabled = false;
+        }
+    }
+    if (_timingEnabled)
+    {
+        D3D12_QUERY_HEAP_DESC qh {};
+        qh.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP;
+        qh.Count = TimestampsPerFrame * FrameRingDepth;
+        D3D12_HEAP_PROPERTIES rbHeap {};
+        rbHeap.Type = D3D12_HEAP_TYPE_READBACK;
+        D3D12_RESOURCE_DESC rbDesc = cbDesc;
+        rbDesc.Width = (UINT64) qh.Count * sizeof(uint64_t);
+        if (FAILED(device->CreateQueryHeap(&qh, IID_PPV_ARGS(&_timestampHeap))) ||
+            FAILED(device->CreateCommittedResource(&rbHeap, D3D12_HEAP_FLAG_NONE, &rbDesc,
+                                                   D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+                                                   IID_PPV_ARGS(&_timestampReadback))))
+        {
+            LOG_WARN("SGSR3: timestamp resources failed; timing disabled");
+            _timingEnabled = false;
+        }
+        else
+        {
+            LOG_INFO("SGSR3: GPU timing enabled, timestamp frequency {0} Hz", _timerFrequency);
+        }
+    }
+
+    _historyValid = false;
+    return true;
+}
+
+static double Percentile(std::vector<double> v, double p)
+{
+    if (v.empty())
+        return 0.0;
+    std::sort(v.begin(), v.end());
+    size_t i = (size_t) (p * (double) (v.size() - 1) + 0.5);
+    return v[std::min(i, v.size() - 1)];
+}
+
+void SGSR3FeatureDx12::ResolveTimestamps(ID3D12GraphicsCommandList* InCommandList)
+{
+    const uint32_t base = _ringIndex * TimestampsPerFrame;
+
+    auto now = std::chrono::steady_clock::now();
+    if (_timingLastEvaluate.time_since_epoch().count() != 0)
+        _timingWall.push_back(std::chrono::duration<double, std::milli>(now - _timingLastEvaluate).count());
+    _timingLastEvaluate = now;
+
+    // This slot was resolved FrameRingDepth frames ago; that frame has retired.
+    if (_frameCount >= (long) FrameRingDepth)
+    {
+        uint64_t ts[TimestampsPerFrame] {};
+        D3D12_RANGE readRange { (SIZE_T) base * sizeof(uint64_t),
+                                (SIZE_T) (base + TimestampsPerFrame) * sizeof(uint64_t) };
+        void* mapped = nullptr;
+        if (SUCCEEDED(_timestampReadback->Map(0, &readRange, &mapped)) && mapped != nullptr)
+        {
+            memcpy(ts, (const uint8_t*) mapped + readRange.Begin, sizeof(ts));
+            D3D12_RANGE noWrite { 0, 0 };
+            _timestampReadback->Unmap(0, &noWrite);
+        }
+        if (ts[1] > ts[0] && ts[3] > ts[2])
+        {
+            const double toMs = 1000.0 / (double) _timerFrequency;
+            _timingPass1.push_back((double) (ts[1] - ts[0]) * toMs);
+            _timingPass2.push_back((double) (ts[3] - ts[2]) * toMs);
+        }
+    }
+
+    if (_timingPass1.size() >= 300)
+    {
+        std::vector<double> total(_timingPass1.size());
+        for (size_t i = 0; i < total.size(); i++)
+            total[i] = _timingPass1[i] + _timingPass2[i];
+        const double wallMed = Percentile(_timingWall, 0.5);
+        LOG_INFO("SGSR3 {0}x{1} -> {2}x{3} over {4} frames: convert {5:.3f} + upscale {6:.3f} = {7:.3f} ms GPU "
+                 "(median; p95 {8:.3f}, max {9:.3f}); frame {10:.2f} ms median = {11:.1f} fps (p95 {12:.2f} ms)",
+                 RenderWidth(), RenderHeight(), TargetWidth(), TargetHeight(), total.size(),
+                 Percentile(_timingPass1, 0.5), Percentile(_timingPass2, 0.5), Percentile(total, 0.5),
+                 Percentile(total, 0.95), Percentile(total, 1.0), wallMed, wallMed > 0.0 ? 1000.0 / wallMed : 0.0,
+                 Percentile(_timingWall, 0.95));
+        _timingPass1.clear();
+        _timingPass2.clear();
+        _timingWall.clear();
+    }
+
+    InCommandList->ResolveQueryData(_timestampHeap, D3D12_QUERY_TYPE_TIMESTAMP, base, TimestampsPerFrame,
+                                    _timestampReadback, (UINT64) base * sizeof(uint64_t));
+}
+
+D3D12_GPU_DESCRIPTOR_HANDLE SGSR3FeatureDx12::BindPass(ID3D12Device* device, uint32_t passIndex,
+                                                       ID3D12Resource* const* srvs, const DXGI_FORMAT* srvFormats,
+                                                       ID3D12Resource* const* uavs, const DXGI_FORMAT* uavFormats)
+{
+    const uint32_t base = (_ringIndex * DescriptorsPerFrame) + (passIndex * DescriptorsPerPass);
+    auto cpu = _descriptorHeap->GetCPUDescriptorHandleForHeapStart();
+    auto gpu = _descriptorHeap->GetGPUDescriptorHandleForHeapStart();
+    cpu.ptr += (SIZE_T) base * _descriptorSize;
+    gpu.ptr += (UINT64) base * _descriptorSize;
+
+    for (uint32_t i = 0; i < SRV_Count; i++)
+    {
+        // A null resource with a full view desc is a valid null descriptor and reads as zero.
+        D3D12_SHADER_RESOURCE_VIEW_DESC desc {};
+        desc.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+        desc.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+        desc.Texture2D.MipLevels = 1;
+        desc.Format = srvFormats[i];
+        device->CreateShaderResourceView(srvs[i], &desc, cpu);
+        cpu.ptr += _descriptorSize;
+    }
+    for (uint32_t i = 0; i < UAV_Count; i++)
+    {
+        D3D12_UNORDERED_ACCESS_VIEW_DESC desc {};
+        desc.Format = uavFormats[i];
+        desc.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+        device->CreateUnorderedAccessView(uavs[i], nullptr, &desc, cpu);
+        cpu.ptr += _descriptorSize;
+    }
+    return gpu;
+}
+
+bool SGSR3FeatureDx12::InitInternal(ID3D12GraphicsCommandList* InCommandList, NVSDK_NGX_Parameter* InParameters)
+{
+    if (IsInited())
+        return true;
+
+    if (Device == nullptr)
+    {
+        LOG_ERROR("SGSR3: no D3D12 device");
+        return false;
+    }
+
+    if (Config::Instance()->OutputScalingEnabled.value_or_default() &&
+        (LowResMV() || RenderWidth() == DisplayWidth()))
+    {
+        float ssMulti = std::clamp(Config::Instance()->OutputScalingMultiplier.value_or_default(), 0.5f, 3.0f);
+        Config::Instance()->OutputScalingMultiplier.set_volatile_value(ssMulti);
+        _targetWidth = static_cast<unsigned int>(DisplayWidth() * ssMulti);
+        _targetHeight = static_cast<unsigned int>(DisplayHeight() * ssMulti);
+    }
+    else
+    {
+        _targetWidth = DisplayWidth();
+        _targetHeight = DisplayHeight();
+    }
+
+    if (RenderWidth() == 0 || RenderHeight() == 0 || TargetWidth() == 0 || TargetHeight() == 0)
+    {
+        LOG_ERROR("SGSR3: invalid dimensions {0}x{1} -> {2}x{3}", RenderWidth(), RenderHeight(), TargetWidth(),
+                  TargetHeight());
+        return false;
+    }
+
+    LOG_INFO("Initializing SGSR3 v0 {0}x{1} -> {2}x{3}", RenderWidth(), RenderHeight(), TargetWidth(),
+             TargetHeight());
+
+    if (!CreatePipelines(Device) || !CreateResources(Device))
+    {
+        LOG_ERROR("SGSR3: initialisation failed");
+        ReleaseResources();
+        return false;
+    }
+
+    SetInit(true);
+    return true;
+}
+
+bool SGSR3FeatureDx12::EvaluateInternal(ID3D12GraphicsCommandList* InCommandList, NVSDK_NGX_Parameter* InParameters)
+{
+    if (!IsInited() || InCommandList == nullptr)
+        return false;
+
+    auto getRes = [&](const char* key)
+    {
+        ID3D12Resource* r = nullptr;
+        if (InParameters->Get(key, &r) != NVSDK_NGX_Result_Success)
+            InParameters->Get(key, (void**) &r);
+        return r;
+    };
+
+    ID3D12Resource* paramColor = getRes(NVSDK_NGX_Parameter_Color);
+    ID3D12Resource* paramDepth = getRes(NVSDK_NGX_Parameter_Depth);
+    ID3D12Resource* paramVelocity = getRes(NVSDK_NGX_Parameter_MotionVectors);
+    ID3D12Resource* paramOutput = getRes(NVSDK_NGX_Parameter_Output);
+    ID3D12Resource* paramReactive = nullptr;
+    if (!Config::Instance()->DisableReactiveMask.value_or(true))
+        paramReactive = getRes(NVSDK_NGX_Parameter_DLSS_Input_Bias_Current_Color_Mask);
+    // FFX's transparency-and-composition mask, forwarded by OptiScaler's FSR inputs under this NGX key.
+    ID3D12Resource* paramTc = getRes(OptiKeys::FSR_TransparencyAndComp);
+
+    if (paramColor == nullptr || paramVelocity == nullptr || paramOutput == nullptr)
+    {
+        LOG_ERROR("SGSR3: missing inputs: color {0}, depth {1}, mv {2}, output {3}", paramColor != nullptr,
+                  paramDepth != nullptr, paramVelocity != nullptr, paramOutput != nullptr);
+        return false;
+    }
+
+    _hasColor = true;
+    _hasDepth = paramDepth != nullptr;
+    _hasMV = true;
+    _hasOutput = true;
+
+    if (!UpdateSharedConstants(InParameters))
+        return false;
+
+    const auto vd = paramVelocity->GetDesc();
+    const uint32_t mvW = LowResMV() ? RenderWidth() : (uint32_t) vd.Width;
+    const uint32_t mvH = LowResMV() ? RenderHeight() : vd.Height;
+    _constants.mvTexSize[0] = (float) mvW;
+    _constants.mvTexSize[1] = (float) mvH;
+    _constants.mvTexSizeU[0] = mvW;
+    _constants.mvTexSizeU[1] = mvH;
+
+    if (paramDepth != nullptr)
+    {
+        auto dd = paramDepth->GetDesc();
+        _constants.depthSizeRcp[0] = 1.0f / (float) dd.Width;
+        _constants.depthSizeRcp[1] = 1.0f / (float) dd.Height;
+        _constants.flags |= SGSR3Flags::HasDepth;
+    }
+    else
+    {
+        _constants.depthSizeRcp[0] = _constants.renderSizeRcp[0];
+        _constants.depthSizeRcp[1] = _constants.renderSizeRcp[1];
+    }
+    if (paramReactive != nullptr)
+        _constants.flags |= SGSR3Flags::HasReactive;
+    _constants.tcUvScale[0] = 1.0f;
+    _constants.tcUvScale[1] = 1.0f;
+    if (paramTc != nullptr)
+    {
+        auto td = paramTc->GetDesc();
+        _constants.tcUvScale[0] = (float) RenderWidth() / (float) td.Width;
+        _constants.tcUvScale[1] = (float) RenderHeight() / (float) td.Height;
+        _constants.flags |= SGSR3Flags::HasTc;
+    }
+
+    if (const char* off = std::getenv("OPTI_SGSR3_OFF"))
+    {
+        const std::string s = std::string(",") + off + ",";
+        auto has = [&](const char* w) { return s.find(std::string(",") + w + ",") != std::string::npos; };
+        if (has("cr"))
+            _constants.flags &= ~SGSR3Flags::CatmullRom;
+        if (has("dilate"))
+            _constants.flags &= ~SGSR3Flags::DilateMv;
+        if (has("masks"))
+            _constants.flags &= ~(SGSR3Flags::HasReactive | SGSR3Flags::HasTc);
+        if (has("depth"))
+            _constants.flags &= ~SGSR3Flags::HasDepth;
+    }
+    const bool useDepth = (_constants.flags & SGSR3Flags::HasDepth) != 0;
+
+    if (!_loggedInputs)
+    {
+        _loggedInputs = true;
+        auto cd = paramColor->GetDesc();
+        LOG_INFO("SGSR3 inputs: color {0}x{1} fmt {2}, mv {3}x{4} fmt {5} (sampled as {6}x{7}), depth {8}, "
+                 "reactive {9}, T&C {10}, output fmt {11} UAV {12}, flags 0x{13:x}",
+                 cd.Width, cd.Height, (int) cd.Format, vd.Width, vd.Height, (int) vd.Format, mvW, mvH,
+                 paramDepth != nullptr ? (int) paramDepth->GetDesc().Format : -1, paramReactive != nullptr,
+                 paramTc != nullptr, (int) paramOutput->GetDesc().Format,
+                 (paramOutput->GetDesc().Flags & D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS) != 0, _constants.flags);
+    }
+
+    const uint32_t cbStride = (sizeof(SGSR3Constants) + 255) & ~255u;
+    memcpy(_constantBufferMapped + (size_t) _ringIndex * cbStride, &_constants, sizeof(SGSR3Constants));
+
+    auto colorState = Config::Instance()->ColorResourceBarrier.value_or(D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+    auto depthState = Config::Instance()->DepthResourceBarrier.value_or(D3D12_RESOURCE_STATE_DEPTH_WRITE);
+    auto mvState = Config::Instance()->MVResourceBarrier.value_or(D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+    auto outputState = Config::Instance()->OutputResourceBarrier.value_or(D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    const auto SRV = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+    const auto UAV = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+
+    ResourceBarrier(InCommandList, paramColor, (D3D12_RESOURCE_STATES) colorState, SRV);
+    if (paramDepth != nullptr)
+        ResourceBarrier(InCommandList, paramDepth, (D3D12_RESOURCE_STATES) depthState, SRV);
+    ResourceBarrier(InCommandList, paramVelocity, (D3D12_RESOURCE_STATES) mvState, SRV);
+    const bool maskBarrier = Config::Instance()->MaskResourceBarrier.has_value();
+    if (paramReactive != nullptr && maskBarrier)
+        ResourceBarrier(InCommandList, paramReactive,
+                        (D3D12_RESOURCE_STATES) Config::Instance()->MaskResourceBarrier.value(), SRV);
+    if (paramTc != nullptr && maskBarrier)
+        ResourceBarrier(InCommandList, paramTc, (D3D12_RESOURCE_STATES) Config::Instance()->MaskResourceBarrier.value(),
+                        SRV);
+
+    // ------------------------------------------------------------------ capture of the inputs for the replay
+    _dumper.BeginFrame(Device, _frameCount);
+    SGSR2Dumper::Meta dumpMeta;
+    if (_dumper.Active())
+    {
+        const uint32_t rw = RenderWidth(), rh = RenderHeight();
+        _dumper.Capture(InCommandList, "color", paramColor, SRV, rw, rh);
+        if (paramDepth != nullptr)
+            _dumper.Capture(InCommandList, "depth", paramDepth, SRV, rw, rh);
+        _dumper.Capture(InCommandList, "mv", paramVelocity, SRV, mvW, mvH);
+        if (paramReactive != nullptr)
+            _dumper.Capture(InCommandList, "reactive", paramReactive, SRV, rw, rh);
+        if (paramTc != nullptr)
+            _dumper.Capture(InCommandList, "tc", paramTc, SRV, rw, rh);
+
+        dumpMeta.frame = _frameCount;
+        dumpMeta.renderW = rw;
+        dumpMeta.renderH = rh;
+        dumpMeta.displayW = TargetWidth();
+        dumpMeta.displayH = TargetHeight();
+        dumpMeta.jitterX = _constants.jitter[0];
+        dumpMeta.jitterY = _constants.jitter[1];
+        InParameters->Get(NVSDK_NGX_Parameter_MV_Scale_X, &dumpMeta.mvScaleX);
+        InParameters->Get(NVSDK_NGX_Parameter_MV_Scale_Y, &dumpMeta.mvScaleY);
+        // What SGSR2 would have been fed, so the replay's cs2 / fs2 paths read this capture the same way.
+        const float mvw = LowResMV() ? (float) rw : (float) DisplayWidth();
+        const float mvh = LowResMV() ? (float) rh : (float) DisplayHeight();
+        dumpMeta.motionVectorScale[0] = -2.0f * dumpMeta.mvScaleX / mvw;
+        dumpMeta.motionVectorScale[1] = 2.0f * dumpMeta.mvScaleY / mvh;
+        dumpMeta.preExposure = _constants.preExposure;
+        dumpMeta.depthInverted = DepthInverted();
+        dumpMeta.jitteredMV = JitteredMV();
+        dumpMeta.lowResMV = LowResMV();
+        dumpMeta.autoExposure = AutoExposure();
+        dumpMeta.hdr = IsHdr();
+        dumpMeta.reset = _constants.reset != 0.0f;
+        dumpMeta.hasDepth = paramDepth != nullptr;
+        InParameters->Get(NVSDK_NGX_Parameter_DLSS_Input_MV_SubrectBase_X, &dumpMeta.mvBaseX);
+        InParameters->Get(NVSDK_NGX_Parameter_DLSS_Input_MV_SubrectBase_Y, &dumpMeta.mvBaseY);
+        InParameters->Get(NVSDK_NGX_Parameter_DLSS_Input_Color_Subrect_Base_X, &dumpMeta.colorBaseX);
+        InParameters->Get(NVSDK_NGX_Parameter_DLSS_Input_Color_Subrect_Base_Y, &dumpMeta.colorBaseY);
+        char extra[512];
+        snprintf(extra, sizeof(extra),
+                 "{\"mv_to_uv\": [%.9g, %.9g], \"mv_tex_size\": [%u, %u], \"flags\": %u, \"exposure\": %.9g, "
+                 "\"camera_fov_angle_hor\": %.9g, \"min_lerp\": %.9g, \"reactive_scale\": %.9g, \"tc_scale\": %.9g, "
+                 "\"reset\": %d, \"debug\": %u, \"dxil\": %d}",
+                 _constants.mvToUv[0], _constants.mvToUv[1], mvW, mvH, _constants.flags, _constants.exposure,
+                 _constants.cameraFovAngleHor, _constants.minLerpContribution, _constants.reactiveScale,
+                 _constants.tcScale, _constants.reset != 0.0f ? 1 : 0, _constants.debugMode,
+                 _upscalePipelineFp16 != nullptr ? 1 : 0);
+        dumpMeta.extraKey = "sgsr3";
+        dumpMeta.extraJson = extra;
+    }
+
+    ID3D12Resource* prevHistory = _history[_historyIndex];
+    ID3D12Resource* nextHistory = _history[_historyIndex ^ 1];
+
+    ID3D12DescriptorHeap* heaps[] = { _descriptorHeap };
+    InCommandList->SetDescriptorHeaps(1, heaps);
+    InCommandList->SetComputeRootSignature(_rootSignature);
+    InCommandList->SetComputeRootConstantBufferView(0, _constantBuffer->GetGPUVirtualAddress() +
+                                                           (UINT64) _ringIndex * cbStride);
+
+    const DXGI_FORMAT maskFormatR = paramReactive ? ResolveFormat(paramReactive->GetDesc().Format)
+                                                  : DXGI_FORMAT_R8_UNORM;
+    const DXGI_FORMAT maskFormatT = paramTc ? ResolveFormat(paramTc->GetDesc().Format) : DXGI_FORMAT_R8_UNORM;
+
+    // ---------------------------------------------------------------- pass 1: convert
+    {
+        ID3D12Resource* srvs[SRV_Count] = { paramDepth, paramVelocity, paramReactive, nullptr, nullptr };
+        DXGI_FORMAT srvFormats[SRV_Count] = {
+            paramDepth != nullptr ? ResolveFormat(paramDepth->GetDesc().Format) : DXGI_FORMAT_R32_FLOAT,
+            ResolveFormat(vd.Format), maskFormatR, DXGI_FORMAT_R8_UNORM, DXGI_FORMAT_R8_UNORM
+        };
+        ID3D12Resource* uavs[UAV_Count] = { _mdr, nullptr };
+        DXGI_FORMAT uavFormats[UAV_Count] = { DXGI_FORMAT_R16G16B16A16_FLOAT, DXGI_FORMAT_R16G16B16A16_FLOAT };
+
+        auto table = BindPass(Device, 0, srvs, srvFormats, uavs, uavFormats);
+        InCommandList->SetPipelineState(useDepth ? _convertPipeline : _convertPipelineNoDepth);
+        InCommandList->SetComputeRootDescriptorTable(1, table);
+        auto uavTable = table;
+        uavTable.ptr += (UINT64) SRV_Count * _descriptorSize;
+        InCommandList->SetComputeRootDescriptorTable(2, uavTable);
+
+        if (_timingEnabled)
+            InCommandList->EndQuery(_timestampHeap, D3D12_QUERY_TYPE_TIMESTAMP, _ringIndex * TimestampsPerFrame + 0);
+        InCommandList->Dispatch(DivRoundUp(RenderWidth(), kTileSize), DivRoundUp(RenderHeight(), kTileSize), 1);
+        if (_timingEnabled)
+            InCommandList->EndQuery(_timestampHeap, D3D12_QUERY_TYPE_TIMESTAMP, _ringIndex * TimestampsPerFrame + 1);
+    }
+
+    {
+        D3D12_RESOURCE_BARRIER b[2] = { Transition(_mdr, UAV, SRV), Transition(prevHistory, UAV, SRV) };
+        InCommandList->ResourceBarrier(2, b);
+    }
+
+    // ---------------------------------------------------------------- pass 2: upscale
+    const bool directToOutput = (paramOutput->GetDesc().Flags & D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS) != 0;
+    ID3D12Resource* finalTarget = directToOutput ? paramOutput : _outputBuffer;
+    {
+        ID3D12Resource* srvs[SRV_Count] = { paramColor, _mdr, prevHistory, paramTc, nullptr };
+        DXGI_FORMAT srvFormats[SRV_Count] = { ResolveFormat(paramColor->GetDesc().Format),
+                                              DXGI_FORMAT_R16G16B16A16_FLOAT, DXGI_FORMAT_R16G16B16A16_FLOAT,
+                                              maskFormatT, DXGI_FORMAT_R8_UNORM };
+        ID3D12Resource* uavs[UAV_Count] = { nextHistory, finalTarget };
+        DXGI_FORMAT uavFormats[UAV_Count] = { DXGI_FORMAT_R16G16B16A16_FLOAT,
+                                              directToOutput ? ResolveFormat(paramOutput->GetDesc().Format)
+                                                             : DXGI_FORMAT_R16G16B16A16_FLOAT };
+
+        if (directToOutput && outputState != UAV)
+            ResourceBarrier(InCommandList, paramOutput, (D3D12_RESOURCE_STATES) outputState, UAV);
+
+        auto table = BindPass(Device, 1, srvs, srvFormats, uavs, uavFormats);
+        InCommandList->SetPipelineState(_upscalePipelineFp16 != nullptr ? _upscalePipelineFp16 : _upscalePipeline);
+        InCommandList->SetComputeRootDescriptorTable(1, table);
+        auto uavTable = table;
+        uavTable.ptr += (UINT64) SRV_Count * _descriptorSize;
+        InCommandList->SetComputeRootDescriptorTable(2, uavTable);
+
+        if (_timingEnabled)
+            InCommandList->EndQuery(_timestampHeap, D3D12_QUERY_TYPE_TIMESTAMP, _ringIndex * TimestampsPerFrame + 2);
+        InCommandList->Dispatch(DivRoundUp(TargetWidth(), kTileSize), DivRoundUp(TargetHeight(), kTileSize), 1);
+        if (_timingEnabled)
+            InCommandList->EndQuery(_timestampHeap, D3D12_QUERY_TYPE_TIMESTAMP, _ringIndex * TimestampsPerFrame + 3);
+    }
+
+    if (_dumper.Active())
+    {
+        _dumper.Capture(InCommandList, "sgsr3_out", finalTarget, UAV, TargetWidth(), TargetHeight());
+        _dumper.Capture(InCommandList, "sgsr3_hist", nextHistory, UAV, TargetWidth(), TargetHeight());
+        _dumper.EndFrame(dumpMeta);
+    }
+
+    if (!directToOutput)
+    {
+        D3D12_RESOURCE_BARRIER b[2] = {
+            Transition(_outputBuffer, UAV, D3D12_RESOURCE_STATE_COPY_SOURCE),
+            Transition(paramOutput, (D3D12_RESOURCE_STATES) outputState, D3D12_RESOURCE_STATE_COPY_DEST)
+        };
+        InCommandList->ResourceBarrier(2, b);
+        InCommandList->CopyResource(paramOutput, _outputBuffer);
+        D3D12_RESOURCE_BARRIER r[2] = {
+            Transition(_outputBuffer, D3D12_RESOURCE_STATE_COPY_SOURCE, UAV),
+            Transition(paramOutput, D3D12_RESOURCE_STATE_COPY_DEST, (D3D12_RESOURCE_STATES) outputState)
+        };
+        InCommandList->ResourceBarrier(2, r);
+    }
+    else if (outputState != UAV)
+    {
+        ResourceBarrier(InCommandList, paramOutput, UAV, (D3D12_RESOURCE_STATES) outputState);
+    }
+
+    {
+        D3D12_RESOURCE_BARRIER b[2] = { Transition(_mdr, SRV, UAV), Transition(prevHistory, SRV, UAV) };
+        InCommandList->ResourceBarrier(2, b);
+    }
+
+    ResourceBarrier(InCommandList, paramColor, SRV, (D3D12_RESOURCE_STATES) colorState);
+    if (paramDepth != nullptr)
+        ResourceBarrier(InCommandList, paramDepth, SRV, (D3D12_RESOURCE_STATES) depthState);
+    ResourceBarrier(InCommandList, paramVelocity, SRV, (D3D12_RESOURCE_STATES) mvState);
+    if (paramReactive != nullptr && maskBarrier)
+        ResourceBarrier(InCommandList, paramReactive, SRV,
+                        (D3D12_RESOURCE_STATES) Config::Instance()->MaskResourceBarrier.value());
+    if (paramTc != nullptr && maskBarrier)
+        ResourceBarrier(InCommandList, paramTc, SRV,
+                        (D3D12_RESOURCE_STATES) Config::Instance()->MaskResourceBarrier.value());
+
+    if (_timingEnabled)
+        ResolveTimestamps(InCommandList);
+
+    _historyIndex ^= 1;
+    _historyValid = true;
+    _ringIndex = (_ringIndex + 1) % FrameRingDepth;
+    _frameCount++;
+
+    return true;
+}
+
+void SGSR3FeatureDx12::ReleaseResources()
+{
+    auto release = [](auto*& p)
+    {
+        if (p != nullptr)
+        {
+            p->Release();
+            p = nullptr;
+        }
+    };
+
+    if (_constantBuffer != nullptr && _constantBufferMapped != nullptr)
+    {
+        _constantBuffer->Unmap(0, nullptr);
+        _constantBufferMapped = nullptr;
+    }
+
+    _dumper.Release();
+    release(_timestampHeap);
+    release(_timestampReadback);
+    release(_constantBuffer);
+    release(_mdr);
+    release(_history[0]);
+    release(_history[1]);
+    release(_outputBuffer);
+    release(_descriptorHeap);
+    release(_convertPipeline);
+    release(_convertPipelineNoDepth);
+    release(_upscalePipeline);
+    release(_upscalePipelineFp16);
+    release(_rootSignature);
+}
+
+SGSR3FeatureDx12::~SGSR3FeatureDx12()
+{
+    if (State::Instance().isShuttingDown)
+        return;
+
+    ReleaseResources();
+}
diff --git a/OptiScaler/upscalers/sgsr3/SGSR3Feature_Dx12.h b/OptiScaler/upscalers/sgsr3/SGSR3Feature_Dx12.h
new file mode 100644
index 00000000..fb956d2b
--- /dev/null
+++ b/OptiScaler/upscalers/sgsr3/SGSR3Feature_Dx12.h
@@ -0,0 +1,93 @@
+#pragma once
+
+#include "SGSR3Feature.h"
+#include <upscalers/sgsr2/SGSR2Dumper.h>
+#include <upscalers/IFeature_Dx12.h>
+
+#include <d3d12.h>
+#include <chrono>
+#include <vector>
+
+//============================================================================================================
+// SGSR 3 v0 on D3D12: two compute passes, laid out like SGSR2FeatureDx12.
+//
+//   Convert : depth + motion + reactive (render res)              -> MotionDepthClipReactive (RGBA16F)
+//   Upscale : colour + MDR + previous history + T&C mask          -> history (RGBA16F) + the game's output
+//
+// One root signature for both: b0 constants, t0..t4 SRV table, u0..u1 UAV table, s0 point / s1 linear clamp.
+// History is ping-ponged between two display-resolution buffers. Shaders are fxc-compiled DXBC.
+//
+// Diagnostics:
+//   OPTI_SGSR3_TIMING=1 or a file /tmp/sgsr_timing at creation: GPU timestamps around both passes, logged every
+//                       300 frames with the frame time between evaluations.
+//   OPTI_SGSR3_FP32=1 or a file /tmp/sgsr3_fp32 at creation: the DXBC upscale pass instead of the DXIL one.
+//   echo N > /tmp/sgsr3_dump: SGSR2Dumper capture of the inputs plus sgsr3_out / sgsr3_hist and the constants,
+//                       for sgsr_replay --only sgsr3 --s3-seed.
+//============================================================================================================
+
+class SGSR3FeatureDx12 : public SGSR3Feature, public IFeature_Dx12
+{
+  private:
+    static constexpr uint32_t SRV_Count = 5;
+    static constexpr uint32_t UAV_Count = 2;
+    static constexpr uint32_t DescriptorsPerPass = SRV_Count + UAV_Count;
+    static constexpr uint32_t DescriptorsPerFrame = DescriptorsPerPass * 2;
+    static constexpr uint32_t FrameRingDepth = 4;
+
+    ID3D12RootSignature* _rootSignature = nullptr;
+    ID3D12PipelineState* _convertPipeline = nullptr;        // HAS_DEPTH
+    ID3D12PipelineState* _convertPipelineNoDepth = nullptr;
+    ID3D12PipelineState* _upscalePipeline = nullptr;      // fp32, DXBC
+    ID3D12PipelineState* _upscalePipelineFp16 = nullptr;  // DXIL (min16float); used when the device takes it
+
+    ID3D12DescriptorHeap* _descriptorHeap = nullptr;
+    uint32_t _descriptorSize = 0;
+    uint32_t _ringIndex = 0;
+
+    ID3D12Resource* _constantBuffer = nullptr;
+    uint8_t* _constantBufferMapped = nullptr;
+
+    ID3D12Resource* _mdr = nullptr;
+    ID3D12Resource* _history[2] = { nullptr, nullptr };
+    ID3D12Resource* _outputBuffer = nullptr;
+    uint32_t _historyIndex = 0;
+
+    bool _loggedInputs = false;
+
+    // GPU timing
+    static constexpr uint32_t TimestampsPerFrame = 4;
+    ID3D12QueryHeap* _timestampHeap = nullptr;
+    ID3D12Resource* _timestampReadback = nullptr;
+    bool _timingEnabled = false;
+    uint64_t _timerFrequency = 0;
+    std::vector<double> _timingPass1, _timingPass2, _timingWall;
+    std::chrono::steady_clock::time_point _timingLastEvaluate {};
+
+    void ResolveTimestamps(ID3D12GraphicsCommandList* InCommandList);
+
+    SGSR2Dumper _dumper;
+
+    bool CreatePipelines(ID3D12Device* device);
+    bool CreateResources(ID3D12Device* device);
+    void ReleaseResources();
+
+    D3D12_GPU_DESCRIPTOR_HANDLE BindPass(ID3D12Device* device, uint32_t passIndex, ID3D12Resource* const* srvs,
+                                         const DXGI_FORMAT* srvFormats, ID3D12Resource* const* uavs,
+                                         const DXGI_FORMAT* uavFormats);
+
+  public:
+    SGSR3FeatureDx12(unsigned int InHandleId, NVSDK_NGX_Parameter* InParameters)
+        : SGSR3Feature(InHandleId, InParameters), IFeature_Dx12(InHandleId, InParameters),
+          IFeature(InHandleId, InParameters)
+    {
+    }
+
+    bool InitInternal(ID3D12GraphicsCommandList* InCommandList, NVSDK_NGX_Parameter* InParameters) override;
+    bool EvaluateInternal(ID3D12GraphicsCommandList* InCommandList, NVSDK_NGX_Parameter* InParameters) override;
+
+    feature_version Version() override { return SGSR3Feature::Version(); }
+    Upscaler GetUpscalerType() const final { return Upscaler::SGSR3; }
+    bool IsWithDx12() final { return false; }
+
+    ~SGSR3FeatureDx12() override;
+};
diff --git a/OptiScaler/upscalers/sgsr3/SGSR3_Shaders.hlsl b/OptiScaler/upscalers/sgsr3/SGSR3_Shaders.hlsl
new file mode 100644
index 00000000..3102ad7e
--- /dev/null
+++ b/OptiScaler/upscalers/sgsr3/SGSR3_Shaders.hlsl
@@ -0,0 +1,379 @@
+// SGSR 3 v0 -- HLSL (cs_5_0) port of the research shaders, two compute passes.
+//
+// Built on Qualcomm Snapdragon GSR 2 (glsl_2_pass_fs, BSD-3-Clause, Copyright (c) 2024 Qualcomm Innovation Center,
+// Inc.; licence text in LICENSES/BSD-3-Clause-Qualcomm.txt), plus the phase-1 items of the SGSR 3 plan:
+//   1. one input contract: motion folded into mvToUv on the host, jitter in render px as the game passed it;
+//   2. depth in either direction, exposure / pre-exposure divided out before blending;
+//   3. full-resolution motion vectors and captures without depth;
+//   4. the game's reactive and transparency-and-composition masks;
+//   5. history resampled with a 5-tap Catmull-Rom.
+//
+// The GLSL reference runs as two fragment passes; here both are compute, one thread per output texel, with the
+// same arithmetic. Differences that are not arithmetic:
+//   - depth is gathered with the depth texture's own size (games pad it: 1132x636 behind a 1129x636 render);
+//   - the T&C mask is sampled with its own size;
+//   - NaN / Inf are tested on the bit pattern, which no compiler folds away.
+//
+// Compiled offline with fxc (tools/gen_sgsr3_dxbc.py in ), not with
+// D3DCompile at run time: under Proton that is Wine's HLSL compiler, which miscompiles float conversions of the
+// thread position (see SGSR2_Shaders.h). The sampling positions stay integer anyway.
+//
+//   CSConvert  (render res)  depth, motion, reactive          -> MotionDepthClipReactive (RGBA16F)
+//   CSUpscale  (display res) colour, MDR, history, T&C mask   -> HistoryOut (RGBA16F), SceneOut (game output)
+
+cbuffer SGSR3Params : register(b0)
+{
+    float2 renderSize;
+    float2 displaySize;
+    float2 renderSizeRcp;
+    float2 displaySizeRcp;
+    float2 jitter;              // render px, "pixel p shows the scene at p - jitter" (NGX / FFX convention)
+    float2 mvTexSize;           // the motion-vector texture region: render size, or display size for full-res vectors
+    float2 mvToUv;              // raw texel * mvToUv = previous UV - current UV
+    float2 scaleRatio;          // x: min(display / render, 1.99), y: min(20, (sx * sy)^3)
+    float  preExposure;
+    float  exposure;
+    float  cameraFovAngleHor;
+    float  minLerpContribution;
+    float  reset;
+    float  reactiveScale;
+    float  tcScale;
+    uint   flags;
+    uint   debugMode;
+    uint   pad0;
+    float2 depthSizeRcp;        // 1 / depth texture size (texel-aligned gathers)
+    float2 tcUvScale;           // renderSize / T&C texture size
+    uint2  renderSizeU;
+    uint2  mvTexSizeU;
+    uint2  pad1;
+};
+
+#define SGSR3_HAS_DEPTH      1u
+#define SGSR3_DEPTH_INVERTED 2u
+#define SGSR3_HAS_REACTIVE   4u
+#define SGSR3_HAS_TC         8u
+#define SGSR3_CATMULL_ROM    16u
+#define SGSR3_DILATE_MV      32u
+
+SamplerState PointClamp  : register(s0);
+SamplerState LinearClamp : register(s1);
+
+bool Flag(uint f) { return (flags & f) != 0u; }
+
+// NaN or Inf: exponent bits all set.
+bool NotFinite(float x) { return (asuint(x) & 0x7f800000u) == 0x7f800000u; }
+
+#ifdef SGSR3_CONVERT
+// ------------------------------------------------------------------------------------------------- pass 1
+Texture2D<float>  InputDepth    : register(t0);
+Texture2D<float4> InputMotion   : register(t1);
+Texture2D<float4> InputReactive : register(t2);
+Texture2D<float4> Unused3       : register(t3);
+Texture2D<float4> Unused4       : register(t4);
+
+RWTexture2D<float4> MotionDepthClipReactive : register(u0);
+RWTexture2D<float4> Unused5                 : register(u1);
+
+[numthreads(8, 8, 1)]
+void CSConvert(uint3 tid : SV_DispatchThreadID)
+{
+    if (tid.x >= renderSizeU.x || tid.y >= renderSizeU.y)
+        return;
+
+    const int2 rs = int2(renderSizeU);
+    const int2 pos = int2(tid.xy);
+
+    float depthclip = 0.0f;
+    int2 best = int2(0, 0);
+#ifdef HAS_DEPTH
+    {
+        // The 4x4 window SGSR 2 gathers (pos-1 .. pos+2) as four gathers at texel corners. Gather order:
+        // x = (0,1), y = (1,1), z = (1,0), w = (0,0) within each 2x2 block, as in GLSL.
+        float2 base = float2(tid.xy) * depthSizeRcp;
+        float2 two = 2.0f * depthSizeRcp;
+        float4 g00 = InputDepth.GatherRed(PointClamp, base);
+        float4 g10 = InputDepth.GatherRed(PointClamp, base + float2(two.x, 0.0f));
+        float4 g01 = InputDepth.GatherRed(PointClamp, base + float2(0.0f, two.y));
+        float4 g11 = InputDepth.GatherRed(PointClamp, base + two);
+        if (Flag(SGSR3_DEPTH_INVERTED))
+        {
+            g00 = 1.0f - g00; g10 = 1.0f - g10; g01 = 1.0f - g01; g11 = 1.0f - g11;
+        }
+        float w[16] = { g00.w, g00.z, g10.w, g10.z,
+                        g00.x, g00.y, g10.x, g10.y,
+                        g01.w, g01.z, g11.w, g11.z,
+                        g01.x, g01.y, g11.x, g11.y };
+
+        float maxC = min(min(w[5], w[6]), min(w[9], w[10]));
+        float q0 = min(min(w[0], w[1]), min(w[4], w[5]));
+        float q1 = min(min(w[2], w[3]), min(w[6], w[7]));
+        float q2 = min(min(w[8], w[9]), min(w[12], w[13]));
+        float q3 = min(min(w[10], w[11]), min(w[14], w[15]));
+        if (maxC < 1.0f - 1.0e-05f)
+        {
+            float Ksep = 1.37e-05f;
+            float Depthsep = Ksep * cameraFovAngleHor * length(renderSize) * (1.0f - maxC);
+            const float EPSILON = 1.19e-07f;
+            float Wdepth = saturate(Depthsep / (abs(maxC - q0) + EPSILON))
+                         + saturate(Depthsep / (abs(maxC - q1) + EPSILON))
+                         + saturate(Depthsep / (abs(maxC - q2) + EPSILON))
+                         + saturate(Depthsep / (abs(maxC - q3) + EPSILON));
+            depthclip = saturate(1.0f - Wdepth * 0.25f);
+        }
+
+        if (Flag(SGSR3_DILATE_MV))
+        {
+            float nearest = w[5];
+            [unroll] for (int j = 0; j < 3; j++)
+                [unroll] for (int i = 0; i < 3; i++)
+                {
+                    float d = w[j * 4 + i];
+                    if (d < nearest)
+                    {
+                        nearest = d;
+                        best = int2(i - 1, j - 1);
+                    }
+                }
+        }
+    }
+#endif
+
+    // Full-resolution vectors sit at the scaled position. Integer maths only.
+    uint2 q = uint2(clamp(pos + best, int2(0, 0), rs - 1));
+    uint2 mvPos = min((q * mvTexSizeU + (mvTexSizeU >> 1)) / renderSizeU, mvTexSizeU - 1u);
+    float2 raw = InputMotion.Load(int3(mvPos, 0)).xy;
+    float2 motion = raw * mvToUv;
+    if (NotFinite(motion.x) || NotFinite(motion.y) || abs(motion.x) > 4.0f || abs(motion.y) > 4.0f)
+        motion = float2(0.0f, 0.0f);
+
+    float reactive = 0.0f;
+    if (Flag(SGSR3_HAS_REACTIVE))
+    {
+        [unroll] for (int j = -1; j <= 1; j++)
+            [unroll] for (int i = -1; i <= 1; i++)
+                reactive = max(reactive, InputReactive.Load(int3(clamp(pos + int2(i, j), int2(0, 0), rs - 1), 0)).r);
+        reactive = min(reactive * reactiveScale, 0.9f);
+    }
+
+    MotionDepthClipReactive[tid.xy] = float4(motion, depthclip, reactive);
+}
+#endif
+
+#ifdef SGSR3_UPSCALE
+// ------------------------------------------------------------------------------------------------- pass 2
+//
+// Precision: the GLSL reference is "precision mediump float" with the UV / position maths and the Catmull-Rom
+// weights in highp. MF* mark its mediump values. With SGSR3_FP16 (DXIL SM 6.2 from dxc) they are min16float; on
+// this stack that still runs as fp32 (in-game output matches the replay with highp to 76 dB), while the real
+// half type (dxc -enable-16bit-types) is refused by vkd3d-proton on Turnip (CreateComputePipelineState
+// E_INVALIDARG: no native 16-bit shader ops). The DXIL pass is kept because it measured ~0.1-0.2 ms faster than
+// the same code as DXBC. Without SGSR3_FP16 (DXBC from fxc) MF* are float.
+// Literals carry no suffix so they take the type of the other operand.
+#ifdef SGSR3_FP16
+#define MF  min16float
+#define MF2 min16float2
+#define MF3 min16float3
+#define MF4 min16float4
+#else
+#define MF  float
+#define MF2 float2
+#define MF3 float3
+#define MF4 float4
