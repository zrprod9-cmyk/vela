+
+// highp inside, mediump result
+MF3 historyCatmullRom(float2 uv)
+{
+    float2 samplePos = uv * displaySize;
+    float2 tc1 = floor(samplePos - 0.5) + 0.5;
+    float2 f = samplePos - tc1;
+    float2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
+    float2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
+    float2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
+    float2 w3 = f * f * (-0.5 + 0.5 * f);
+    float2 w12 = w1 + w2;
+    float2 tc0 = (tc1 - 1.0) * displaySizeRcp;
+    float2 tc3 = (tc1 + 2.0) * displaySizeRcp;
+    float2 tc12 = (tc1 + w2 / w12) * displaySizeRcp;
+
+    float a = w12.x * w0.y, b = w0.x * w12.y, c = w12.x * w12.y, d = w3.x * w12.y, e = w12.x * w3.y;
+    float3 r = PrevHistory.SampleLevel(LinearClamp, float2(tc12.x, tc0.y), 0.0).xyz * a
+             + PrevHistory.SampleLevel(LinearClamp, float2(tc0.x, tc12.y), 0.0).xyz * b
+             + PrevHistory.SampleLevel(LinearClamp, tc12, 0.0).xyz * c
+             + PrevHistory.SampleLevel(LinearClamp, float2(tc3.x, tc12.y), 0.0).xyz * d
+             + PrevHistory.SampleLevel(LinearClamp, float2(tc12.x, tc3.y), 0.0).xyz * e;
+    return (MF3) max(r / (a + b + c + d + e), 0.0);
+}
