+++ b/OptiScaler/upscalers/sgsr3/Fsr4VkBridge.h
@@ -0,0 +1,477 @@
+#pragma once
+// FSR 4 VK INT8 as a Vela model (live model "fsr4", Vela 0.6.0). The fsr4vk provider (github.com/dvj5411/fsr4vk,
+// GPLv3; its AMD-derived model payloads under AMD's MIT licence; built by Vela from source,
+// decky-upscale/tools/build_fsr4vk.sh) is a native Vulkan FFX upscaler with a portable INT8 backend: no AMD runtime,
+// no VK_KHR_cooperative_matrix (Turnip has none). It runs here on vkd3d-proton's own VkDevice through the interop the
+// student uses: the game's D3D12 resources are handed over as VkImages in the layouts the provider samples
+// (SHADER_READ_ONLY_OPTIMAL inputs, GENERAL output) and moved back afterwards, inside the game's command list.
+// Included after pch.h and SGSR3Student_Vk.h (interop interface).
+#include <Config.h>
+#include <proxies/Ntdll_Proxy.h>
+#include <Util.h>
+
+#include <cstdint>
+#include <cstring>
+#include <filesystem>
+#include <string>
+#include <vector>
+
+namespace Fsr4Vk
+{
+// FFX API subset (FidelityFX SDK headers, MIT): the provider's ABI
+using ffxStructType_t = uint64_t;
+using ffxReturnCode_t = uint32_t;
+using ffxContext = void*;
+struct ffxApiHeader
+{
+    ffxStructType_t type;
+    ffxApiHeader* pNext;
+};
+struct FfxApiDimensions2D
+{
+    uint32_t width, height;
+};
+struct FfxApiFloatCoords2D
+{
+    float x, y;
+};
+struct FfxApiResourceDescription
+{
+    uint32_t type, format, width, height, depth, mipCount, flags, usage;
+};
+struct FfxApiResource
+{
+    void* resource;
+    FfxApiResourceDescription description;
+    uint32_t state;
+};
+struct CreateUpscale
+{
+    ffxApiHeader header;
+    uint32_t flags;
+    FfxApiDimensions2D maxRenderSize, maxUpscaleSize;
+    void (*fpMessage)(uint32_t type, const wchar_t* message);
+};
+struct DispatchUpscale
+{
+    ffxApiHeader header;
+    void* commandList;
+    FfxApiResource color, depth, motionVectors, exposure, reactive, transparencyAndComposition, output;
+    FfxApiFloatCoords2D jitterOffset, motionVectorScale;
+    FfxApiDimensions2D renderSize, upscaleSize;
+    bool enableSharpening;
+    float sharpness, frameTimeDelta, preExposure;
+    bool reset;
+    float cameraNear, cameraFar, cameraFovAngleVertical, viewSpaceToMetersFactor;
+    uint32_t flags;
+};
+struct BackendVk
+{
+    ffxApiHeader header;
+    VkDevice device;
+    VkPhysicalDevice physicalDevice;
+    PFN_vkGetDeviceProcAddr getDeviceProcAddr;
+};
+struct OverrideVersion
+{
+    ffxApiHeader header;
+    uint64_t versionId;
+};
+// fsr4vk's own create descriptor (provider/ffx_vk_create_device_features.h): the recording queue family turns on
+// its per-pass GPU timestamps when FSR4_VK_PROFILE_PATH is set (UINT32_MAX = unknown, profiling off)
+struct DeviceFeatures
+{
+    ffxApiHeader header;
+    uint32_t enabledFlags, apiVersion, queueFamilyIndex;
+};
+using PfnCreate = ffxReturnCode_t (*)(ffxContext*, ffxApiHeader*, const void*);
+using PfnDestroy = ffxReturnCode_t (*)(ffxContext*, const void*);
+using PfnDispatch = ffxReturnCode_t (*)(ffxContext*, const ffxApiHeader*);
+
+constexpr ffxStructType_t kCreateUpscale = 0x00010000u, kDispatchUpscale = 0x00010001u, kBackendVk = 3u,
+                          kOverrideVersion = 5u, kDeviceFeatures = 0x4653523444455643ull;
+constexpr uint32_t kDepthInverted = 1u << 3, kHdr = 1u << 0, kAutoExposure = 1u << 5;
+constexpr uint32_t kTexture2D = 2u;  // FFX_API_RESOURCE_TYPE_TEXTURE2D (BUFFER 0, TEXTURE1D 1)
+constexpr uint32_t kUsageUav = 1u << 1, kUsageDepth = 1u << 2, kUsageStencil = 1u << 5;
+constexpr uint32_t kStateUav = 1u << 1, kStateComputeRead = 1u << 2;
+// provider version ids (fsr4vk provider/ffx_vk_provider.cpp)
+constexpr uint64_t kFsr411 = (0xF5A5CA1Eull << 32) | ((4ull << 22) | (1ull << 12) | 1ull);
+constexpr uint64_t kFsr402 = (0xF5A5CA1Eull << 32) | ((4ull << 22) | (0ull << 12) | 2ull);
+
+// FfxApiSurfaceFormat values (ffx_api_types.h order): UNKNOWN 0, R32G32B32A32_TYPELESS 1, R32G32B32A32_UINT 2,
+// R32G32B32A32_FLOAT 3, R16G16B16A16_FLOAT 4, R32G32B32_FLOAT 5, R32G32_FLOAT 6, R8_UINT 7, R32_UINT 8,
+// R8G8B8A8_TYPELESS 9, R8G8B8A8_UNORM 10, R8G8B8A8_SNORM 11, R8G8B8A8_SRGB 12, B8G8R8A8_TYPELESS 13,
+// B8G8R8A8_UNORM 14, B8G8R8A8_SRGB 15, R11G11B10_FLOAT 16, R10G10B10A2_UNORM 17, R16G16_FLOAT 18, R16G16_UINT 19,
+// R16G16_SINT 20, R16_FLOAT 21, R16_UINT 22, R16_UNORM 23, R16_SNORM 24, R8_UNORM 25, R8G8_UNORM 26, R8G8_UINT 27,
+// R32_FLOAT 28, R9G9B9E5_SHAREDEXP 29 (checked against ffx_api_types.h of FidelityFX SDK 2.x)
+enum Fmt : uint32_t
+{
+    RGBA16F = 4,
+    R11G11B10F = 16,
+    RG16F = 18,
+    R32F = 28,
+    R9G9B9E5 = 29,
+};
+} // namespace Fsr4Vk
+
+class Fsr4VkBridge
+{
+  public:
+    struct Tex
+    {
+        ID3D12Resource* res = nullptr;
+        D3D12_RESOURCE_STATES state = D3D12_RESOURCE_STATE_COMMON;
+    };
+    struct Frame
+    {
+        float jitterX = 0, jitterY = 0, mvScaleX = 1, mvScaleY = 1, preExposure = 1, frameTimeMs = 16.6f;
+        float cameraNear = 0.1f, cameraFar = 1000.0f, fovV = 1.0f;
+        bool reset = false;
+    };
+
+    bool Init(ID3D12Device* device, uint32_t rw, uint32_t rh, uint32_t dw, uint32_t dh, bool depthInverted, bool hdr,
+              bool lowResMv, bool jitteredMv)
+    {
+        Release();
+        _rw = rw;
+        _rh = rh;
+        _dw = dw;
+        _dh = dh;
+        if (!depthInverted || !lowResMv || jitteredMv)
+        {
+            LOG_WARN("Vela FSR 4 VK: the provider needs inverted depth and render-size, non-jittered motion vectors "
+                     "(depthInverted {}, lowResMV {}, jitteredMV {})",
+                     depthInverted, lowResMv, jitteredMv);
+            return false;
+        }
+        if (FAILED(device->QueryInterface(__uuidof(ID3D12DXVKInteropDevice1), (void**) &_interop)) || !_interop)
+        {
+            LOG_ERROR("Vela FSR 4 VK: no vkd3d-proton interop");
+            return false;
+        }
+        VkInstance inst = VK_NULL_HANDLE;
+        if (FAILED(_interop->GetVulkanHandles(&inst, &_physical, &_vk)) || _vk == VK_NULL_HANDLE)
+        {
+            LOG_ERROR("Vela FSR 4 VK: GetVulkanHandles failed");
+            return false;
+        }
+        // the provider records with descriptor buffers: vkd3d-proton must have enabled the extension on its device
+        bool descBuf = false, sync2 = false;
+        UINT n = 0;
+        if (SUCCEEDED(_interop->GetDeviceExtensions(&n, nullptr)) && n > 0)
+        {
+            std::vector<const char*> ext(n);
+            if (SUCCEEDED(_interop->GetDeviceExtensions(&n, ext.data())))
+                for (auto* e : ext)
+                {
+                    descBuf |= e && !strcmp(e, "VK_EXT_descriptor_buffer");
+                    sync2 |= e && !strcmp(e, "VK_KHR_synchronization2");
+                }
+        }
+        LOG_INFO("Vela FSR 4 VK: vkd3d device extensions: descriptor_buffer {}, synchronization2 {}", descBuf, sync2);
+        if (!descBuf)
+        {
+            LOG_ERROR("Vela FSR 4 VK: vkd3d-proton's device has no VK_EXT_descriptor_buffer, the provider cannot run");
+            return false;
+        }
+        // next to our dxgi.dll (the game folder), else OptiScaler's main folder (<game>\OptiScaler when it exists)
+        for (const auto& dir : { Util::DllPath().parent_path(),
+                                 std::filesystem::path(Config::Instance()->MainDllPath.value_or(L"")) })
+        {
+            const auto file = dir / L"amd_fidelityfx_upscaler_vk.dll";
+            if (_dll != nullptr || !std::filesystem::exists(file))
+                continue;
+            _dll = NtdllProxy::LoadLibraryExW_Ldr(file.wstring().c_str(), NULL, LOAD_WITH_ALTERED_SEARCH_PATH);
+            if (!_dll)
+                LOG_ERROR("Vela FSR 4 VK: cannot load {0}: error {1}", wstring_to_string(file.wstring()),
+                          GetLastError());
+        }
+        if (!_dll)
+        {
+            LOG_ERROR("Vela FSR 4 VK: amd_fidelityfx_upscaler_vk.dll not found next to the DLL");
+            return false;
+        }
+        _create = (Fsr4Vk::PfnCreate) GetProcAddress(_dll, "ffxCreateContext");
+        _destroy = (Fsr4Vk::PfnDestroy) GetProcAddress(_dll, "ffxDestroyContext");
+        _dispatch = (Fsr4Vk::PfnDispatch) GetProcAddress(_dll, "ffxDispatch");
+        if (!_create || !_destroy || !_dispatch)
+        {
+            LOG_ERROR("Vela FSR 4 VK: the provider has no FFX exports");
+            return false;
+        }
+        Fsr4Vk::CreateUpscale c {};
+        c.header.type = Fsr4Vk::kCreateUpscale;
+        c.flags = Fsr4Vk::kDepthInverted | Fsr4Vk::kAutoExposure | (hdr ? Fsr4Vk::kHdr : 0u);
+        c.maxRenderSize = { rw, rh };
+        c.maxUpscaleSize = { dw, dh };
+        c.fpMessage = &Message;
+        Fsr4Vk::BackendVk b {};
+        b.header.type = Fsr4Vk::kBackendVk;
+        b.device = _vk;
+        b.physicalDevice = _physical;
+        b.getDeviceProcAddr = vkGetDeviceProcAddr;
+        Fsr4Vk::OverrideVersion ov {};
+        ov.header.type = Fsr4Vk::kOverrideVersion;
+        // VELA_FSR4_VER=402: FSR 4.0.2 (15 passes) instead of 4.1.1 -- A/B of the two models' cost
+        const char* ver = std::getenv("VELA_FSR4_VER");
+        _v402 = ver != nullptr && std::strcmp(ver, "402") == 0;
+        ov.versionId = _v402 ? Fsr4Vk::kFsr402 : Fsr4Vk::kFsr411;
+        // Turnip has one queue family; vkd3d-proton records the game's direct queue on it
+        Fsr4Vk::DeviceFeatures df {};
+        df.header.type = Fsr4Vk::kDeviceFeatures;
+        df.queueFamilyIndex = 0;
+        c.header.pNext = &b.header;
+        b.header.pNext = &ov.header;
+        ov.header.pNext = &df.header;
+        const auto r = _create(&_ctx, &c.header, nullptr);
+        if (r != 0 || !_ctx)
+        {
+            LOG_ERROR("Vela FSR 4 VK: ffxCreateContext failed ({}) for {}x{} -> {}x{}", r, rw, rh, dw, dh);
+            _ctx = nullptr;
+            return false;
+        }
+        if (!MakeFlush(device))
+            return false;
+        LOG_INFO("Vela FSR 4 VK: FSR {} VK INT8 context {}x{} -> {}x{} (hdr {})", _v402 ? "4.0.2" : "4.1.1", rw, rh, dw,
+                 dh, hdr);
+        _ready = true;
+        return true;
+    }
+
+    bool Ready() const { return _ready; }
+    bool SizesMatch(uint32_t rw, uint32_t rh, uint32_t dw, uint32_t dh) const
+    {
+        return rw == _rw && rh == _rh && dw == _dw && dh == _dh;
+    }
+
+    bool Evaluate(ID3D12GraphicsCommandList* cl, const Tex& color, const Tex& depth, const Tex& mv, const Tex& output,
+                  const Frame& f)
+    {
+        if (!_ready || !color.res || !depth.res || !mv.res || !output.res)
+            return false;
+        Img in[3], out;
+        if (!Get(color, in[0], false) || !Get(depth, in[1], true) || !Get(mv, in[2], false) || !Get(output, out, false))
+            return false;
+        Fsr4Vk::DispatchUpscale d {};
+        d.header.type = Fsr4Vk::kDispatchUpscale;
+        d.color = Res(in[0], _rw, _rh, Fsr4Vk::kStateComputeRead, 0);
+        d.depth = Res(in[1], _rw, _rh, Fsr4Vk::kStateComputeRead, in[1].depthUsage);
+        d.motionVectors = Res(in[2], _rw, _rh, Fsr4Vk::kStateComputeRead, 0);
+        d.output = Res(out, _dw, _dh, Fsr4Vk::kStateUav, Fsr4Vk::kUsageUav);
+        if (!d.color.description.format)
+            return Unsupported("colour", in[0].fmt);
+        if (!d.depth.description.format)
+            return Unsupported("depth", in[1].fmt);
+        if (!d.motionVectors.description.format)
+            return Unsupported("motion vectors", in[2].fmt);
+        if (!d.output.description.format)
+            return Unsupported("output", out.fmt);
+        d.jitterOffset = { f.jitterX, f.jitterY };
+        d.motionVectorScale = { f.mvScaleX, f.mvScaleY };
+        d.renderSize = { _rw, _rh };
+        d.upscaleSize = { _dw, _dh };
+        d.frameTimeDelta = f.frameTimeMs;
+        d.preExposure = f.preExposure > 0.0f ? f.preExposure : 1.0f;
+        d.reset = f.reset;
+        d.cameraNear = f.cameraNear;
+        d.cameraFar = f.cameraFar;
+        d.cameraFovAngleVertical = f.fovV;
+        // vkd3d-proton batches D3D12 barriers until the next command: a 4-byte copy makes it emit them first
+        cl->CopyBufferRegion(_flush[1], 0, _flush[0], 0, 4);
+        VkCommandBuffer cb = VK_NULL_HANDLE;
+        if (FAILED(_interop->BeginVkCommandBufferInterop(cl, &cb)) || cb == VK_NULL_HANDLE)
+        {
+            LOG_ERROR("Vela FSR 4 VK: BeginVkCommandBufferInterop failed");
+            return false;
+        }
+        Transition(cb, in, 3, out, true);
+        d.commandList = cb;
+        const auto r = _dispatch(&_ctx, &d.header);
+        Transition(cb, in, 3, out, false);
+        _interop->EndVkCommandBufferInterop(cl);
+        if (r != 0)
+        {
+            if (_failLogged++ < 3)
+                LOG_ERROR("Vela FSR 4 VK: ffxDispatch failed ({})", r);
+            return false;
+        }
+        if (_frames++ == 0)
+            LOG_INFO("Vela FSR 4 VK: first frame dispatched (colour fmt {}, depth fmt {}, mv fmt {}, out fmt {})",
+                     (int) in[0].fmt, (int) in[1].fmt, (int) in[2].fmt, (int) out.fmt);
+        return true;
+    }
+
+    void Release()
+    {
+        if (_ctx && _destroy)
+        {
+            if (_interop && _vk)
+                vkDeviceWaitIdle(_vk);  // the provider keeps up to eight frames in flight
+            _destroy(&_ctx, nullptr);
+        }
+        _ctx = nullptr;
+        for (auto*& b : _flush)
+            if (b)
+            {
+                b->Release();
+                b = nullptr;
+            }
+        if (_interop)
+        {
+            _interop->Release();
+            _interop = nullptr;
+        }
+        _ready = false;
+        _frames = 0;
+        // the provider DLL stays loaded (contexts of other features may still use it)
+    }
+
+    ~Fsr4VkBridge() { Release(); }
+
+  private:
+    struct Img
+    {
+        VkImage image = VK_NULL_HANDLE;
+        VkFormat fmt = VK_FORMAT_UNDEFINED;
+        VkImageLayout layout = VK_IMAGE_LAYOUT_GENERAL;
+        VkImageAspectFlags aspect = VK_IMAGE_ASPECT_COLOR_BIT;
+        uint32_t depthUsage = 0;
+    };
+
+    static void Message(uint32_t type, const wchar_t* message)
+    {
+        if (message == nullptr)
+            return;
+        std::string s;
+        for (const wchar_t* p = message; *p && s.size() < 400; p++)
+            s += (*p < 128) ? (char) *p : '?';
+        LOG_INFO("Vela FSR 4 VK provider ({}): {}", type, s);
+    }
+
+    bool Unsupported(const char* what, VkFormat f)
+    {
+        if (_failLogged++ < 3)
+            LOG_ERROR("Vela FSR 4 VK: {} format VkFormat {} is not one the provider takes", what, (int) f);
+        return false;
+    }
+
+    bool Get(const Tex& t, Img& img, bool depth)
+    {
+        UINT64 handle = 0, offset = 0;
+        if (FAILED(_interop->GetVulkanResourceInfo1(t.res, &handle, &offset, &img.fmt)) || handle == 0)
+            return false;
+        img.image = (VkImage) handle;
+        _interop->GetVulkanImageLayout(t.res, t.state, &img.layout);
+        if (depth)
+        {
+            const bool stencil = img.fmt == VK_FORMAT_D32_SFLOAT_S8_UINT;
+            const bool d = stencil || img.fmt == VK_FORMAT_D32_SFLOAT;
+            img.aspect = d ? (VkImageAspectFlags) (VK_IMAGE_ASPECT_DEPTH_BIT | (stencil ? VK_IMAGE_ASPECT_STENCIL_BIT : 0))
+                           : (VkImageAspectFlags) VK_IMAGE_ASPECT_COLOR_BIT;
+            img.depthUsage = d ? (Fsr4Vk::kUsageDepth | (stencil ? Fsr4Vk::kUsageStencil : 0u)) : 0u;
+        }
+        return true;
+    }
+
+    static uint32_t FfxFormat(VkFormat f)
+    {
+        switch (f)
+        {
+        case VK_FORMAT_R16G16B16A16_SFLOAT:
+            return Fsr4Vk::RGBA16F;
+        case VK_FORMAT_B10G11R11_UFLOAT_PACK32:
+            return Fsr4Vk::R11G11B10F;
+        case VK_FORMAT_E5B9G9R9_UFLOAT_PACK32:
+            return Fsr4Vk::R9G9B9E5;
+        case VK_FORMAT_R16G16_SFLOAT:
+            return Fsr4Vk::RG16F;
+        case VK_FORMAT_R32_SFLOAT:
+        case VK_FORMAT_D32_SFLOAT:
+        case VK_FORMAT_D32_SFLOAT_S8_UINT:
+            return Fsr4Vk::R32F;
+        default:
+            return 0;
+        }
+    }
+
+    static Fsr4Vk::FfxApiResource Res(const Img& img, uint32_t w, uint32_t h, uint32_t state, uint32_t usage)
+    {
+        Fsr4Vk::FfxApiResource r {};
+        r.resource = (void*) img.image;
+        r.description.type = Fsr4Vk::kTexture2D;
+        r.description.format = FfxFormat(img.fmt);
+        r.description.width = w;
+        r.description.height = h;
+        r.description.depth = 1;
+        r.description.mipCount = 1;
+        r.description.usage = usage;
+        r.state = state;
+        return r;
+    }
+
+    // the provider samples its inputs as SHADER_READ_ONLY_OPTIMAL and writes the output as GENERAL; vkd3d-proton's
+    // layouts for the game's states go there and back around the dispatch
+    void Transition(VkCommandBuffer cb, const Img* in, int n, const Img& out, bool toProvider)
+    {
+        VkImageMemoryBarrier b[4] {};
+        uint32_t k = 0;
+        auto add = [&](const Img& img, VkImageLayout providerLayout)
+        {
+            if (img.layout == providerLayout)
+                return;
+            auto& x = b[k++];
+            x.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+            x.srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT;
+            x.dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+            x.oldLayout = toProvider ? img.layout : providerLayout;
+            x.newLayout = toProvider ? providerLayout : img.layout;
+            x.srcQueueFamilyIndex = x.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+            x.image = img.image;
+            x.subresourceRange = { img.aspect, 0, 1, 0, 1 };
+        };
+        for (int i = 0; i < n; i++)
+            add(in[i], VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+        add(out, VK_IMAGE_LAYOUT_GENERAL);
+        VkMemoryBarrier mb { VK_STRUCTURE_TYPE_MEMORY_BARRIER };
+        mb.srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT;
+        mb.dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+        vkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1, &mb, 0,
+                             nullptr, k, k ? b : nullptr);
+    }
+
+    bool MakeFlush(ID3D12Device* device)
+    {
+        D3D12_HEAP_PROPERTIES hp { D3D12_HEAP_TYPE_DEFAULT };
+        D3D12_RESOURCE_DESC rd {};
+        rd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+        rd.Width = 256;
+        rd.Height = 1;
+        rd.DepthOrArraySize = 1;
+        rd.MipLevels = 1;
+        rd.SampleDesc.Count = 1;
+        rd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+        for (auto*& b : _flush)
+            if (FAILED(device->CreateCommittedResource(&hp, D3D12_HEAP_FLAG_NONE, &rd, D3D12_RESOURCE_STATE_COMMON,
+                                                       nullptr, IID_PPV_ARGS(&b))))
+            {
+                LOG_ERROR("Vela FSR 4 VK: flush buffers failed");
+                return false;
+            }
+        return true;
+    }
+
+    ID3D12DXVKInteropDevice1* _interop = nullptr;
+    VkDevice _vk = VK_NULL_HANDLE;
+    VkPhysicalDevice _physical = VK_NULL_HANDLE;
+    HMODULE _dll = nullptr;
+    Fsr4Vk::PfnCreate _create = nullptr;
+    Fsr4Vk::PfnDestroy _destroy = nullptr;
+    Fsr4Vk::PfnDispatch _dispatch = nullptr;
+    Fsr4Vk::ffxContext _ctx = nullptr;
+    ID3D12Resource* _flush[2] = { nullptr, nullptr };
+    uint32_t _rw = 0, _rh = 0, _dw = 0, _dh = 0;
+    uint64_t _frames = 0;
+    int _failLogged = 0;
+    bool _ready = false;
+    bool _v402 = false;
+};
