 {
     LOG_TRACE(": {}", *count);
 
+    // Vela: with the INT8 model forced on a GPU that is not AMD (the Adreno), report RDNA3's 16x16x16
+    // integer WMMA combinations, so the FSR 4.1 SDK upscaler takes its INT8 model instead of falling back to FSR 3.1
+    // (it asks once with room for 14 entries); whether vkd3d-proton can run those WMMA ops is what this tests
+    if (fsr4Support == FSR4Support::INT8 && waveMatrixProperties != nullptr && *count >= 3)
+    {
+        const AmdExtWaveMatrixPropertiesType combos[][4] = {
+            { float16, float16, float32, float32 },
+            { sint8, sint8, sint32, sint32 },
+            { uint8, uint8, sint32, sint32 },
+            { sint8, uint8, sint32, sint32 },
+            { uint8, sint8, sint32, sint32 },
+        };
+        uint64_t n = 0;
+        for (const auto& c : combos)
+        {
+            if (n >= *count)
+                break;
+            auto& w = waveMatrixProperties[n++];
+            w.mSize = w.nSize = w.kSize = 16;
+            w.aType = c[0];
+            w.bType = c[1];
+            w.cType = c[2];
+            w.resultType = c[3];
+            w.saturatingAccumulation = false;
+        }
+        *count = n;
+        LOG_INFO("Vela: GetWaveMatrixProperties -> {} INT8/FP16 WMMA combinations (FSR 4 INT8 forced)", n);
+        return S_OK;
+    }
+
     waveMatrixProperties->mSize = 16;
     waveMatrixProperties->nSize = 16;
     waveMatrixProperties->kSize = 16;
