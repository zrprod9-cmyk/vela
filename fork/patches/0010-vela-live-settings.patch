@@ -0,0 +1,204 @@
+#pragma once
+// Vela live settings (Vela plugin 0.5.0): the Decky panel writes /tmp/vela-live/<appid>.ini (Z:\tmp\... in Wine) and
+// the running game picks it up without a restart. One "key=value" per line; a key that is absent keeps what the
+// launch options / OptiScaler.ini say:
+//   model=ai|p2b|sr|sgsr2|fsr4  Vela AI (the INT8 recipe when the device has it), Vela AI on the fp16 P2b recipe,
+//                          Vela SR, OptiScaler's SGSR 2, or FSR 4.1.1 VK INT8 (fsr4vk provider inside SGSR 3, Fsr4VkBridge.h;
+//                          Vela AI when it cannot run); a change re-creates the upscaler (NVNGX_DLSS_Dx12.cpp)
+//   ratio=<r>|game      render size = display / r through the DLSS optimal-settings answer; "game" = the game's own
+//   amax=<a>            Vela AI: the current sample's weight cap, 0 = none
+//   alphak=<k>          Vela AI: the nearest current sample damped by k (0.25..1)
+//   mk=<m>              Vela AI: the accumulation cap's motion term (1..64)
+//   fresh=<k>           Vela SR: softness only on young history (0 = sharp)
+//   sq=0|1 ncap=0|1 disocc=0|1   Vela SR switches (dark flicker / ghosting in motion / disocclusion)
+// The file is looked at every 15 frames (its write time and size); a change is logged once.
+// Included after pch.h (Config, State, LOG_*).
+#include <Config.h>
+
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <optional>
+#include <string>
+
+namespace VelaLive
+{
+enum class Model
+{
+    Unset,
+    Ai,
+    P2b,
+    Sr,
+    Sgsr2,
+    Fsr4
+};
+
+struct Values
+{
+    Model model = Model::Unset;
+    float ratio = -1.0f;  // > 0 fixed ratio, 0 = the game's, < 0 = not set
+    float amax = -1.0f;
+    float alphaK = -1.0f;
+    float mk = -1.0f;
+    float fresh = -1.0f;
+    int sq = -1, ncap = -1, disocc = -1;
+};
+
+inline const char* ModelName(Model m)
+{
+    return m == Model::Ai ? "ai" : m == Model::P2b ? "p2b" : m == Model::Sr ? "sr" : m == Model::Sgsr2 ? "sgsr2" : m == Model::Fsr4 ? "fsr4" : "-";
+}
+
+inline std::string Path()
+{
+    static const std::string path = []
+    {
+        std::string id;
+        for (const char* k : { "SteamAppId", "SteamGameId", "STEAM_COMPAT_APP_ID" })
+            if (const char* e = std::getenv(k); e != nullptr && e[0] >= '0' && e[0] <= '9')
+            {
+                id = e;
+                break;
+            }
+        return id.empty() ? std::string() : "Z:\\tmp\\vela-live\\" + id + ".ini";
+    }();
+    return path;
+}
+
+inline Values Parse(const std::string& text)
+{
+    Values v;
+    size_t pos = 0;
+    while (pos < text.size())
+    {
+        size_t end = text.find('\n', pos);
+        if (end == std::string::npos)
+            end = text.size();
+        std::string line = text.substr(pos, end - pos);
+        pos = end + 1;
+        while (!line.empty() && (line.back() == '\r' || line.back() == ' '))
+            line.pop_back();
+        const size_t eq = line.find('=');
+        if (eq == std::string::npos || line[0] == '#')
+            continue;
+        const std::string k = line.substr(0, eq), s = line.substr(eq + 1);
+        const float f = (float) atof(s.c_str());
+        if (k == "model")
+            v.model = s == "ai"      ? Model::Ai
+                      : s == "p2b"   ? Model::P2b
+                      : s == "sr"    ? Model::Sr
+                      : s == "sgsr2" ? Model::Sgsr2
+                      : s == "fsr4"  ? Model::Fsr4
+                                     : Model::Unset;
+        else if (k == "ratio")
+            v.ratio = s == "game" ? 0.0f : (f >= 1.0f && f <= 6.0f ? f : -1.0f);
+        else if (k == "amax")
+            v.amax = f <= 0.0f ? 0.0f : std::fmin(f, 1.0f);
+        else if (k == "alphak")
+            v.alphaK = std::fmax(0.25f, std::fmin(f, 1.0f));
+        else if (k == "mk")
+            v.mk = std::fmax(1.0f, std::fmin(f, 64.0f));
+        else if (k == "fresh")
+            v.fresh = std::fmax(0.0f, std::fmin(f, 2.0f));
+        else if (k == "sq")
+            v.sq = s == "1";
+        else if (k == "ncap")
+            v.ncap = s == "1";
+        else if (k == "disocc")
+            v.disocc = s == "1";
+    }
+    return v;
+}
+
+struct Store
+{
+    Values cur;
+    std::string text;
+    FILETIME time {};
+    DWORD size = 0xffffffffu;
+    uint32_t calls = 0;
+    bool read = false;
+    std::optional<bool> ratioOn;  // the ini's override, restored when the panel's ratio goes away
+    std::optional<float> ratioValue;
+};
+
+inline Store& St()
+{
+    static Store s;
+    return s;
+}
+
+// The ratio goes to OptiScaler's own override: the game sees it the next time it asks for the optimal render size.
+inline void ApplyRatio(const Values& v)
+{
+    auto* c = Config::Instance();
+    auto& s = St();
+    if (!s.ratioOn.has_value())
+    {
+        s.ratioOn = c->UpscaleRatioOverrideEnabled.value_or_default();
+        s.ratioValue = c->UpscaleRatioOverrideValue.value_or_default();
+    }
+    if (v.ratio < 0.0f)
+    {
+        c->UpscaleRatioOverrideEnabled = *s.ratioOn;
+        c->UpscaleRatioOverrideValue = *s.ratioValue;
+    }
+    else if (v.ratio == 0.0f)
+        c->UpscaleRatioOverrideEnabled = false;
+    else
+    {
+        c->QualityRatioOverrideEnabled = false;
+        c->UpscaleRatioOverrideEnabled = true;
+        c->UpscaleRatioOverrideValue = v.ratio;
+    }
+}
+
+// Reads the file when it changed (at most every 15 calls, or now with force); returns the current values.
+inline const Values& Poll(bool force = false)
+{
+    auto& s = St();
+    const std::string& p = Path();
+    if (p.empty() || (s.read && !force && (s.calls++ % 15) != 0))
+        return s.cur;
+    s.read = true;
+    std::string text;
+    WIN32_FILE_ATTRIBUTE_DATA fa {};
+    if (GetFileAttributesExA(p.c_str(), GetFileExInfoStandard, &fa))
+    {
+        if (CompareFileTime(&fa.ftLastWriteTime, &s.time) == 0 && fa.nFileSizeLow == s.size)
+            return s.cur;
+        s.time = fa.ftLastWriteTime;
+        s.size = fa.nFileSizeLow;
+        if (FILE* f = fopen(p.c_str(), "rb"))
+        {
+            char buf[1024];
+            size_t n;
+            while ((n = fread(buf, 1, sizeof(buf), f)) > 0 && text.size() < 8192)
+                text.append(buf, n);
+            fclose(f);
+        }
+    }
+    else
+        s.size = 0xffffffffu;
+    if (text == s.text)
+        return s.cur;
+    s.text = text;
+    s.cur = Parse(text);
+    ApplyRatio(s.cur);
+    LOG_INFO("Vela live ({0}): model {1} ratio {2} amax {3} alphak {4} mk {5} fresh {6} sq {7} ncap {8} disocc {9}",
+             text.empty() ? "no file, launch settings" : p, ModelName(s.cur.model), s.cur.ratio, s.cur.amax,
+             s.cur.alphaK, s.cur.mk, s.cur.fresh, s.cur.sq, s.cur.ncap, s.cur.disocc);
+    return s.cur;
+}
+
+// The render size the game draws now (its DLSS subrect), set by the evaluate that re-creates SGSR 3 for it and taken
+// by that SGSR 3's Init: OptiScaler re-creates a feature from its creation parameters, which keep the old size.
+inline unsigned int SubW = 0, SubH = 0;
+
+// While the FFX backend makes its context with FSR 4 INT8 forced on a GPU that is not AMD, the DXGI adapter reads as an
+// RDNA3 card (Dxgi_Spoofing.cpp): the FSR 4.1 SDK upscaler gives its INT8 model to AMD only and falls back to FSR 3.1
+inline bool AmdForFfx = false;
+
+// The values as last read (per-frame constants; the NVNGX evaluate path polls).
+inline const Values& Cur() { return St().cur; }
+} // namespace VelaLive
