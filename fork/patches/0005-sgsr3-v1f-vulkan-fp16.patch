+bool SGSR3FastVk::Init(ID3D12Device* device, uint32_t rw, uint32_t rh, uint32_t dw, uint32_t dh, int bitSet,
+                       Variant variant)
+{
+    _compact = variant != Variant::Rgba16;
+    _lock = variant == Variant::Lock;
+    const bool exactV1 = variant == Variant::ExactV1;
+    _device = device;
+    _rw = rw;
+    _rh = rh;
+    _dw = dw;
+    _dh = dh;
+    _compute = GetFileAttributesA("Z:\\tmp\\sgsr3_fcs") != INVALID_FILE_ATTRIBUTES;
+    bitSet = std::clamp(bitSet, 0, 2);
+
+    if (FAILED(device->QueryInterface(__uuidof(ID3D12DXVKInteropDevice1), (void**) &_interop)) || _interop == nullptr)
+    {
+        LOG_ERROR("SGSR3 v1f: no ID3D12DXVKInteropDevice1 (not vkd3d-proton, or too old)");
+        return false;
+    }
+    if (FAILED(_interop->GetVulkanHandles(&_instance, &_physical, &_vk)) || _vk == VK_NULL_HANDLE)
+        return false;
+    _beginRendering = (PFN_vkCmdBeginRendering) vkGetDeviceProcAddr(_vk, "vkCmdBeginRendering");
+    _endRendering = (PFN_vkCmdEndRendering) vkGetDeviceProcAddr(_vk, "vkCmdEndRendering");
+    if (_beginRendering == nullptr)
+    {
+        _beginRendering = (PFN_vkCmdBeginRendering) vkGetDeviceProcAddr(_vk, "vkCmdBeginRenderingKHR");
+        _endRendering = (PFN_vkCmdEndRendering) vkGetDeviceProcAddr(_vk, "vkCmdEndRenderingKHR");
+    }
+    if (_beginRendering == nullptr || _endRendering == nullptr)
+        return false;
+    VkPhysicalDeviceProperties props {};
+    vkGetPhysicalDeviceProperties(_physical, &props);
+    _tsPeriodNs = props.limits.timestampPeriod;
+
+    bool f16 = false, fragStores = false;
+    const VkPhysicalDeviceFeatures2* feats = nullptr;
+    if (SUCCEEDED(_interop->GetDeviceFeatures(&feats)) && feats != nullptr)
+    {
+        fragStores = feats->features.fragmentStoresAndAtomics != VK_FALSE;
+        for (auto* s = (const VkBaseInStructure*) feats->pNext; s != nullptr; s = s->pNext)
+        {
+            if (s->sType == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES)
+                f16 = ((const VkPhysicalDeviceVulkan12Features*) s)->shaderFloat16 != VK_FALSE;
+            if (s->sType == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SHADER_FLOAT16_INT8_FEATURES)
+                f16 = f16 || ((const VkPhysicalDeviceShaderFloat16Int8Features*) s)->shaderFloat16 != VK_FALSE;
+        }
+    }
+    if (!fragStores)
+        _compute = true;  // the fragment upscale writes the game's output by imageStore
+    if (_compute)
+        _compact = _lock = false;  // no compact compute build
+    static const char* setName[3] = { "v1a", "v1b", "v1c" };
+    _info = std::string("v1f ") + setName[bitSet] + (_compute ? " compute" : " fragment") +
+            (_compact ? ", compact (A2B10G10R10 + R16F)" : ", RGBA16F") +
+            (_compact && !exactV1 ? ", low-frequency lock" : ", v1 heuristics") + (_lock ? ", thin-feature locks" : "") +
+            ", shaderFloat16 " +
+            (f16 ? "on" : "OFF") + ", fragmentStoresAndAtomics " + (fragStores ? "on" : "OFF");
+    LOG_INFO("SGSR3 v1f: {0}", _info);
+    if (!f16)
+        return false;
+
+    VkDescriptorPoolSize ps[3] = { { VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER, 4 * Ring },
+                                   { VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 16 * Ring },
+                                   { VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, 4 * Ring } };
+    VkDescriptorPoolCreateInfo dpi { VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO };
+    dpi.maxSets = 4 * Ring;
+    dpi.poolSizeCount = 3;
+    dpi.pPoolSizes = ps;
+    if (vkCreateDescriptorPool(_vk, &dpi, nullptr, &_pool) != VK_SUCCESS)
+        return false;
+    VkSamplerCreateInfo si { VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO };
+    si.addressModeU = si.addressModeV = si.addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+    si.maxLod = 0.0f;
+    si.magFilter = si.minFilter = VK_FILTER_NEAREST;
+    si.mipmapMode = VK_SAMPLER_MIPMAP_MODE_NEAREST;
+    if (vkCreateSampler(_vk, &si, nullptr, &_point) != VK_SUCCESS)
+        return false;
+    si.magFilter = si.minFilter = VK_FILTER_LINEAR;
+    if (vkCreateSampler(_vk, &si, nullptr, &_linear) != VK_SUCCESS)
+        return false;
+    VkShaderModuleCreateInfo mi { VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO };
+    mi.codeSize = sizeof(v1f_spv_fullscreen_vert);
+    mi.pCode = v1f_spv_fullscreen_vert;
+    if (vkCreateShaderModule(_vk, &mi, nullptr, &_vs) != VK_SUCCESS)
+        return false;
+    VkQueryPoolCreateInfo qi { VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO };
+    qi.queryType = VK_QUERY_TYPE_TIMESTAMP;
+    qi.queryCount = TsPerFrame * Ring;
+    if (vkCreateQueryPool(_vk, &qi, nullptr, &_queries) != VK_SUCCESS)
+        _queries = VK_NULL_HANDLE;
+
+    _ubo = FastCreateBuf(device, 256 * Ring, D3D12_HEAP_TYPE_UPLOAD, D3D12_RESOURCE_STATE_GENERIC_READ);
+    _flush[0] = FastCreateBuf(device, 256, D3D12_HEAP_TYPE_DEFAULT, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    _flush[1] = FastCreateBuf(device, 256, D3D12_HEAP_TYPE_DEFAULT, D3D12_RESOURCE_STATE_COPY_DEST);
+    if (_ubo == nullptr || _flush[0] == nullptr || _flush[1] == nullptr)
+        return false;
+    D3D12_RANGE noRead { 0, 0 };
+    if (FAILED(_ubo->Map(0, &noRead, (void**) &_uboMapped)))
+        return false;
+    UINT64 handle = 0;
+    if (FAILED(_interop->GetVulkanResourceInfo1(_ubo, &handle, &_uboOffset, nullptr)) || handle == 0)
+        return false;
+    _uboBuffer = (VkBuffer) handle;
+
+    const VkImageUsageFlags RTU = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
+    const VkFormat F16 = VK_FORMAT_R16G16B16A16_SFLOAT;
+    const VkFormat F10 = VK_FORMAT_A2B10G10R10_UNORM_PACK32;
+    if (!MakeImage(_mdr, rw, rh, F16, RTU) || !MakeImage(_work, rw, rh, _compact ? F10 : F16, RTU))
+        return false;
+    for (int k = 0; k < 2; k++)
+    {
+        if (!MakeImage(_hist[k], dw, dh, _compact ? F10 : F16, _compute ? VK_IMAGE_USAGE_STORAGE_BIT : RTU))
+            return false;
+        if (_compact && !MakeImage(_histN[k], dw, dh, _lock ? VK_FORMAT_R16G16_SFLOAT : VK_FORMAT_R16_SFLOAT, RTU))
+            return false;
+    }
+
+    using B = std::pair<uint32_t, VkDescriptorType>;
+    const VkDescriptorType U = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER, S = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,
+                           I = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+    const VkFormat convRt[2] = { F16, _work.format };
+    if (!MakePass(_convert, _lock ? v1f_spv_convert_lock_frag : v1f_spv_convert_frag,
+                  _lock ? sizeof(v1f_spv_convert_lock_frag) : sizeof(v1f_spv_convert_frag),
+                  { B(0, U), B(1, S), B(2, S), B(3, S), B(4, S) }, true, convRt, 2))
+        return false;
+    const V1fSpv& up = _compute ? v1f_upscale_comp[bitSet]
+                       : _compact ? (exactV1 ? v1f_upscale_fragcv1[bitSet]
+                                     : _lock ? v1f_upscale_fragcl[bitSet]
+                                             : v1f_upscale_fragc[bitSet])
+                                  : v1f_upscale_frag[bitSet];
+    std::vector<B> ub = { B(0, U), B(1, S), B(2, S), B(3, S), B(4, S), B(5, S), B(8, I) };
+    if (_compute)
+        ub.push_back(B(7, I));
+    if (_compact)
+        ub.push_back(B(6, S));
+    const VkFormat upRt[2] = { _hist[0].format, _compact ? _histN[0].format : VK_FORMAT_R16_SFLOAT };
+    if (!MakePass(_upscale, up.spv, up.bytes, ub, !_compute, upRt, _compact ? 2 : 1))
+        return false;
+    _ready = true;
+    return true;
+}
+
+VkImageView SGSR3FastVk::GameView(ID3D12Resource* res, VkFormat& fmt, bool depth)
+{
+    UINT64 handle = 0, offset = 0;
+    fmt = VK_FORMAT_UNDEFINED;
+    if (res == nullptr || FAILED(_interop->GetVulkanResourceInfo1(res, &handle, &offset, &fmt)) || handle == 0)
+        return VK_NULL_HANDLE;
+    const auto key = std::make_tuple((uint64_t) handle, (int) fmt, depth ? 1 : 0);
+    auto it = _gameViews.find(key);
+    if (it != _gameViews.end())
+        return it->second;
+    VkImageViewCreateInfo vi { VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO };
+    vi.image = (VkImage) handle;
+    vi.viewType = VK_IMAGE_VIEW_TYPE_2D;
+    vi.format = fmt;
+    vi.subresourceRange = { depth ? (VkImageAspectFlags) VK_IMAGE_ASPECT_DEPTH_BIT
+                                  : (VkImageAspectFlags) VK_IMAGE_ASPECT_COLOR_BIT,
+                            0, 1, 0, 1 };
+    VkImageView v = VK_NULL_HANDLE;
+    if (vkCreateImageView(_vk, &vi, nullptr, &v) != VK_SUCCESS)
+        return VK_NULL_HANDLE;
+    _gameViews[key] = v;
+    return v;
+}
+
+bool SGSR3FastVk::Evaluate(ID3D12GraphicsCommandList* cl, const Input& color, const Input& depth, const Input& mv,
+                           const Input& reactive, const Input& tc, const Input& output, const void* constants,
+                           size_t bytes, bool reset, bool captureHistory)
+{
+    if (!_ready || bytes > 256)
+        return false;
+    const uint32_t slot = _frame % Ring;
+    const int k = _parity;
+
+    VkFormat fc, fd, fm, fo, fr, ft;
+    VkImageView vColor = GameView(color.res, fc, false);
+    VkImageView vDepth = depth.res ? GameView(depth.res, fd, true) : VK_NULL_HANDLE;
+    VkImageView vMv = GameView(mv.res, fm, false);
+    VkImageView vOut = GameView(output.res, fo, false);
+    VkImageView vReact = reactive.res ? GameView(reactive.res, fr, false) : VK_NULL_HANDLE;
+    VkImageView vTc = tc.res ? GameView(tc.res, ft, false) : VK_NULL_HANDLE;
+    if (vColor == VK_NULL_HANDLE || vMv == VK_NULL_HANDLE || vOut == VK_NULL_HANDLE)
+        return false;
+    VkImageLayout lColor, lDepth = VK_IMAGE_LAYOUT_GENERAL, lMv, lOut, lReact = VK_IMAGE_LAYOUT_GENERAL,
+                          lTc = VK_IMAGE_LAYOUT_GENERAL;
+    _interop->GetVulkanImageLayout(color.res, color.state, &lColor);
+    if (depth.res)
+        _interop->GetVulkanImageLayout(depth.res, depth.state, &lDepth);
+    _interop->GetVulkanImageLayout(mv.res, mv.state, &lMv);
+    _interop->GetVulkanImageLayout(output.res, output.state, &lOut);
+    if (reactive.res)
+        _interop->GetVulkanImageLayout(reactive.res, reactive.state, &lReact);
+    if (tc.res)
+        _interop->GetVulkanImageLayout(tc.res, tc.state, &lTc);
+    // absent inputs: an image of ours stands in (the flags keep the shaders from reading it)
+    const VkImageLayout OWN = VK_IMAGE_LAYOUT_GENERAL;
+    if (vDepth == VK_NULL_HANDLE)
+    {
+        vDepth = _hist[k].view;
+        lDepth = OWN;
+    }
+    if (vReact == VK_NULL_HANDLE)
+    {
+        vReact = _hist[k].view;
+        lReact = OWN;
+    }
+    if (vTc == VK_NULL_HANDLE)
+    {
+        vTc = _hist[k].view;
+        lTc = OWN;
+    }
+    if (_frame == 0)
+        LOG_INFO("SGSR3 v1f: layouts colour {0} depth {1} mv {2} output {3}; formats colour {4} depth {5} mv {6} "
+                 "output {7}", (int) lColor, (int) lDepth, (int) lMv, (int) lOut, (int) fc, (int) fd, (int) fm,
+                 (int) fo);
+
+    memcpy(_uboMapped + slot * 256, constants, bytes);
+    if (!_imagesInitialised || reset)
+    {
+        // reset (the D3D12 constants' field at byte 80): no history this frame
+        const float one = 1.0f;
+        memcpy(_uboMapped + slot * 256 + 80, &one, 4);
+    }
+    const VkDescriptorBufferInfo ubi { _uboBuffer, _uboOffset + slot * 256, 256 };
+
+    std::vector<VkWriteDescriptorSet> wr;
+    std::vector<VkDescriptorImageInfo> ii;
+    ii.reserve(32);
+    auto put = [&](VkDescriptorSet set, uint32_t binding, VkDescriptorType type, VkImageView v, VkImageLayout l,
+                   VkSampler s)
+    {
+        ii.push_back({ s, v, l });
+        VkWriteDescriptorSet w { VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET };
+        w.dstSet = set;
+        w.dstBinding = binding;
+        w.descriptorCount = 1;
+        w.descriptorType = type;
+        w.pImageInfo = &ii.back();
+        wr.push_back(w);
+    };
+    auto putUbo = [&](VkDescriptorSet set)
+    {
+        VkWriteDescriptorSet w { VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET };
+        w.dstSet = set;
+        w.dstBinding = 0;
+        w.descriptorCount = 1;
+        w.descriptorType = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER;
+        w.pBufferInfo = &ubi;
+        wr.push_back(w);
+    };
+    const VkDescriptorType S = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, I = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+    VkDescriptorSet cs = _convert.set[slot], us = _upscale.set[slot];
+    putUbo(cs);
+    put(cs, 1, S, vDepth, lDepth, _point);
+    put(cs, 2, S, vMv, lMv, _point);
+    put(cs, 3, S, vReact, lReact, _point);
+    put(cs, 4, S, vColor, lColor, _point);
+    putUbo(us);
+    put(us, 1, S, _work.view, OWN, _point);
+    put(us, 2, S, _mdr.view, OWN, _linear);
+    put(us, 3, S, _hist[k].view, OWN, _linear);
+    put(us, 4, S, vTc, lTc, _linear);
+    put(us, 5, S, _work.view, OWN, _linear);
+    put(us, 8, I, vOut, lOut, VK_NULL_HANDLE);
+    if (_compact)
+        put(us, 6, S, _histN[k].view, OWN, _linear);
+    if (_compute)
+        put(us, 7, I, _hist[1 - k].view, OWN, VK_NULL_HANDLE);
+    vkUpdateDescriptorSets(_vk, (uint32_t) wr.size(), wr.data(), 0, nullptr);
+
+    // vkd3d-proton batches D3D12 barriers until the next command; a 4-byte copy flushes them
+    cl->CopyBufferRegion(_flush[1], 0, _flush[0], 0, 4);
+    VkCommandBuffer cb = VK_NULL_HANDLE;
+    if (FAILED(_interop->BeginVkCommandBufferInterop(cl, &cb)) || cb == VK_NULL_HANDLE)
+    {
+        LOG_ERROR("SGSR3 v1f: BeginVkCommandBufferInterop failed");
+        return false;
+    }
+    VkMemoryBarrier mb { VK_STRUCTURE_TYPE_MEMORY_BARRIER };
+    mb.srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT;
+    mb.dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+    vkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1, &mb, 0,
+                         nullptr, 0, nullptr);
+    if (!_imagesInitialised)
+    {
+        std::vector<VkImageMemoryBarrier> ib;
+        for (Img* im : { &_mdr, &_work, &_hist[0], &_hist[1], &_histN[0], &_histN[1] })
+        {
+            if (im->image == VK_NULL_HANDLE)
+                continue;
+            VkImageMemoryBarrier b { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER };
+            b.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+            b.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+            b.newLayout = VK_IMAGE_LAYOUT_GENERAL;
+            b.srcQueueFamilyIndex = b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+            b.image = im->image;
+            b.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+            ib.push_back(b);
+        }
+        vkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 0, nullptr,
+                             0, nullptr, (uint32_t) ib.size(), ib.data());
+        _imagesInitialised = true;
+    }
+    const uint32_t q0 = slot * TsPerFrame;
+    if (_queries != VK_NULL_HANDLE)
+    {
+        vkCmdResetQueryPool(cb, _queries, q0, TsPerFrame);
+        vkCmdWriteTimestamp(cb, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, _queries, q0);
+    }
+
+    auto draw = [&](Pass& p, Img* const* rts, uint32_t nRt, uint32_t w, uint32_t h)
+    {
+        VkRenderingAttachmentInfo att[2] = { { VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO },
+                                             { VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO } };
+        for (uint32_t i = 0; i < nRt; i++)
+        {
+            att[i].imageView = rts[i]->view;
+            att[i].imageLayout = VK_IMAGE_LAYOUT_GENERAL;
+            att[i].loadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+            att[i].storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+        }
+        VkRenderingInfo ri { VK_STRUCTURE_TYPE_RENDERING_INFO };
+        ri.renderArea = { { 0, 0 }, { w, h } };
+        ri.layerCount = 1;
+        ri.colorAttachmentCount = nRt;
+        ri.pColorAttachments = att;
+        _beginRendering(cb, &ri);
+        VkViewport v { 0, 0, (float) w, (float) h, 0, 1 };
+        VkRect2D sc { { 0, 0 }, { w, h } };
+        vkCmdSetViewport(cb, 0, 1, &v);
+        vkCmdSetScissor(cb, 0, 1, &sc);
+        vkCmdBindPipeline(cb, VK_PIPELINE_BIND_POINT_GRAPHICS, p.pipe);
+        vkCmdBindDescriptorSets(cb, VK_PIPELINE_BIND_POINT_GRAPHICS, p.pl, 0, 1, &p.set[slot], 0, nullptr);
+        vkCmdDraw(cb, 3, 1, 0, 0);
+        _endRendering(cb);
+    };
+
+    Img* convRts[2] = { &_mdr, &_work };
+    draw(_convert, convRts, 2, _rw, _rh);
+    VkMemoryBarrier rb { VK_STRUCTURE_TYPE_MEMORY_BARRIER };
+    rb.srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+    rb.dstAccessMask = VK_ACCESS_SHADER_READ_BIT;
+    vkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+                         VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 1, &rb, 0,
+                         nullptr, 0, nullptr);
+    if (_queries != VK_NULL_HANDLE)
+        vkCmdWriteTimestamp(cb, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, _queries, q0 + 1);
+    if (_compute)
+    {
+        vkCmdBindPipeline(cb, VK_PIPELINE_BIND_POINT_COMPUTE, _upscale.pipe);
+        vkCmdBindDescriptorSets(cb, VK_PIPELINE_BIND_POINT_COMPUTE, _upscale.pl, 0, 1, &_upscale.set[slot], 0, nullptr);
+        vkCmdDispatch(cb, (_dw + V1fWgX - 1) / V1fWgX, (_dh + V1fWgY - 1) / V1fWgY, 1);
+    }
+    else
+    {
+        Img* upRts[2] = { &_hist[1 - k], &_histN[1 - k] };
+        draw(_upscale, upRts, _compact ? 2 : 1, _dw, _dh);
+    }
+    if (_queries != VK_NULL_HANDLE)
+        vkCmdWriteTimestamp(cb, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, _queries, q0 + 2);
+    vkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1, &mb, 0,
+                         nullptr, 0, nullptr);
+
+    if (captureHistory)
+    {
+        auto mirror = [&](ID3D12Resource*& res, VkImage& img, VkImageLayout& layout, DXGI_FORMAT fmt, VkImage src)
+        {
+            if (res == nullptr)
+            {
+                D3D12_HEAP_PROPERTIES heap {};
+                heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+                D3D12_RESOURCE_DESC d {};
+                d.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+                d.Width = _dw;
+                d.Height = _dh;
+                d.DepthOrArraySize = 1;
+                d.MipLevels = 1;
+                d.Format = fmt;
+                d.SampleDesc.Count = 1;
+                d.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+                if (SUCCEEDED(_device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &d,
+                                                               D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nullptr,
+                                                               IID_PPV_ARGS(&res))))
+                {
+                    UINT64 h = 0, off = 0;
+                    _interop->GetVulkanResourceInfo1(res, &h, &off, nullptr);
+                    _interop->GetVulkanImageLayout(res, D3D12_RESOURCE_STATE_UNORDERED_ACCESS, &layout);
+                    img = (VkImage) h;
+                }
+            }
+            if (img == VK_NULL_HANDLE)
+                return;
+            VkImageCopy r {};
+            r.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+            r.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+            r.extent = { _dw, _dh, 1 };
+            vkCmdCopyImage(cb, src, VK_IMAGE_LAYOUT_GENERAL, img, layout, 1, &r);
+        };
+        mirror(_mirror, _mirrorImage, _mirrorLayout,
+               _compact ? DXGI_FORMAT_R10G10B10A2_UNORM : DXGI_FORMAT_R16G16B16A16_FLOAT, _hist[1 - k].image);
+        if (_compact)
+            mirror(_mirrorN, _mirrorNImage, _mirrorNLayout, _lock ? DXGI_FORMAT_R16G16_FLOAT : DXGI_FORMAT_R16_FLOAT,
+                   _histN[1 - k].image);
+        vkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1, &mb, 0,
+                             nullptr, 0, nullptr);
+    }
+    _interop->EndVkCommandBufferInterop(cl);
+    _parity ^= 1;
+    _frame++;
+    return true;
+}
+
+bool SGSR3FastVk::LastTiming(double out[2])
+{
+    if (_queries == VK_NULL_HANDLE || _frame < Ring)
+        return false;
+    const uint32_t slot = (_frame + 1) % Ring;
+    uint64_t ts[TsPerFrame] {};
+    if (vkGetQueryPoolResults(_vk, _queries, slot * TsPerFrame, TsPerFrame, sizeof(ts), ts, sizeof(uint64_t),
+                              VK_QUERY_RESULT_64_BIT) != VK_SUCCESS)
+        return false;
+    for (int i = 0; i < 2; i++)
+        out[i] = ts[i + 1] >= ts[i] ? (double) (ts[i + 1] - ts[i]) * _tsPeriodNs * 1e-6 : 0.0;
+    return true;
+}
+
+void SGSR3FastVk::Release()
+{
+    if (_vk != VK_NULL_HANDLE)
+    {
+        for (Pass* p : { &_convert, &_upscale })
+        {
+            if (p->pipe)
+                vkDestroyPipeline(_vk, p->pipe, nullptr);
+            if (p->pl)
+                vkDestroyPipelineLayout(_vk, p->pl, nullptr);
+            if (p->dsl)
+                vkDestroyDescriptorSetLayout(_vk, p->dsl, nullptr);
+            *p = Pass {};
+        }
+        for (Img* i : { &_mdr, &_work, &_hist[0], &_hist[1], &_histN[0], &_histN[1] })
+        {
+            if (i->view)
+                vkDestroyImageView(_vk, i->view, nullptr);
+            if (i->image)
+                vkDestroyImage(_vk, i->image, nullptr);
+            if (i->mem)
+                vkFreeMemory(_vk, i->mem, nullptr);
+            *i = Img {};
+        }
+        for (auto& v : _gameViews)
+            vkDestroyImageView(_vk, v.second, nullptr);
+        _gameViews.clear();
+        if (_pool)
+            vkDestroyDescriptorPool(_vk, _pool, nullptr);
+        if (_point)
+            vkDestroySampler(_vk, _point, nullptr);
+        if (_linear)
+            vkDestroySampler(_vk, _linear, nullptr);
+        if (_vs)
+            vkDestroyShaderModule(_vk, _vs, nullptr);
+        if (_queries)
+            vkDestroyQueryPool(_vk, _queries, nullptr);
+        _pool = VK_NULL_HANDLE;
+        _point = _linear = VK_NULL_HANDLE;
+        _vs = VK_NULL_HANDLE;
+        _queries = VK_NULL_HANDLE;
+    }
+    if (_mirror)
+        _mirror->Release();
+    _mirror = nullptr;
+    _mirrorImage = VK_NULL_HANDLE;
+    if (_mirrorN)
+        _mirrorN->Release();
+    _mirrorN = nullptr;
+    _mirrorNImage = VK_NULL_HANDLE;
+    if (_ubo)
+        _ubo->Release();
+    _ubo = nullptr;
+    for (auto*& f : _flush)
+        if (f)
+        {
+            f->Release();
+            f = nullptr;
+        }
+    if (_interop)
+        _interop->Release();
+    _interop = nullptr;
+    _imagesInitialised = false;
+    _ready = false;
+    _frame = 0;
+    _parity = 0;
+}
diff --git a/OptiScaler/upscalers/sgsr3/SGSR3Fast_Vk.h b/OptiScaler/upscalers/sgsr3/SGSR3Fast_Vk.h
new file mode 100644
index 0000000..c3f9d2a
--- /dev/null
+++ b/OptiScaler/upscalers/sgsr3/SGSR3Fast_Vk.h
@@ -0,0 +1,138 @@
+#pragma once
+
+#include "SGSR3Student_Vk.h"  // ID3D12DXVKInteropDevice1
+
+#include <d3d12.h>
+#include <vulkan/vulkan.h>
+
+#include <cstdint>
+#include <map>
+#include <string>
+#include <tuple>
+#include <utility>
+#include <vector>
+
+//============================================================================================================
+// SGSR 3 v1f ("fast v1") inside the D3D12 game, on Vulkan through vkd3d-proton's interop, as the student is
+// (SGSR3Student_Vk.h): fp16 arithmetic is impossible through D3D12 on Turnip (no fp16 denorm preserve), but the
+// VkDevice behind vkd3d-proton has shaderFloat16.
+//
+// v1f is v1 (the same heuristics, constants and order) reformulated to be cheaper -- the Vela sources
+//: the convert pass also writes the colour in the upscale's working
+// space (tone-mapped YCoCg), the upscale reads its five taps by offsets, takes the fallback from one bilinear tap of
+// it and N from the centre history tap, Lanczos-3 weights are polynomials, and colour / kernel / box are fp16.
+//
+//   convert (fragment, render res): depth + MV + reactive + colour -> MDR (RGBA16F) + working colour (RGBA16F)
+//   upscale (display res): fragment, history as a render target and the image by imageStore into the game's output
+//                          (default), or compute with /tmp/sgsr3_fcs (both by imageStore)
+//
+// The UBO is the D3D12 path's SGSR3Constants as is (the GLSL is built with SGSR3_FORK_PARAMS). Own images are plain
+// Vulkan images (UBWC); the game's are taken through GetVulkanResourceInfo1, in the layouts vkd3d reports.
+// Shaders: SGSR3_V1f_spv.h (tools/gen_v1f_spv.py), one upscale per bit set v1a / v1b / v1c.
+//============================================================================================================
+
+class SGSR3FastVk
+{
+  public:
+    struct Input
+    {
+        ID3D12Resource* res = nullptr;
+        D3D12_RESOURCE_STATES state = D3D12_RESOURCE_STATE_COMMON;
+    };
+
+    // bitSet: 0 = v1a (whole package), 1 = v1b (no wide box), 2 = v1c (no wide box, Catmull-Rom history)
+    // compact: history colour A2B10G10R10 + N in R16F, working colour A2B10G10R10 (6 + 4 bytes instead of 8 + 8;
+    // the upscale is bound by memory traffic in the game); otherwise RGBA16F for both, N in the history alpha
+    // compact variants (history colour A2B10G10R10 + N target, working colour A2B10G10R10):
+    //   Lf      the low-frequency lock and soft N rejection of report 21 instead of the wide box
+    //   Lock    Lf + the thin-feature locks of report 20 (N target RG16F: N, lock state)
+    //   ExactV1 v1's heuristics as they are
+    // Rgba16: RGBA16F history (N in alpha) and working colour, v1's heuristics
+    enum class Variant { Rgba16, Lf, Lock, ExactV1 };
+    bool Init(ID3D12Device* device, uint32_t rw, uint32_t rh, uint32_t dw, uint32_t dh, int bitSet, Variant v);
+    // constants: the 144-byte SGSR3Constants of this frame (reset and flags as the D3D12 path has them)
+    bool Evaluate(ID3D12GraphicsCommandList* cl, const Input& color, const Input& depth, const Input& mv,
+                  const Input& reactive, const Input& tc, const Input& output, const void* constants, size_t bytes,
+                  bool reset, bool captureHistory = false);
+    void Release();
+
+    // GPU time of the last readable frame, ms: [0] convert, [1] upscale
+    bool LastTiming(double out[2]);
+    // the history written by the last Evaluate with captureHistory (D3D12 resources in UNORDERED_ACCESS): RGBA16F,
+    // or with compact the colour (R10G10B10A2) and N (R16F, WrittenN)
+    ID3D12Resource* WrittenHistory() const { return _mirror; }
+    ID3D12Resource* WrittenN() const { return _mirrorN; }
+    bool Compact() const { return _compact; }
+    bool Ready() const { return _ready; }
+    bool SizesMatch(uint32_t rw, uint32_t rh, uint32_t dw, uint32_t dh) const
+    {
+        return rw == _rw && rh == _rh && dw == _dw && dh == _dh;
+    }
+    bool Compute() const { return _compute; }
+    const std::string& Info() const { return _info; }
+
+  private:
+    static constexpr uint32_t Ring = 8;
+    static constexpr uint32_t TsPerFrame = 3;
+
+    struct Img
+    {
+        VkDeviceMemory mem = VK_NULL_HANDLE;
+        VkImage image = VK_NULL_HANDLE;
+        VkImageView view = VK_NULL_HANDLE;
+        VkFormat format = VK_FORMAT_UNDEFINED;
+        uint32_t w = 0, h = 0;
+    };
+    struct Pass
+    {
+        VkDescriptorSetLayout dsl = VK_NULL_HANDLE;
+        VkPipelineLayout pl = VK_NULL_HANDLE;
+        VkPipeline pipe = VK_NULL_HANDLE;
+        VkDescriptorSet set[Ring] = {};
+    };
+
+    ID3D12Device* _device = nullptr;
+    ID3D12DXVKInteropDevice1* _interop = nullptr;
+    VkInstance _instance = VK_NULL_HANDLE;
+    VkPhysicalDevice _physical = VK_NULL_HANDLE;
+    VkDevice _vk = VK_NULL_HANDLE;
+    PFN_vkCmdBeginRendering _beginRendering = nullptr;
+    PFN_vkCmdEndRendering _endRendering = nullptr;
+    double _tsPeriodNs = 1.0;
+
+    uint32_t _rw = 0, _rh = 0, _dw = 0, _dh = 0;
+    bool _compute = false;
+    bool _compact = false;
+    bool _lock = false;
+    bool _ready = false;
+    bool _imagesInitialised = false;
+    std::string _info;
+
+    Img _mdr, _work, _hist[2], _histN[2];
+    ID3D12Resource* _mirror = nullptr;
+    VkImage _mirrorImage = VK_NULL_HANDLE;
+    VkImageLayout _mirrorLayout = VK_IMAGE_LAYOUT_GENERAL;
+    ID3D12Resource* _mirrorN = nullptr;
+    VkImage _mirrorNImage = VK_NULL_HANDLE;
+    VkImageLayout _mirrorNLayout = VK_IMAGE_LAYOUT_GENERAL;
+    ID3D12Resource* _ubo = nullptr;
+    uint8_t* _uboMapped = nullptr;
+    VkBuffer _uboBuffer = VK_NULL_HANDLE;
+    uint64_t _uboOffset = 0;
+    ID3D12Resource* _flush[2] = {};
+
+    VkSampler _point = VK_NULL_HANDLE, _linear = VK_NULL_HANDLE;
+    VkDescriptorPool _pool = VK_NULL_HANDLE;
+    VkShaderModule _vs = VK_NULL_HANDLE;
+    Pass _convert, _upscale;
+    VkQueryPool _queries = VK_NULL_HANDLE;
+    std::map<std::tuple<uint64_t, int, int>, VkImageView> _gameViews;
+    uint32_t _frame = 0;
+    int _parity = 0;  // _hist[_parity] = previous history
+
+    bool MakeImage(Img& img, uint32_t w, uint32_t h, VkFormat fmt, VkImageUsageFlags usage);
+    bool MakePass(Pass& p, const uint32_t* spv, size_t bytes,
+                  const std::vector<std::pair<uint32_t, VkDescriptorType>>& bindings,
+                  bool fragment, const VkFormat* rtFormats, uint32_t nRt);
+    VkImageView GameView(ID3D12Resource* res, VkFormat& fmt, bool depth);
+};
