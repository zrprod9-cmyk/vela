+static bool FgFlag(const char* name) { return GetFileAttributesA(name) != INVALID_FILE_ATTRIBUTES; }
+
+bool SGSRFGVk::MakeImage(Img& img, uint32_t w, uint32_t h, VkFormat fmt, VkImageUsageFlags usage)
+{
+    img.format = fmt;
+    img.w = w;
+    img.h = h;
+    VkImageCreateInfo ci { VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO };
+    ci.imageType = VK_IMAGE_TYPE_2D;
+    ci.format = fmt;
+    ci.extent = { w, h, 1 };
+    ci.mipLevels = 1;
+    ci.arrayLayers = 1;
+    ci.samples = VK_SAMPLE_COUNT_1_BIT;
+    ci.tiling = VK_IMAGE_TILING_OPTIMAL;
+    ci.usage = usage | VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    ci.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    if (vkCreateImage(_vk, &ci, nullptr, &img.image) != VK_SUCCESS)
+    {
+        LOG_ERROR("SGSR-FG: vkCreateImage {0}x{1} fmt {2} failed", w, h, (int) fmt);
+        return false;
+    }
+    VkMemoryRequirements req;
+    vkGetImageMemoryRequirements(_vk, img.image, &req);
+    VkPhysicalDeviceMemoryProperties mp;
+    vkGetPhysicalDeviceMemoryProperties(_physical, &mp);
+    uint32_t type = UINT32_MAX;
+    for (uint32_t i = 0; i < mp.memoryTypeCount && type == UINT32_MAX; i++)
+        if ((req.memoryTypeBits & (1u << i)) && (mp.memoryTypes[i].propertyFlags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT))
+            type = i;
+    VkMemoryAllocateInfo ai { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+    ai.allocationSize = req.size;
+    ai.memoryTypeIndex = type;
+    if (type == UINT32_MAX || vkAllocateMemory(_vk, &ai, nullptr, &img.mem) != VK_SUCCESS ||
+        vkBindImageMemory(_vk, img.image, img.mem, 0) != VK_SUCCESS)
+    {
+        LOG_ERROR("SGSR-FG: image memory ({0} bytes) failed", req.size);
+        return false;
+    }
+    VkImageViewCreateInfo vi { VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO };
+    vi.image = img.image;
+    vi.viewType = VK_IMAGE_VIEW_TYPE_2D;
+    vi.format = fmt;
+    vi.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+    if (vkCreateImageView(_vk, &vi, nullptr, &img.view) != VK_SUCCESS)
+        return false;
+    _fresh.push_back(img.image);
+    return true;
+}
+
+void SGSRFGVk::FreeImage(Img& i)
+{
+    if (_vk == VK_NULL_HANDLE)
+        return;
+    if (i.view)
+        vkDestroyImageView(_vk, i.view, nullptr);
+    if (i.image)
+        vkDestroyImage(_vk, i.image, nullptr);
+    if (i.mem)
+        vkFreeMemory(_vk, i.mem, nullptr);
+    i = Img {};
+}
+
+bool SGSRFGVk::MakePass(Pass& p, const uint32_t* spv, size_t bytes,
+                        const std::vector<std::pair<uint32_t, VkDescriptorType>>& bindings, bool fragment, VkFormat rt,
+                        uint32_t setsPerSlot)
+{
+    const VkShaderStageFlags stage = fragment ? VK_SHADER_STAGE_FRAGMENT_BIT : VK_SHADER_STAGE_COMPUTE_BIT;
+    std::vector<VkDescriptorSetLayoutBinding> lb;
+    for (const auto& b : bindings)
+        lb.push_back({ b.first, b.second, 1, stage, nullptr });
+    VkDescriptorSetLayoutCreateInfo dci { VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO };
+    dci.bindingCount = (uint32_t) lb.size();
+    dci.pBindings = lb.data();
+    if (vkCreateDescriptorSetLayout(_vk, &dci, nullptr, &p.dsl) != VK_SUCCESS)
+        return false;
+    VkPushConstantRange pr { PushStages, 0, sizeof(SGSRFGPush) };
+    VkPipelineLayoutCreateInfo li { VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO };
+    li.setLayoutCount = 1;
+    li.pSetLayouts = &p.dsl;
+    li.pushConstantRangeCount = 1;
+    li.pPushConstantRanges = &pr;
+    if (vkCreatePipelineLayout(_vk, &li, nullptr, &p.pl) != VK_SUCCESS)
+        return false;
+    VkShaderModuleCreateInfo mi { VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO };
+    mi.codeSize = bytes;
+    mi.pCode = spv;
+    VkShaderModule mod = VK_NULL_HANDLE;
+    if (vkCreateShaderModule(_vk, &mi, nullptr, &mod) != VK_SUCCESS)
+        return false;
+    VkResult vr;
+    if (!fragment)
+    {
+        VkComputePipelineCreateInfo ci { VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO };
+        ci.stage = { VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO };
+        ci.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT;
+        ci.stage.module = mod;
+        ci.stage.pName = "main";
+        ci.layout = p.pl;
+        vr = vkCreateComputePipelines(_vk, VK_NULL_HANDLE, 1, &ci, nullptr, &p.pipe);
+    }
+    else
+    {
+        VkPipelineShaderStageCreateInfo st[2] = { { VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO },
+                                                  { VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO } };
+        st[0].stage = VK_SHADER_STAGE_VERTEX_BIT;
+        st[0].module = _vs;
+        st[0].pName = "main";
+        st[1].stage = VK_SHADER_STAGE_FRAGMENT_BIT;
+        st[1].module = mod;
+        st[1].pName = "main";
+        VkPipelineVertexInputStateCreateInfo vin { VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO };
+        VkPipelineInputAssemblyStateCreateInfo ia { VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO };
+        ia.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+        VkPipelineViewportStateCreateInfo vp { VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO };
+        vp.viewportCount = vp.scissorCount = 1;
+        VkPipelineRasterizationStateCreateInfo rs { VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO };
+        rs.polygonMode = VK_POLYGON_MODE_FILL;
+        rs.cullMode = VK_CULL_MODE_NONE;
+        rs.lineWidth = 1.0f;
+        VkPipelineMultisampleStateCreateInfo ms { VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO };
+        ms.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+        VkPipelineColorBlendAttachmentState cba {};
+        cba.colorWriteMask = 0xF;
+        VkPipelineColorBlendStateCreateInfo cb { VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO };
+        cb.attachmentCount = 1;
+        cb.pAttachments = &cba;
+        VkDynamicState dyn[2] = { VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR };
+        VkPipelineDynamicStateCreateInfo ds { VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO };
+        ds.dynamicStateCount = 2;
+        ds.pDynamicStates = dyn;
+        VkPipelineRenderingCreateInfo ri { VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO };
+        ri.colorAttachmentCount = 1;
+        ri.pColorAttachmentFormats = &rt;
+        VkGraphicsPipelineCreateInfo gci { VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO };
+        gci.pNext = &ri;
+        gci.stageCount = 2;
+        gci.pStages = st;
+        gci.pVertexInputState = &vin;
+        gci.pInputAssemblyState = &ia;
+        gci.pViewportState = &vp;
+        gci.pRasterizationState = &rs;
+        gci.pMultisampleState = &ms;
+        gci.pColorBlendState = &cb;
+        gci.pDynamicState = &ds;
+        gci.layout = p.pl;
+        vr = vkCreateGraphicsPipelines(_vk, VK_NULL_HANDLE, 1, &gci, nullptr, &p.pipe);
+    }
+    vkDestroyShaderModule(_vk, mod, nullptr);
+    if (vr != VK_SUCCESS)
+    {
+        LOG_ERROR("SGSR-FG: pipeline creation failed: {0}", (int) vr);
+        return false;
+    }
+    p.set.resize(Ring * setsPerSlot);
+    for (auto& s : p.set)
+    {
+        VkDescriptorSetAllocateInfo ai { VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO };
+        ai.descriptorPool = _pool;
+        ai.descriptorSetCount = 1;
+        ai.pSetLayouts = &p.dsl;
+        if (vkAllocateDescriptorSets(_vk, &ai, &s) != VK_SUCCESS)
+            return false;
+    }
+    return true;
+}
+
+bool SGSRFGVk::Init(ID3D12Device* device, uint32_t displayW, uint32_t displayH)
+{
+    _device = device;
+    _dw = displayW;
+    _dh = displayH;
+    // field: half render size with the atomic splat of one tap by default (A740: 1.0 ms per generated
+    // frame at 720p -> 1080p); /tmp/sgsrfg_full: full size, 4 taps (FI-like, 2.5 ms); /tmp/sgsrfg_gather: gather
+    _gather = FgFlag("Z:\\tmp\\sgsrfg_gather");
+    const bool full = FgFlag("Z:\\tmp\\sgsrfg_full");
+    _flags = FG_DILATE | (full ? FG_SPLAT4 : FG_HALF);
+
+    if (FAILED(device->QueryInterface(__uuidof(ID3D12DXVKInteropDevice1), (void**) &_interop)) || _interop == nullptr)
+    {
+        LOG_ERROR("SGSR-FG: no ID3D12DXVKInteropDevice1 (not vkd3d-proton, or too old)");
+        return false;
+    }
+    if (FAILED(_interop->GetVulkanHandles(&_instance, &_physical, &_vk)) || _vk == VK_NULL_HANDLE)
+        return false;
+    _beginRendering = (PFN_vkCmdBeginRendering) vkGetDeviceProcAddr(_vk, "vkCmdBeginRendering");
+    _endRendering = (PFN_vkCmdEndRendering) vkGetDeviceProcAddr(_vk, "vkCmdEndRendering");
+    if (_beginRendering == nullptr)
+    {
+        _beginRendering = (PFN_vkCmdBeginRendering) vkGetDeviceProcAddr(_vk, "vkCmdBeginRenderingKHR");
+        _endRendering = (PFN_vkCmdEndRendering) vkGetDeviceProcAddr(_vk, "vkCmdEndRenderingKHR");
+    }
+    if (_beginRendering == nullptr || _endRendering == nullptr)
+        return false;
+    VkPhysicalDeviceProperties props {};
+    vkGetPhysicalDeviceProperties(_physical, &props);
+    _tsPeriodNs = props.limits.timestampPeriod;
+
+    bool f16 = false;
+    const VkPhysicalDeviceFeatures2* feats = nullptr;
+    if (SUCCEEDED(_interop->GetDeviceFeatures(&feats)) && feats != nullptr)
+        for (auto* s = (const VkBaseInStructure*) feats->pNext; s != nullptr; s = s->pNext)
+        {
+            if (s->sType == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES)
+                f16 = ((const VkPhysicalDeviceVulkan12Features*) s)->shaderFloat16 != VK_FALSE;
+            if (s->sType == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SHADER_FLOAT16_INT8_FEATURES)
+                f16 = f16 || ((const VkPhysicalDeviceShaderFloat16Int8Features*) s)->shaderFloat16 != VK_FALSE;
+        }
+    _info = std::string("SGSR-FG ") + (_gather ? "gather" : "splat") + (full ? ", full field, 4 taps" : ", half field, 1 tap") +
+            ", shaderFloat16 " + (f16 ? "on" : "OFF");
+    LOG_INFO("{0}", _info);
+    if (!f16)
+        return false;
+
+    VkDescriptorPoolSize ps[3] = { { VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER, 16 * Ring },
+                                   { VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 64 * Ring },
+                                   { VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, 16 * Ring } };
+    VkDescriptorPoolCreateInfo dpi { VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO };
+    dpi.maxSets = 16 * Ring;
+    dpi.poolSizeCount = 3;
+    dpi.pPoolSizes = ps;
+    if (vkCreateDescriptorPool(_vk, &dpi, nullptr, &_pool) != VK_SUCCESS)
+        return false;
+    VkSamplerCreateInfo si { VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO };
+    si.addressModeU = si.addressModeV = si.addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+    si.maxLod = 0.0f;
+    si.magFilter = si.minFilter = VK_FILTER_NEAREST;
+    if (vkCreateSampler(_vk, &si, nullptr, &_point) != VK_SUCCESS)
+        return false;
+    si.magFilter = si.minFilter = VK_FILTER_LINEAR;
+    if (vkCreateSampler(_vk, &si, nullptr, &_linear) != VK_SUCCESS)
+        return false;
+    VkShaderModuleCreateInfo mi { VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO };
+    mi.codeSize = sizeof(sgsrfg_spv_fullscreen_vert);
+    mi.pCode = sgsrfg_spv_fullscreen_vert;
+    if (vkCreateShaderModule(_vk, &mi, nullptr, &_vs) != VK_SUCCESS)
+        return false;
+    VkQueryPoolCreateInfo qi { VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO };
+    qi.queryType = VK_QUERY_TYPE_TIMESTAMP;
+    qi.queryCount = 6 * Ring;  // per slot: prepare [0,1], generate [2..5]
+    if (vkCreateQueryPool(_vk, &qi, nullptr, &_queries) != VK_SUCCESS)
+        _queries = VK_NULL_HANDLE;
+
+    _ubo = FgCreateBuf(device, 256 * Ring, D3D12_HEAP_TYPE_UPLOAD, D3D12_RESOURCE_STATE_GENERIC_READ);
+    _flush[0] = FgCreateBuf(device, 256, D3D12_HEAP_TYPE_DEFAULT, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    _flush[1] = FgCreateBuf(device, 256, D3D12_HEAP_TYPE_DEFAULT, D3D12_RESOURCE_STATE_COPY_DEST);
+    if (_ubo == nullptr || _flush[0] == nullptr || _flush[1] == nullptr)
+        return false;
+    D3D12_RANGE noRead { 0, 0 };
+    if (FAILED(_ubo->Map(0, &noRead, (void**) &_uboMapped)))
+        return false;
+    UINT64 handle = 0;
+    if (FAILED(_interop->GetVulkanResourceInfo1(_ubo, &handle, &_uboOffset, nullptr)) || handle == 0)
+        return false;
+    _uboBuffer = (VkBuffer) handle;
+
+    using B = std::pair<uint32_t, VkDescriptorType>;
+    const VkDescriptorType U = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER, S = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,
+                           I = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+    if (!MakePass(_prep, sgsrfg_spv_prep_comp, sizeof(sgsrfg_spv_prep_comp), { B(0, U), B(1, S), B(2, S), B(3, I) }, false,
+                  VK_FORMAT_UNDEFINED, 1) ||
+        !MakePass(_splat, sgsrfg_spv_splat_comp, sizeof(sgsrfg_spv_splat_comp), { B(0, U), B(1, S), B(2, I) }, false,
+                  VK_FORMAT_UNDEFINED, 1) ||
+        !MakePass(_gatherPass, sgsrfg_spv_gather_comp, sizeof(sgsrfg_spv_gather_comp), { B(0, U), B(1, S), B(2, I) },
+                  false, VK_FORMAT_UNDEFINED, 1) ||
+        !MakePass(_reduce, sgsrfg_spv_reduce_comp, sizeof(sgsrfg_spv_reduce_comp), { B(0, U), B(1, S), B(2, I) }, false,
+                  VK_FORMAT_UNDEFINED, PyrLevels))
+        return false;
+    // resolve pipelines are made on the first Generate, when the output format is known
+    _ready = true;
+    return true;
+}
+
+bool SGSRFGVk::SizeImages(uint32_t rw, uint32_t rh)
+{
+    if (_sizedFor && rw == _rw && rh == _rh)
+        return true;
+    for (auto& m : _mvd)
+        FreeImage(m);
+    for (auto& f : _field)
+        FreeImage(f);
+    FreeImage(_hud);
+    _rw = rw;
+    _rh = rh;
+    for (auto& m : _mvd)
+        if (!MakeImage(m, rw, rh, VK_FORMAT_R16G16B16A16_SFLOAT, VK_IMAGE_USAGE_STORAGE_BIT))
+            return false;
+    const bool half = (_flags & FG_HALF) != 0;
+    uint32_t w = half ? (rw + 1) / 2 : rw, h = half ? (rh + 1) / 2 : rh;
+    for (uint32_t L = 0; L <= PyrLevels; L++)
+    {
+        if (!MakeImage(_field[L], w, h, VK_FORMAT_R32_UINT, VK_IMAGE_USAGE_STORAGE_BIT))
+            return false;
+        w = (w + 1) / 2;
+        h = (h + 1) / 2;
+    }
+    if (!MakeImage(_hud, 1, 1, VK_FORMAT_R8G8_UNORM, VK_IMAGE_USAGE_STORAGE_BIT))  // no HUD mask in this path
+        return false;
+    for (auto& p : _prepared)
+        p = Prepared {};
+    _sizedFor = true;
+    LOG_INFO("SGSR-FG: render {0}x{1}, field {2}x{3}", rw, rh, _field[0].w, _field[0].h);
+    return true;
+}
+
+VkImageView SGSRFGVk::GameView(ID3D12Resource* res, VkFormat& fmt, bool depth)
+{
+    UINT64 handle = 0, offset = 0;
+    fmt = VK_FORMAT_UNDEFINED;
+    if (res == nullptr || FAILED(_interop->GetVulkanResourceInfo1(res, &handle, &offset, &fmt)) || handle == 0)
+        return VK_NULL_HANDLE;
+    const bool isDepth = fmt == VK_FORMAT_D32_SFLOAT || fmt == VK_FORMAT_D32_SFLOAT_S8_UINT ||
+                         fmt == VK_FORMAT_D24_UNORM_S8_UINT || fmt == VK_FORMAT_D16_UNORM;
+    depth = depth && isDepth;
+    const auto key = std::make_tuple((uint64_t) handle, (int) fmt, depth ? 1 : 0);
+    auto it = _gameViews.find(key);
+    if (it != _gameViews.end())
+        return it->second;
+    VkImageViewCreateInfo vi { VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO };
+    vi.image = (VkImage) handle;
+    vi.viewType = VK_IMAGE_VIEW_TYPE_2D;
+    vi.format = fmt;
+    vi.subresourceRange = { depth ? (VkImageAspectFlags) VK_IMAGE_ASPECT_DEPTH_BIT
+                                  : (VkImageAspectFlags) VK_IMAGE_ASPECT_COLOR_BIT,
+                            0, 1, 0, 1 };
+    VkImageView v = VK_NULL_HANDLE;
+    if (vkCreateImageView(_vk, &vi, nullptr, &v) != VK_SUCCESS)
+        return VK_NULL_HANDLE;
+    _gameViews[key] = v;
+    return v;
+}
+
+VkDescriptorBufferInfo SGSRFGVk::WriteUbo(const FrameInfo& cur, const FrameInfo& prev, uint32_t flags)
+{
+    const uint32_t slot = _uboSlot++ % Ring;
+    SGSRFGParams u {};
+    u.display[0] = (float) _dw, u.display[1] = (float) _dh, u.display[2] = 1.0f / _dw, u.display[3] = 1.0f / _dh;
+    u.render[0] = (float) cur.renderW, u.render[1] = (float) cur.renderH;
+    u.render[2] = 1.0f / std::max(1u, cur.renderW), u.render[3] = 1.0f / std::max(1u, cur.renderH);
+    u.mv[0] = (float) cur.mvW, u.mv[1] = (float) cur.mvH;
+    u.mv[2] = cur.mvScaleX / std::max(1u, cur.mvW), u.mv[3] = cur.mvScaleY / std::max(1u, cur.mvH);
+    u.jitter[0] = cur.jitterX, u.jitter[1] = cur.jitterY, u.jitter[2] = prev.jitterX, u.jitter[3] = prev.jitterY;
+    u.thr[0] = 0.03f, u.thr[1] = 0.08f, u.thr[2] = 0.08f, u.thr[3] = 1.0f;
+    u.stat[0] = 1.5f / 255, u.stat[1] = 4.0f / 255, u.stat[2] = 0.75f, u.stat[3] = 2.5f;
+    u.cfg[0] = flags | (cur.invertedDepth ? 0u : FG_DEPTH_STD), u.cfg[1] = cur.renderW, u.cfg[2] = PyrLevels, u.cfg[3] = 2;
+    memcpy(_uboMapped + slot * 256, &u, sizeof u);
+    return VkDescriptorBufferInfo { _uboBuffer, _uboOffset + slot * 256, 256 };
+}
+
+// common start of an interop recording: flush vkd3d's batched barriers, then Begin
+#define SGSRFG_BEGIN(cl, cb)                                                                                         \
+    (cl)->CopyBufferRegion(_flush[1], 0, _flush[0], 0, 4);                                                          \
+    VkCommandBuffer cb = VK_NULL_HANDLE;                                                                             \
+    if (FAILED(_interop->BeginVkCommandBufferInterop((cl), &cb)) || cb == VK_NULL_HANDLE)                            \
+    {                                                                                                                \
+        LOG_ERROR("SGSR-FG: BeginVkCommandBufferInterop failed");                                                    \
+        return false;                                                                                                \
+    }
+
+static void FgFullBarrier(VkCommandBuffer cb)
+{
+    VkMemoryBarrier mb { VK_STRUCTURE_TYPE_MEMORY_BARRIER };
+    mb.srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT;
+    mb.dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+    vkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1, &mb, 0, nullptr,
+                         0, nullptr);
+}
+
+bool SGSRFGVk::Prepare(ID3D12GraphicsCommandList* cl, uint64_t frameId, const Input& depth, const Input& mv,
+                       const FrameInfo& fin)
+{
+    if (!_ready || fin.renderW == 0 || fin.renderH == 0 || fin.renderW * fin.renderH >= (1u << 20))
+        return false;
+    FrameInfo f = fin;
+    if (f.mvW == 0 || f.mvH == 0)  // not given: the whole MV texture
+    {
+        D3D12_RESOURCE_DESC md = mv.res ? mv.res->GetDesc() : D3D12_RESOURCE_DESC {};
+        f.mvW = (uint32_t) md.Width;
+        f.mvH = md.Height;
+    }
+    if (!SizeImages(f.renderW, f.renderH))
+        return false;
+    VkFormat fd, fm;
+    VkImageView vDepth = GameView(depth.res, fd, true), vMv = GameView(mv.res, fm, false);
+    if (vDepth == VK_NULL_HANDLE || vMv == VK_NULL_HANDLE)
+        return false;
+    VkImageLayout lDepth, lMv;
+    _interop->GetVulkanImageLayout(depth.res, depth.state, &lDepth);
+    _interop->GetVulkanImageLayout(mv.res, mv.state, &lMv);
+    const uint32_t s = (uint32_t) (frameId % Slots), slot = (uint32_t) (frameId % Ring);
+    _prepared[s].frameId = frameId;
+    _prepared[s].info = f;
+    const VkDescriptorBufferInfo ubi = WriteUbo(f, f, _flags);
+
+    VkDescriptorImageInfo ii[3] = { { _point, vDepth, lDepth }, { _point, vMv, lMv }, { VK_NULL_HANDLE, _mvd[s].view, VK_IMAGE_LAYOUT_GENERAL } };
+    VkWriteDescriptorSet w[4] = {};
+    for (int i = 0; i < 4; i++)
+    {
+        w[i] = { VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET };
+        w[i].dstSet = _prep.set[slot];
+        w[i].dstBinding = i;
+        w[i].descriptorCount = 1;
+    }
+    w[0].descriptorType = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER;
+    w[0].pBufferInfo = &ubi;
+    w[1].descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+    w[1].pImageInfo = &ii[0];
+    w[2].descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+    w[2].pImageInfo = &ii[1];
+    w[3].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+    w[3].pImageInfo = &ii[2];
+    vkUpdateDescriptorSets(_vk, 4, w, 0, nullptr);
+
+    SGSRFG_BEGIN(cl, cb);
+    if (!_fresh.empty())
+    {
+        std::vector<VkImageMemoryBarrier> ib;
+        for (VkImage im : _fresh)
+        {
+            VkImageMemoryBarrier b { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER };
+            b.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+            b.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+            b.newLayout = VK_IMAGE_LAYOUT_GENERAL;
+            b.srcQueueFamilyIndex = b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+            b.image = im;
+            b.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+            ib.push_back(b);
+        }
+        vkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 0, nullptr, 0,
+                             nullptr, (uint32_t) ib.size(), ib.data());
+        _fresh.clear();
+    }
+    FgFullBarrier(cb);
+    const uint32_t q = slot * 6;
+    if (_queries)
+    {
+        vkCmdResetQueryPool(cb, _queries, q, 2);
+        vkCmdWriteTimestamp(cb, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, _queries, q);
+    }
+    SGSRFGPush pc { 0.0f, 0, 0, 0 };
+    vkCmdBindPipeline(cb, VK_PIPELINE_BIND_POINT_COMPUTE, _prep.pipe);
+    vkCmdBindDescriptorSets(cb, VK_PIPELINE_BIND_POINT_COMPUTE, _prep.pl, 0, 1, &_prep.set[slot], 0, nullptr);
+    vkCmdPushConstants(cb, _prep.pl, PushStages, 0, sizeof pc, &pc);
+    vkCmdDispatch(cb, (f.renderW + 7) / 8, (f.renderH + 7) / 8, 1);
+    if (_queries)
+        vkCmdWriteTimestamp(cb, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, _queries, q + 1);
+    FgFullBarrier(cb);
+    _interop->EndVkCommandBufferInterop(cl);
+    return true;
+}
+
+bool SGSRFGVk::Generate(ID3D12GraphicsCommandList* cl, uint64_t frameId, const Input& colour, const Input& present,
+                        bool hudless, const Input& output, float t, bool reset, bool colourStable)
+{
+    if (!_ready || !_sizedFor)
+        return false;
+    const uint32_t s = (uint32_t) (frameId % Slots), sp = (uint32_t) ((frameId + Slots - 1) % Slots);
+    const uint32_t slot = (uint32_t) ((frameId + Ring / 2) % Ring);  // apart from Prepare's slot of the same frame
+    if (_prepared[s].frameId != frameId)
+    {
+        LOG_WARN("SGSR-FG: frame {0} was not prepared", frameId);
+        return false;
+    }
+    VkFormat fc, fp, fo;
+    VkImageView vC = GameView(colour.res, fc, false), vPres = GameView(present.res, fp, false),
+                vOut = GameView(output.res, fo, false);
+    if (vC == VK_NULL_HANDLE || vPres == VK_NULL_HANDLE || vOut == VK_NULL_HANDLE)
+        return false;
+    VkImageLayout lC, lPres, lOut;
+    _interop->GetVulkanImageLayout(colour.res, colour.state, &lC);
+    _interop->GetVulkanImageLayout(present.res, present.state, &lPres);
+    _interop->GetVulkanImageLayout(output.res, output.state, &lOut);
+    UINT64 hC = 0, hOut = 0, off = 0;
+    _interop->GetVulkanResourceInfo1(colour.res, &hC, &off, nullptr);
+    _interop->GetVulkanResourceInfo1(output.res, &hOut, &off, nullptr);
+    if ((_genCount % 60) == 0)
+    {
+        _forceCopy = FgFlag("Z:\\tmp\\sgsrfg_copy");
+        const bool m = FgFlag("Z:\\tmp\\sgsrfg_hudmask");
+        if (m != _hudMask)
+            LOG_INFO("SGSR-FG: own HUD mask {0}", m ? "on (used when there is no HUD-less frame)" : "off");
+        _hudMask = m;
+    }
+    const bool useMask = _hudMask && !hudless;
+    // resolve straight into FFX's output when it can be a render target of the display size
+    const D3D12_RESOURCE_DESC od = output.res->GetDesc();
+    const bool direct = !_forceCopy && (od.Flags & D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET) && od.Width == _dw &&
+                        od.Height == _dh;
+    const VkImageLayout lAtt =
+        (lOut == VK_IMAGE_LAYOUT_GENERAL || lOut == VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL)
+            ? lOut
+            : VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+    // P: last frame's colour by reference when it was a stable copy, else the own copy in _prev
+    VkImageView vP = VK_NULL_HANDLE;
+    VkImageLayout lP = VK_IMAGE_LAYOUT_GENERAL;
+    if (_prevRes != nullptr && !_forceCopy)
+    {
+        VkFormat fpv;
+        vP = GameView(_prevRes, fpv, false);
+        if (vP != VK_NULL_HANDLE)
+            _interop->GetVulkanImageLayout(_prevRes, _prevResState, &lP);
+    }
+    const bool usedRef = vP != VK_NULL_HANDLE;
+
+    // own images that depend on the game's formats
+    if (_prev.format != fc || _prev.w != _dw)
+    {
+        FreeImage(_prev);
+        if (!MakeImage(_prev, _dw, _dh, fc, 0))
+            return false;
+        _prevValid = false;
+    }
+    if (!direct && _target.format != fo)
+    {
+        FreeImage(_target);
+        if (!MakeImage(_target, _dw, _dh, fo, VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT))
+            return false;
+    }
+    Pass& res = hudless ? _resolveLess : useMask ? _resolveHud : _resolve;
+    VkFormat& resFmt = hudless ? _resolveLessFormat : useMask ? _resolveHudFormat : _resolveFormat;
+    if (res.pipe == VK_NULL_HANDLE || resFmt != fo)
+    {
+        using B = std::pair<uint32_t, VkDescriptorType>;
+        const VkDescriptorType U = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER, S = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+        std::vector<B> rb = { B(0, U) };
+        for (uint32_t b = 1; b <= 12; b++)
+            rb.push_back(B(b, S));
+        const uint32_t* spv = hudless ? sgsrfg_spv_resolve_fgless_frag
+                              : useMask ? sgsrfg_spv_resolve_fghud_frag
+                                        : sgsrfg_spv_resolve_fg2_frag;
+        size_t bytes = hudless ? sizeof(sgsrfg_spv_resolve_fgless_frag)
+                       : useMask ? sizeof(sgsrfg_spv_resolve_fghud_frag)
+                                 : sizeof(sgsrfg_spv_resolve_fg2_frag);
+        if (res.pipe != VK_NULL_HANDLE)
+            return false;  // a format change of the output after the first frame: not handled in the prototype
+        if (!MakePass(res, spv, bytes, rb, true, fo, 1))
+            return false;
+        resFmt = fo;
+    }
+
+    if (useMask && (_hudSt[0].image == VK_NULL_HANDLE || _hudSt[0].w != _dw))
+    {
+        for (auto& h : _hudSt)
+        {
+            FreeImage(h);
+            if (!MakeImage(h, _dw, _dh, VK_FORMAT_R8G8B8A8_UNORM, VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT))
+                return false;
+        }
+        _hudStValid = false;
+    }
+    if (useMask && _static.pipe == VK_NULL_HANDLE)
+    {
+        using B = std::pair<uint32_t, VkDescriptorType>;
+        const VkDescriptorType U = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER, S = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+        if (!MakePass(_static, sgsrfg_spv_static_frag, sizeof(sgsrfg_spv_static_frag),
+                      { B(0, U), B(1, S), B(2, S), B(3, S), B(4, S), B(5, S), B(6, S) }, true, VK_FORMAT_R8G8B8A8_UNORM, 1))
+            return false;
+    }
+
+    const bool canGenerate = !reset && _prevValid && _prevFrame + 1 == frameId && _prepared[sp].frameId + 1 == frameId;
+    const FrameInfo& cur = _prepared[s].info;
+    const FrameInfo& prv = canGenerate ? _prepared[sp].info : cur;
+    // FG_HUD2 (32768): fg_static keeps the running static-likeness in B (mask v2; the fghud resolve is built with it)
+    const uint32_t flags = _flags | (_gather ? 8192u : 0u) | (useMask ? 32768u : 0u);
+    const VkDescriptorBufferInfo ubi = WriteUbo(cur, prv, flags);
+    const VkImageLayout G = VK_IMAGE_LAYOUT_GENERAL;
+
+    std::vector<VkWriteDescriptorSet> wr;
+    std::vector<VkDescriptorImageInfo> ii;
+    ii.reserve(40);
+    auto put = [&](VkDescriptorSet set, uint32_t binding, VkDescriptorType type, VkImageView v, VkImageLayout l, VkSampler sm)
+    {
+        ii.push_back({ sm, v, l });
+        VkWriteDescriptorSet w { VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET };
+        w.dstSet = set;
+        w.dstBinding = binding;
+        w.descriptorCount = 1;
+        w.descriptorType = type;
+        w.pImageInfo = &ii.back();
+        wr.push_back(w);
+    };
+    auto putUbo = [&](VkDescriptorSet set)
+    {
+        VkWriteDescriptorSet w { VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET };
+        w.dstSet = set;
+        w.dstBinding = 0;
+        w.descriptorCount = 1;
+        w.descriptorType = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER;
+        w.pBufferInfo = &ubi;
+        wr.push_back(w);
+    };
+    const VkDescriptorType S = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, I = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+    Pass& fill = _gather ? _gatherPass : _splat;
+    if (canGenerate)
+    {
+        putUbo(fill.set[slot]);
+        put(fill.set[slot], 1, S, _mvd[s].view, G, _point);
+        put(fill.set[slot], 2, I, _field[0].view, G, VK_NULL_HANDLE);
+        for (uint32_t L = 1; L <= PyrLevels; L++)
+        {
+            VkDescriptorSet ds = _reduce.set[slot * PyrLevels + L - 1];
+            putUbo(ds);
+            put(ds, 1, S, _field[L - 1].view, G, _point);
+            put(ds, 2, I, _field[L].view, G, VK_NULL_HANDLE);
+        }
+        VkDescriptorSet rs = res.set[slot];
+        putUbo(rs);
+        put(rs, 1, S, usedRef ? vP : _prev.view, usedRef ? lP : G, _linear);
+        put(rs, 2, S, vC, lC, _linear);
+        for (uint32_t L = 0; L <= PyrLevels; L++)
+            put(rs, 3 + L, S, _field[L].view, G, _point);
+        put(rs, 9, S, _mvd[s].view, G, _point);
+        put(rs, 10, S, _mvd[sp].view, G, _point);
+        const uint32_t hn = _hudPar ^ 1u;  // state written by fg_static this frame
+        put(rs, 11, S, useMask ? _hudSt[hn].view : _hud.view, G, _linear);
+        if (useMask)
+        {
+            VkDescriptorSet ss = _static.set[slot];
+            putUbo(ss);
+            put(ss, 1, S, usedRef ? vP : _prev.view, usedRef ? lP : G, _point);
+            put(ss, 2, S, vC, lC, _point);
+            put(ss, 3, S, _hudSt[_hudPar].view, G, _point);
+            put(ss, 4, S, _mvd[s].view, G, _point);
+            put(ss, 5, S, usedRef ? vP : _prev.view, usedRef ? lP : G, _linear);
+            put(ss, 6, S, vC, lC, _linear);
+        }
+        put(rs, 12, S, vPres, lPres, _point);
+        vkUpdateDescriptorSets(_vk, (uint32_t) wr.size(), wr.data(), 0, nullptr);
+    }
+
+    SGSRFG_BEGIN(cl, cb);
+    if (!_fresh.empty())
+    {
+        std::vector<VkImageMemoryBarrier> ib;
+        for (VkImage im : _fresh)
+        {
+            VkImageMemoryBarrier b { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER };
+            b.dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_WRITE_BIT |
+                              VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+            b.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+            b.newLayout = VK_IMAGE_LAYOUT_GENERAL;
+            b.srcQueueFamilyIndex = b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+            b.image = im;
+            b.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+            ib.push_back(b);
+        }
+        vkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 0, nullptr, 0,
+                             nullptr, (uint32_t) ib.size(), ib.data());
+        _fresh.clear();
+    }
+    FgFullBarrier(cb);
+    const uint32_t q = slot * 6 + 2;
+    if (_queries)
+    {
+        vkCmdResetQueryPool(cb, _queries, q, 4);
+        vkCmdWriteTimestamp(cb, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, _queries, q);
+    }
+    VkImageCopy whole {};
+    whole.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+    whole.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+    whole.extent = { _dw, _dh, 1 };
+    if (canGenerate)
+    {
+        SGSRFGPush pc { t, 0, 0, 0 };
+        if (!_gather)
+        {
+            VkClearColorValue zero {};
+            VkImageSubresourceRange rr { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+            vkCmdClearColorImage(cb, _field[0].image, G, &zero, 1, &rr);
+            FgFullBarrier(cb);
+        }
+        vkCmdBindPipeline(cb, VK_PIPELINE_BIND_POINT_COMPUTE, fill.pipe);
+        vkCmdBindDescriptorSets(cb, VK_PIPELINE_BIND_POINT_COMPUTE, fill.pl, 0, 1, &fill.set[slot], 0, nullptr);
+        vkCmdPushConstants(cb, fill.pl, PushStages, 0, sizeof pc, &pc);
+        vkCmdDispatch(cb, (_field[0].w + 7) / 8, (_field[0].h + 7) / 8, 1);
+        FgFullBarrier(cb);
+        vkCmdBindPipeline(cb, VK_PIPELINE_BIND_POINT_COMPUTE, _reduce.pipe);
+        for (uint32_t L = 1; L <= PyrLevels; L++)
+        {
+            pc.level = L;
+            vkCmdBindDescriptorSets(cb, VK_PIPELINE_BIND_POINT_COMPUTE, _reduce.pl, 0, 1,
+                                    &_reduce.set[slot * PyrLevels + L - 1], 0, nullptr);
+            vkCmdPushConstants(cb, _reduce.pl, PushStages, 0, sizeof pc, &pc);
+            vkCmdDispatch(cb, (_field[L].w + 7) / 8, (_field[L].h + 7) / 8, 1);
+            FgFullBarrier(cb);
+        }
+        if (_queries)
+            vkCmdWriteTimestamp(cb, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, _queries, q + 1);
+        auto outBarrier = [&](VkImageLayout from, VkImageLayout to)
+        {
+            VkImageMemoryBarrier b { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER };
+            b.srcAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+            b.dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+            b.oldLayout = from;
+            b.newLayout = to;
+            b.srcQueueFamilyIndex = b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+            b.image = (VkImage) hOut;
+            b.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+            vkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 0,
+                                 nullptr, 0, nullptr, 1, &b);
+        };
+        if (useMask)
+        {
+            if (!_hudStValid)
+            {
+                VkClearColorValue zero {};
+                VkImageSubresourceRange rr { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+                vkCmdClearColorImage(cb, _hudSt[_hudPar].image, G, &zero, 1, &rr);
+                FgFullBarrier(cb);
+                _hudStValid = true;
+            }
+            VkRenderingAttachmentInfo sa { VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO };
+            sa.imageView = _hudSt[_hudPar ^ 1u].view;
+            sa.imageLayout = G;
+            sa.loadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+            sa.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+            VkRenderingInfo sri { VK_STRUCTURE_TYPE_RENDERING_INFO };
+            sri.renderArea = { { 0, 0 }, { _dw, _dh } };
+            sri.layerCount = 1;
+            sri.colorAttachmentCount = 1;
+            sri.pColorAttachments = &sa;
+            _beginRendering(cb, &sri);
+            VkViewport sv { 0, 0, (float) _dw, (float) _dh, 0, 1 };
+            VkRect2D ssc { { 0, 0 }, { _dw, _dh } };
+            vkCmdSetViewport(cb, 0, 1, &sv);
+            vkCmdSetScissor(cb, 0, 1, &ssc);
+            vkCmdBindPipeline(cb, VK_PIPELINE_BIND_POINT_GRAPHICS, _static.pipe);
+            vkCmdBindDescriptorSets(cb, VK_PIPELINE_BIND_POINT_GRAPHICS, _static.pl, 0, 1, &_static.set[slot], 0,
+                                    nullptr);
+            vkCmdPushConstants(cb, _static.pl, PushStages, 0, sizeof pc, &pc);
+            vkCmdDraw(cb, 3, 1, 0, 0);
+            _endRendering(cb);
+            FgFullBarrier(cb);
+        }
+        if (direct && lAtt != lOut)
+            outBarrier(lOut, lAtt);
+        VkRenderingAttachmentInfo att { VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO };
+        att.imageView = direct ? vOut : _target.view;
+        att.imageLayout = direct ? lAtt : G;
+        att.loadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+        att.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+        VkRenderingInfo ri { VK_STRUCTURE_TYPE_RENDERING_INFO };
+        ri.renderArea = { { 0, 0 }, { _dw, _dh } };
+        ri.layerCount = 1;
+        ri.colorAttachmentCount = 1;
+        ri.pColorAttachments = &att;
+        _beginRendering(cb, &ri);
+        VkViewport v { 0, 0, (float) _dw, (float) _dh, 0, 1 };
+        VkRect2D sc { { 0, 0 }, { _dw, _dh } };
+        vkCmdSetViewport(cb, 0, 1, &v);
+        vkCmdSetScissor(cb, 0, 1, &sc);
+        vkCmdBindPipeline(cb, VK_PIPELINE_BIND_POINT_GRAPHICS, res.pipe);
+        vkCmdBindDescriptorSets(cb, VK_PIPELINE_BIND_POINT_GRAPHICS, res.pl, 0, 1, &res.set[slot], 0, nullptr);
+        vkCmdPushConstants(cb, res.pl, PushStages, 0, sizeof pc, &pc);
+        vkCmdDraw(cb, 3, 1, 0, 0);
+        _endRendering(cb);
+        if (direct && lAtt != lOut)
+            outBarrier(lAtt, lOut);
+        FgFullBarrier(cb);
+        if (!direct)
+            vkCmdCopyImage(cb, _target.image, G, (VkImage) hOut, lOut, 1, &whole);
+    }
+    else
+    {
+        if (_queries)
+            vkCmdWriteTimestamp(cb, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, _queries, q + 1);
+        // no previous frame (start, reset, a gap in frame ids): the generated frame is the presented one
+        UINT64 hPres = 0;
+        _interop->GetVulkanResourceInfo1(present.res, &hPres, &off, nullptr);
+        if (fp == fo)
+            vkCmdCopyImage(cb, (VkImage) hPres, lPres, (VkImage) hOut, lOut, 1, &whole);
+    }
+    if (_queries)
+        vkCmdWriteTimestamp(cb, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, _queries, q + 2);
+    // keep this real frame's colour as P of the next generated frame: by reference when it stays intact (HUD-less copy
+    // ring), else copied
+    const bool keepRef = colourStable && !_forceCopy;
+    if (!keepRef)
+    {
+        vkCmdCopyImage(cb, (VkImage) hC, lC, _prev.image, G, 1, &whole);
+        FgFullBarrier(cb);
+    }
+    if (_queries)
+        vkCmdWriteTimestamp(cb, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, _queries, q + 3);
+    _interop->EndVkCommandBufferInterop(cl);
+    if (_prevRes != nullptr)
+        _prevRes->Release();
+    _prevRes = nullptr;
+    if (keepRef)
+    {
+        _prevRes = colour.res;
+        _prevRes->AddRef();
+        _prevResState = colour.state;
+    }
+    if (_genCount % 600 == 0 || direct != _lastDirect || usedRef != _lastRef)
+        LOG_INFO("SGSR-FG: output {0}, P {1}", direct ? "rendered directly" : "via own target + copy",
+                 usedRef ? "by reference" : "copied");
+    _lastDirect = direct;
+    _lastRef = usedRef;
+    if (useMask && canGenerate)
+        _hudPar ^= 1u;
+    _prevValid = true;
+    _prevFrame = frameId;
+    _genCount++;
+    return true;
+}
+
+bool SGSRFGVk::GenerationDone(uint64_t frameId)
+{
+    if (_queries == VK_NULL_HANDLE)
+        return true;
+    const uint32_t slot = (uint32_t) ((frameId + Ring / 2) % Ring);
+    uint64_t v = 0;
+    // timestamp q + 2 is written after the generated image; before the GPU reaches this frame's reset the slot still
+    // holds the previous frame's value -- "done" only when available and different from what was seen last time
+    if (vkGetQueryPoolResults(_vk, _queries, slot * 6 + 2 + 2, 1, sizeof v, &v, 8, VK_QUERY_RESULT_64_BIT) != VK_SUCCESS)
+        return false;
+    if (v == _lastGenTs[slot % 8])
+        return false;
+    _lastGenTs[slot % 8] = v;
+    return true;
+}
+
+bool SGSRFGVk::LastTiming(double out[3])
+{
+    if (_queries == VK_NULL_HANDLE || _genCount < Ring)
+        return false;
+    const uint32_t slot = (uint32_t) ((_prevFrame + Ring - 2) % Ring);
+    uint64_t pr[2] {}, ge[4] {};
+    if (vkGetQueryPoolResults(_vk, _queries, slot * 6, 2, sizeof(pr), pr, 8, VK_QUERY_RESULT_64_BIT) != VK_SUCCESS)
+        return false;
+    const uint32_t gslot = (uint32_t) ((_prevFrame + Ring - 2 + Ring / 2) % Ring);
+    if (vkGetQueryPoolResults(_vk, _queries, gslot * 6 + 2, 4, sizeof(ge), ge, 8, VK_QUERY_RESULT_64_BIT) != VK_SUCCESS)
+        return false;
+    auto ms = [&](uint64_t a, uint64_t b) { return b >= a ? (double) (b - a) * _tsPeriodNs * 1e-6 : 0.0; };
+    out[0] = ms(pr[0], pr[1]);
+    out[1] = ms(ge[0], ge[1]);
+    out[2] = ms(ge[1], ge[3]);
+    return true;
+}
+
+void SGSRFGVk::Release()
+{
+    if (_vk != VK_NULL_HANDLE)
+    {
+        for (Pass* p : { &_prep, &_splat, &_gatherPass, &_reduce, &_resolve, &_resolveLess, &_resolveHud, &_static })
+        {
+            if (p->pipe)
+                vkDestroyPipeline(_vk, p->pipe, nullptr);
+            if (p->pl)
+                vkDestroyPipelineLayout(_vk, p->pl, nullptr);
+            if (p->dsl)
+                vkDestroyDescriptorSetLayout(_vk, p->dsl, nullptr);
+            *p = Pass {};
+        }
+        for (auto& m : _mvd)
+            FreeImage(m);
+        for (auto& f : _field)
+            FreeImage(f);
+        for (auto& h : _hudSt)
+            FreeImage(h);
+        FreeImage(_hud);
+        FreeImage(_prev);
+        FreeImage(_target);
+        for (auto& v : _gameViews)
+            vkDestroyImageView(_vk, v.second, nullptr);
+        _gameViews.clear();
+        if (_pool)
+            vkDestroyDescriptorPool(_vk, _pool, nullptr);
+        if (_point)
+            vkDestroySampler(_vk, _point, nullptr);
+        if (_linear)
+            vkDestroySampler(_vk, _linear, nullptr);
+        if (_vs)
+            vkDestroyShaderModule(_vk, _vs, nullptr);
+        if (_queries)
+            vkDestroyQueryPool(_vk, _queries, nullptr);
+        _pool = VK_NULL_HANDLE;
+        _point = _linear = VK_NULL_HANDLE;
+        _vs = VK_NULL_HANDLE;
+        _queries = VK_NULL_HANDLE;
+    }
+    if (_prevRes)
+        _prevRes->Release();
+    _prevRes = nullptr;
+    if (_ubo)
+        _ubo->Release();
+    _ubo = nullptr;
+    for (auto*& f : _flush)
+        if (f)
+        {
+            f->Release();
+            f = nullptr;
+        }
+    if (_interop)
+        _interop->Release();
+    _interop = nullptr;
+    _fresh.clear();
+    _sizedFor = _prevValid = _ready = false;
+    _prevFrame = ~0ull;
+    _resolveFormat = _resolveLessFormat = _resolveHudFormat = VK_FORMAT_UNDEFINED;
+    _hudStValid = false;
+}
diff --git a/OptiScaler/framegen/sgsr/SGSRFG_Vk.h b/OptiScaler/framegen/sgsr/SGSRFG_Vk.h
new file mode 100644
index 0000000..25c8b48
--- /dev/null
+++ b/OptiScaler/framegen/sgsr/SGSRFG_Vk.h
@@ -0,0 +1,146 @@
+#pragma once
+
+#include "upscalers/sgsr3/SGSR3Student_Vk.h"  // ID3D12DXVKInteropDevice1
+
+#include <d3d12.h>
+#include <vulkan/vulkan.h>
+
+#include <cstdint>
+#include <map>
+#include <string>
+#include <tuple>
+#include <utility>
+#include <vector>
+
+//============================================================================================================
+// SGSR-FG inside the D3D12 game, on Vulkan through vkd3d-proton's interop (as the SGSR 3 student and v1f are):
+// frame interpolation from the game's MV and depth, (structure of AMD FidelityFX
+// Frame Interpolation 3.1, MIT, without its optical flow). It replaces FFX's FrameGenerationPrepare and FI dispatch
+// inside OptiScaler's FSR FG path, so pacing, presenting, the swapchain and HUDfix stay OptiScaler's / FFX's.
+//
+//   Prepare  (FrameGenerationPrepare, per real frame, on OptiScaler's FG command list): fg_prep -> dilated MV +
+//            depth of this frame into a ring slot (the game's MV / depth may be gone by present time)
+//   Generate (FFX frame generation callback, per generated frame, on the callback's command list): clear + splat
+//            (or gather), 5 pyramid levels, resolve (fragment) into an own target, copied into the FFX output;
+//            then the colour of this real frame is kept as P for the next one
+//
+// Resolve variants (fixed flags, README): fg2 without HUD handling, fgless when a HUD-less
+// colour is given (HUD taken from the presented frame by FI 3.1's rule).
+//============================================================================================================
+
+class SGSRFGVk
+{
+  public:
+    struct Input
+    {
+        ID3D12Resource* res = nullptr;
+        D3D12_RESOURCE_STATES state = D3D12_RESOURCE_STATE_COMMON;
+    };
+    struct FrameInfo
+    {
+        uint32_t renderW = 0, renderH = 0;  // size the game rendered (depth, render-res MV)
+        uint32_t mvW = 0, mvH = 0;          // MV texture size (render or display res); 0 = render size
+        float jitterX = 0, jitterY = 0;     // render px, as the game gives them (p + 0.5 - j)
+        float mvScaleX = 1, mvScaleY = 1;   // FFX convention: uv = mv * scale / (MV texture size)
+        bool invertedDepth = true;
+    };
+
+    bool Init(ID3D12Device* device, uint32_t displayW, uint32_t displayH);
+    bool Prepare(ID3D12GraphicsCommandList* cl, uint64_t frameId, const Input& depth, const Input& mv,
+                 const FrameInfo& f);
+    // colour: the HUD-less frame if there is one (hudless = true), else the presented frame; present: the frame
+    // with HUD; output: FFX's interpolation target. colourStable: the colour resource stays untouched until the next
+    // Generate (OptiScaler's per-frame HUD-less copy ring), so it is kept by reference as P instead of copied.
+    // Returns false when it could not run (the caller falls back).
+    bool Generate(ID3D12GraphicsCommandList* cl, uint64_t frameId, const Input& colour, const Input& present,
+                  bool hudless, const Input& output, float t, bool reset, bool colourStable = false);
+    void Release();
+    bool Ready() const { return _ready; }
+    // P5 pacing: true once the GPU has written this frame's generated image (timestamp after the resolve is available
+    // and new). Non-blocking; called from FFX's present thread.
+    bool GenerationDone(uint64_t frameId);
+    // GPU ms of the last readable frame: [0] prepare, [1] splat + pyramid, [2] resolve + copies
+    bool LastTiming(double out[3]);
+    const std::string& Info() const { return _info; }
+
+  private:
+    static constexpr uint32_t Ring = 8;  // descriptor / UBO / query slots
+    static constexpr uint32_t Slots = 4; // prepared frames (mvd) kept
+
+    struct Img
+    {
+        VkDeviceMemory mem = VK_NULL_HANDLE;
+        VkImage image = VK_NULL_HANDLE;
+        VkImageView view = VK_NULL_HANDLE;
+        VkFormat format = VK_FORMAT_UNDEFINED;
+        uint32_t w = 0, h = 0;
+    };
+    struct Pass
+    {
+        VkDescriptorSetLayout dsl = VK_NULL_HANDLE;
+        VkPipelineLayout pl = VK_NULL_HANDLE;
+        VkPipeline pipe = VK_NULL_HANDLE;
+        std::vector<VkDescriptorSet> set;  // Ring * setsPerSlot
+    };
+    struct Prepared
+    {
+        uint64_t frameId = ~0ull;
+        FrameInfo info;
+    };
+
+    ID3D12Device* _device = nullptr;
+    ID3D12DXVKInteropDevice1* _interop = nullptr;
+    VkInstance _instance = VK_NULL_HANDLE;
+    VkPhysicalDevice _physical = VK_NULL_HANDLE;
+    VkDevice _vk = VK_NULL_HANDLE;
+    PFN_vkCmdBeginRendering _beginRendering = nullptr;
+    PFN_vkCmdEndRendering _endRendering = nullptr;
+    double _tsPeriodNs = 1.0;
+    uint32_t _dw = 0, _dh = 0, _rw = 0, _rh = 0;
+    uint32_t _flags = 0;      // UBO cfg.x for prep / splat (FG_DILATE | FG_SPLAT4 ...)
+    bool _gather = false;     // /tmp/sgsrfg_gather: field by fg_gather instead of the atomic splat
+    bool _forceCopy = false;  // /tmp/sgsrfg_copy: old path (own target + copy, P copied), for A/B
+    ID3D12Resource* _prevRes = nullptr;  // P by reference (AddRef'd), else _prev holds a copy
+    D3D12_RESOURCE_STATES _prevResState = D3D12_RESOURCE_STATE_COMMON;
+    bool _lastDirect = false, _lastRef = false;
+    // own HUD mask (Z:\tmp\sgsrfg_hudmask, used only without a HUD-less frame): fg_static state ping-pong + fghud resolve
+    bool _hudMask = false;
+    Img _hudSt[2];
+    uint32_t _hudPar = 0;
+    bool _hudStValid = false;
+    uint64_t _lastGenTs[8] {};
+    bool _ready = false;
+    std::string _info;
+
+    Img _mvd[Slots], _field[6], _hud, _prev, _target;
+    bool _sizedFor = false, _prevValid = false;
+    uint64_t _prevFrame = ~0ull;
+    Prepared _prepared[Slots];
+    std::vector<VkImage> _fresh;  // own images still in UNDEFINED layout
+
+    ID3D12Resource* _ubo = nullptr;
+    uint8_t* _uboMapped = nullptr;
+    VkBuffer _uboBuffer = VK_NULL_HANDLE;
+    uint64_t _uboOffset = 0;
+    ID3D12Resource* _flush[2] = {};
+    uint32_t _uboSlot = 0;
+
+    VkSampler _point = VK_NULL_HANDLE, _linear = VK_NULL_HANDLE;
+    VkDescriptorPool _pool = VK_NULL_HANDLE;
+    VkShaderModule _vs = VK_NULL_HANDLE;
+    Pass _prep, _splat, _gatherPass, _reduce, _resolve, _resolveLess, _resolveHud, _static;
+    VkFormat _resolveFormat = VK_FORMAT_UNDEFINED, _resolveLessFormat = VK_FORMAT_UNDEFINED,
+             _resolveHudFormat = VK_FORMAT_UNDEFINED;
+    VkQueryPool _queries = VK_NULL_HANDLE;
+    uint32_t _genCount = 0;
+    std::map<std::tuple<uint64_t, int, int>, VkImageView> _gameViews;
+
+    bool MakeImage(Img& img, uint32_t w, uint32_t h, VkFormat fmt, VkImageUsageFlags usage);
+    void FreeImage(Img& img);
+    bool MakePass(Pass& p, const uint32_t* spv, size_t bytes,
+                  const std::vector<std::pair<uint32_t, VkDescriptorType>>& bindings, bool fragment, VkFormat rt,
+                  uint32_t setsPerSlot);
+    bool SizeImages(uint32_t rw, uint32_t rh);
+    VkImageView GameView(ID3D12Resource* res, VkFormat& fmt, bool depth);
+    VkDescriptorBufferInfo WriteUbo(const FrameInfo& cur, const FrameInfo& prev, uint32_t flags);
+};
