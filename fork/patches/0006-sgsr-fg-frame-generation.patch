+bool FSRFG_Dx12::UseSgsrFg()
+{
+    if (_sgsrFgFailed)
+        return false;
+    if (_sgsrFgCheckFrame == 0 || _frameCount >= _sgsrFgCheckFrame + 60 || _frameCount < _sgsrFgCheckFrame)
+    {
+        const bool want = GetFileAttributesA("Z:\\tmp\\sgsrfg") != INVALID_FILE_ATTRIBUTES;
+        if (want != _sgsrFgOn)
+            LOG_INFO("SGSR-FG: {0}", want ? "on" : "off (FFX frame interpolation)");
+        _sgsrFgOn = want;
+        _sgsrFgCheckFrame = _frameCount == 0 ? 1 : _frameCount;
+        PollSgsrFiles();
+    }
+    return _sgsrFgOn;
+}
+
+static std::string ReadSmallFile(const char* path)
+{
+    std::ifstream f(path);
+    if (!f)
+        return std::string();
+    std::stringstream ss;
+    ss << f.rdbuf();
+    std::string s = ss.str();
+    while (!s.empty() && (s.back() == '\n' || s.back() == '\r' || s.back() == ' '))
+        s.pop_back();
+    return s;
+}
+
+void FSRFG_Dx12::PollSgsrFiles()
+{
+    const std::string pace = ReadSmallFile("Z:\\tmp\\sgsrfg_pace");
+    if (pace != _paceFile)
+    {
+        _paceFile = pace;
+        std::istringstream in(pace);
+        std::string mode;
+        float q = 0.5f, margin = 0.3f;
+        in >> mode >> q >> margin;
+        _paceMode = mode == "mid" ? 1 : mode == "gpu" ? 2 : 0;
+        _paceQuantile = std::clamp(q, 0.0f, 1.0f);
+        _paceMarginMs = std::clamp(margin, 0.0f, 5.0f);
+        _pacePeriodN = 0;
+        _paceLastExitNs = _paceLastGenEntryNs = 0;
+        LOG_INFO("SGSR-FG pacing: {0} (quantile {1:.2f}, margin {2:.2f} ms)",
+                 _paceMode == 2 ? "P5, by GPU completion of the generated frame"
+                 : _paceMode == 1 ? "mid, own present callback"
+                                  : "FFX",
+                 _paceQuantile, _paceMarginMs);
+    }
+    const std::string fpt = ReadSmallFile("Z:\\tmp\\sgsrfg_fpt");
+    if (fpt != _fptFile)
+    {
+        _fptFile = fpt;
+        float margin = 0.01f, variance = 0.3f;  // OptiScaler's defaults ("tuning set B")
+        if (!fpt.empty())
+        {
+            std::istringstream in(fpt);
+            in >> margin >> variance;
+        }
+        auto config = Config::Instance();
+        config->FGFramePacingTuning.set_volatile_value(true);
+        config->FGFPTSafetyMarginInMs.set_volatile_value(margin);
+        config->FGFPTVarianceFactor.set_volatile_value(variance);
+        State::Instance().fsrfgFramePaceTuningChanged = true;
+        LOG_INFO("SGSR-FG: FFX frame pacing tuning: safety margin {0:.3f} ms, variance factor {1:.2f}", margin, variance);
+    }
+}
+
+static uint64_t PaceNowNs()
+{
+    return (uint64_t) std::chrono::duration_cast<std::chrono::nanoseconds>(
+               std::chrono::steady_clock::now().time_since_epoch())
+        .count();
+}
+
+static void PaceSleepUntil(uint64_t target)
+{
+    for (;;)
+    {
+        const uint64_t now = PaceNowNs();
+        if (now >= target)
+            return;
+        const uint64_t left = target - now;
+        if (left > 2000000)
+            Sleep((DWORD) ((left - 1500000) / 1000000));
+        else
+            SwitchToThread();
+    }
+}
+
+// Called by FFX's present thread for every frame it presents, before its own pacing wait and the Present. Our
+// wait (delay only): no present earlier than half the predicted game-frame period after the previous one. The
+// period is predicted from the last 16 intervals between generated frames becoming ready (one per game frame).
+ffxReturnCode_t FSRFG_Dx12::PacePresent(ffxCallbackDescFrameGenerationPresent* p)
+{
+    const uint64_t entry = PaceNowNs();
+    if (p->isGeneratedFrame)
+    {
+        if (_paceLastGenEntryNs != 0)
+        {
+            const double period = (entry - _paceLastGenEntryNs) / 1e6;
+            if (period > 4.0 && period < 200.0)
+                _pacePeriods[_pacePeriodN++ % 16] = period;
+        }
+        _paceLastGenEntryNs = entry;
+    }
+    uint64_t exitNs = entry;
+    const uint32_t n = std::min<uint32_t>(_pacePeriodN, 16);
+    double predicted = 0;
+    if (n >= 4)
+    {
+        double v[16];
+        std::copy(_pacePeriods, _pacePeriods + n, v);
+        std::sort(v, v + n);
+        predicted = v[std::min<uint32_t>(n - 1, (uint32_t) (_paceQuantile * (n - 1) + 0.5))];
+    }
+    if (_paceMode == 1 && n >= 4 && _paceLastExitNs != 0)
+    {
+        const uint64_t target = _paceLastExitNs + (uint64_t) ((predicted * 0.5 - _paceMarginMs) * 1e6);
+        if (target > entry && target - entry < 50000000)
+            PaceSleepUntil(target);
+        exitNs = PaceNowNs();
+        _paceSum[p->isGeneratedFrame ? 2 : 3] += (exitNs - entry) / 1e6;
+    }
+    else if (_paceMode == 2)
+    {
+        if (p->isGeneratedFrame)
+        {
+            // show the generated frame once the GPU has really produced it (with one queue it may sit behind the
+            // game's next frame), then the real frame half a period later
+            if (_sgsrFg != nullptr && _sgsrFgPrepared[p->frameID % BUFFER_COUNT])
+            {
+                const uint64_t deadline = entry + 40000000;
+                while (!_sgsrFg->GenerationDone(p->frameID))
+                {
+                    if (PaceNowNs() > deadline)
+                    {
+                        _paceGpuTimeouts++;
+                        break;
+                    }
+                    SwitchToThread();
+                }
+            }
+            _paceGenReadyNs = PaceNowNs();
+        }
+        else if (n >= 4 && _paceGenReadyNs != 0)
+        {
+            const uint64_t target = _paceGenReadyNs + (uint64_t) ((predicted * 0.5 - _paceMarginMs) * 1e6);
+            if (target > entry && target - entry < 50000000)
+                PaceSleepUntil(target);
+        }
+        exitNs = PaceNowNs();
+        _paceSum[p->isGeneratedFrame ? 2 : 3] += (exitNs - entry) / 1e6;
+    }
+    if (_paceLastExitNs != 0)
+    {
+        _paceSum[p->isGeneratedFrame ? 1 : 0] += (exitNs - _paceLastExitNs) / 1e6;
+        _paceCnt[p->isGeneratedFrame ? 1 : 0]++;
+    }
+    _paceLastExitNs = exitNs;
+    if (_paceCnt[0] >= 120)
+    {
+        LOG_INFO("SGSR-FG pacing ({0}): gen->real {1:.2f} ms, real->gen {2:.2f} ms, waited {3:.2f} / {4:.2f} ms per "
+                 "gen / real present, GPU-wait timeouts {5}",
+                 _paceMode == 2 ? "P5" : _paceMode == 1 ? "mid" : "FFX", _paceSum[0] / _paceCnt[0], _paceSum[1] / std::max(1u, _paceCnt[1]),
+                 _paceSum[2] / std::max(1u, _paceCnt[1]), _paceSum[3] / _paceCnt[0], _paceGpuTimeouts);
+        _paceGpuTimeouts = 0;
+        for (auto& x : _paceSum)
+            x = 0;
+        _paceCnt[0] = _paceCnt[1] = 0;
+    }
+
+    // what FFX does without a callback: the frame into the swapchain buffer
+    auto cl = (ID3D12GraphicsCommandList*) p->commandList;
+    auto src = (ID3D12Resource*) p->currentBackBuffer.resource;
+    auto dst = (ID3D12Resource*) p->outputSwapChainBuffer.resource;
+    if (cl == nullptr || src == nullptr || dst == nullptr)
+        return FFX_API_RETURN_ERROR;
+    const D3D12_RESOURCE_STATES ss = GetD3D12State((FfxApiResourceState) p->currentBackBuffer.state);
+    const D3D12_RESOURCE_STATES ds = GetD3D12State((FfxApiResourceState) p->outputSwapChainBuffer.state);
+    D3D12_RESOURCE_BARRIER b[2] {};
+    b[0].Type = b[1].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b[0].Transition.pResource = src;
+    b[0].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b[0].Transition.StateBefore = ss;
+    b[0].Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    b[1].Transition.pResource = dst;
+    b[1].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b[1].Transition.StateBefore = ds;
+    b[1].Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST;
+    if (ss != D3D12_RESOURCE_STATE_COPY_SOURCE)
+        cl->ResourceBarrier(1, &b[0]);
+    if (ds != D3D12_RESOURCE_STATE_COPY_DEST)
+        cl->ResourceBarrier(1, &b[1]);
+    cl->CopyResource(dst, src);
+    std::swap(b[0].Transition.StateBefore, b[0].Transition.StateAfter);
+    std::swap(b[1].Transition.StateBefore, b[1].Transition.StateAfter);
+    if (ss != D3D12_RESOURCE_STATE_COPY_SOURCE)
+        cl->ResourceBarrier(1, &b[0]);
+    if (ds != D3D12_RESOURCE_STATE_COPY_DEST)
+        cl->ResourceBarrier(1, &b[1]);
+    return FFX_API_RETURN_OK;
+}
