             }
         }
 
+        // Vela live model fsr3 (VelaLive.h): FSR 3.1 -- the newest 3.x upscaler the FidelityFX DLL offers (with FSR 4
+        // INT8 forced the block above would take 4.x)
+        if (VelaLive::Poll().model == VelaLive::Model::Fsr3)
+        {
+            auto& names = State::Instance().ffxUpscalerVersionNames;
+            int best3 = -1;
+            for (size_t i = 0; i < names.size(); i++)
+            {
+                const std::string n = names[i] != nullptr ? names[i] : "";
+                if (n.rfind("3.", 0) == 0 &&
+                    (best3 < 0 || n > std::string(names[best3] != nullptr ? names[best3] : "")))
+                    best3 = (int) i;
+            }
+            if (best3 >= 0)
+            {
+                Config::Instance()->FfxUpscalerIndex.set_volatile_value(best3);
+                LOG_INFO("Vela: FFX upscaler index {} ({}) for FSR 3", best3, names[best3]);
+            }
+            else
+                LOG_WARN("Vela: FSR 3 asked, the FidelityFX DLL offers no 3.x upscaler");
+        }
+
         InitFlags();
 
         ffxCreateBackendDX12Desc backendDesc = { 0 };
