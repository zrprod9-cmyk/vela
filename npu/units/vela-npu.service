# Vela NPU: one fsr4npud for all FSR 4 graphs, so they share one cDSP fastrpc session (the cDSP has 7).
# It listens on @fsr4npud_<graph> for every graph from the start, and a graph's QNN context is loaded when its first client connects.
# Idle cost: one fastrpc session, no graph. At most 3 graphs stay loaded; a graph without a client is unloaded after 120 s.
[Unit]
Description=Vela NPU: FSR 4 helper daemon for all graphs (QNN HTP on the cDSP)
# vela-npu-setup.service waits for the device nodes (a ConditionPathExists on them raced
# their creation at boot).
Requires=vela-npu-setup.service
Wants=vela-npu-listener.service
After=vela-npu-setup.service vela-npu-listener.service
StartLimitIntervalSec=120
StartLimitBurst=6

[Service]
Type=notify
NotifyAccess=main
# The listener must have attached to the cDSP root PD before the session is opened.
ExecStartPre=/usr/bin/sleep 2
ExecStart=/usr/lib64/vela-npu/fsr4npud --graphs nf4_k1h,nf4_k1h_360,nf4_k1h_450,nf4up_k1h,nf4up_k1h_450,nf4up_k1h_360,nf4_exact,nf4_k1h_452,nf4up_k1h_452,nf4_k1h_405,nf4up_k1h_405,nf4_k1h_400,nf4up_k1h_400,nf4_k1h_324,nf4up_k1h_324,nf4_k1h_270,nf4up_k1h_270 --graph-dir /usr/lib64/vela-npu --max-loaded 3 --graph-idle-ms 120000 --backend qnn --allow-uid 1000 --max-clients 4 --alloc auto --exec-timeout-ms 2000 --exec-hard-timeout-ms 10000 --power-grace-ms 2000
# --alloc auto: rpcmem on /dev/dma_heap/system when it can be opened, else a Turnip-exported
# buffer; the journal line 'allocator:' says which. With the Vulkan path the daemon creates a
# Vulkan device, and a dynamic user has no writable home for a shader cache.
Environment=MESA_SHADER_CACHE_DISABLE=true
# The daemon only wakes on an eventfd/fence and then blocks in the fastrpc ioctl. Two mid cores
# (SM8550 cpu5-6), away from the IRQ cores (cpu0-2) and the prime core (cpu7) where games put
# their main thread; Nice=-10 instead of real-time scheduling.
CPUAffinity=5 6
Nice=-10
DynamicUser=yes
User=vela-npu
SupplementaryGroups=render
WorkingDirectory=/usr/lib/rfsa/adsp
Environment=LD_LIBRARY_PATH=/usr/lib64/vela-npu
Environment=ADSP_LIBRARY_PATH=/usr/lib/rfsa/adsp
# Exit 75 = an execute stuck > 10 s or a context load stuck > 20 s (wedged HTP), or 3 slow (> 2 s) executes in 120 s:
# the restart gives a fresh DSP session, and every client reconnects. A single slow execute only drops that client (Vela falls
# back to the GPU and reconnects). A bad graph file fails only its own socket. 6 failed starts in 120 s -> the unit stays failed
# and games run without the NPU (no restart loop).
Restart=on-failure
RestartSec=3
# 2 = bad options, 4 = every socket name is held by another daemon: a restart cannot help.
RestartPreventExitStatus=2 4
TimeoutStartSec=40
TimeoutStopSec=10
KillMode=mixed
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
